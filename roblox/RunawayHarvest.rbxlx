    <Item class="Script" referent="23">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main — server entry point. Loads every system module in dependency order.
	Each system lives in its own ModuleScript under Systems and exposes init().
]]

local Systems = script.Parent:WaitForChild("Systems")

local ORDER = {
	"World", -- map references, signs, prompts
	"PlayerData", -- profiles, saving, state replication
	"PlotService", -- garden plots, planting, harvesting
	"CreatureService", -- escaped crops and their AI
	"GrowthService", -- growth stages and mutation rolls
	"CatchService", -- catch meter
	"PetService", -- pets that auto-catch
	"SellService", -- sell stand
	"ShopService", -- seeds, upgrades, pets, expansion, rebirth
	"EventService", -- random server events
	"Debug", -- Studio-only test switches
}

for _, name in ORDER do
	local module = require(Systems:WaitForChild(name)) :: any
	if module.init then
		module.init()
	end
end

print("[Сбежавший Урожай] сервер запущен")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="24">
      <Properties>
        <string name="Name">Systems</string>
      </Properties>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">AntiExploit</string>
          <string name="Source"><![CDATA[--[[
	AntiExploit — rate limits, argument validation and distance checks for every remote.
	All remotes are connected through AntiExploit.connect so nothing reaches game logic unchecked.
]]

local Players = game:GetService("Players")

local AntiExploit = {}

local buckets = {} -- [player] = { [key] = { tokens, last } }
local violations = {} -- [player] = { count, windowStart }

local VIOLATION_WINDOW = 10
local VIOLATION_LIMIT = 150

local function flag(player: Player)
	local now = os.clock()
	local v = violations[player]
	if not v or now - v.windowStart > VIOLATION_WINDOW then
		v = { count = 0, windowStart = now }
		violations[player] = v
	end
	v.count += 1
	if v.count > VIOLATION_LIMIT then
		player:Kick("Слишком много запросов. Перезайди в игру.")
	end
end

-- Token bucket: `rate` calls per second on average, `burst` at once.
function AntiExploit.allow(player: Player, key: string, rate: number, burst: number): boolean
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local now = os.clock()
	local bucket = playerBuckets[key]
	if not bucket then
		bucket = { tokens = burst, last = now }
		playerBuckets[key] = bucket
	end
	bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.last) * rate)
	bucket.last = now
	if bucket.tokens < 1 then
		flag(player)
		return false
	end
	bucket.tokens -= 1
	return true
end

function AntiExploit.connect(remote: RemoteEvent, rate: number, burst: number, handler: (Player, ...any) -> ())
	remote.OnServerEvent:Connect(function(player, ...)
		if not AntiExploit.allow(player, remote.Name, rate, burst) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[AntiExploit] %s от %s: %s", remote.Name, player.Name, tostring(err)))
		end
	end)
end

function AntiExploit.isInt(value: any, min: number, max: number): boolean
	return type(value) == "number" and value == value and value % 1 == 0 and value >= min and value <= max
end

function AntiExploit.isId(value: any, dictionary: { [string]: any }): boolean
	return type(value) == "string" and dictionary[value] ~= nil
end

-- HumanoidRootPart of a living character, or nil.
function AntiExploit.getRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function AntiExploit.distanceOk(player: Player, position: Vector3, maxDistance: number): boolean
	local root = AntiExploit.getRoot(player)
	return root ~= nil and (root.Position - position).Magnitude <= maxDistance
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
	violations[player] = nil
end)

return AntiExploit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">CatchService</string>
          <string name="Source"><![CDATA[--[[
	CatchService — the catch meter. The client only says which creature it is trying to catch;
	distance, progress and the final capture are decided here.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameData = require(ReplicatedStorage.Shared.GameData)
local AntiExploit = require(script.Parent.AntiExploit)
local CreatureService = require(script.Parent.CreatureService)
local PlayerData = require(script.Parent.PlayerData)

local Remotes = ReplicatedStorage.Remotes
local Config = GameData.Config

local SEND_INTERVAL = 0.1

local CatchService = {}
local sessions = {} -- [player] = { id, progress, sentAt, fullWarnedAt }

-- Gives the creature to the player. Returns false if the inventory is full.
function CatchService.capture(player: Player, creature, byPet: boolean?): boolean
	local seedId, mutationId = creature.seedId, creature.mutationId
	if not PlayerData.addItem(player, seedId, mutationId, Config.OwnershipTag) then
		return false
	end
	local ownerId = creature.ownerId
	local position = CreatureService.position(creature)
	CreatureService.despawn(creature, "caught")
	PlayerData.addCaught(player)

	local name = GameData.itemName(seedId, mutationId)
	Remotes.Effect:FireClient(player, "sound", "catch")
	Remotes.Effect:FireAllClients("caught", position)
	if byPet then
		PlayerData.notify(player, string.format("Питомец поймал: %s! Продать можно через %dс.", name, Config.OwnershipTag), "good")
	else
		PlayerData.notify(player, string.format("Пойман: %s! Продать можно через %dс.", name, Config.OwnershipTag), "good")
	end
	if ownerId ~= player.UserId then
		PlayerData.notifyUserId(ownerId, string.format("%s украл твой урожай: %s!", player.DisplayName, name), "bad")
	end
	return true
end

local function stop(player: Player)
	if sessions[player] then
		sessions[player] = nil
		Remotes.CatchProgress:FireClient(player, 0, 0)
	end
end

local function step(dt: number)
	local now = os.clock()
	for player, session in sessions do
		local creature = CreatureService.creatures[session.id]
		local root = AntiExploit.getRoot(player)
		if not creature or not root then
			stop(player)
			continue
		end
		local knocked = (CreatureService.knockedUntil[player] or 0) > now
		local distance = (root.Position - CreatureService.position(creature)).Magnitude
		if knocked or distance > CreatureService.catchRadius(creature) then
			session.progress = 0 -- escaped the radius: start over
		else
			session.progress += dt
		end

		if session.progress >= Config.CatchTime then
			if CatchService.capture(player, creature, false) then
				stop(player)
			else
				session.progress = 0
				if now - session.fullWarnedAt > 4 then
					session.fullWarnedAt = now
					PlayerData.notify(player, "Инвентарь полон! Сначала продай урожай.", "bad")
				end
			end
		elseif now - session.sentAt >= SEND_INTERVAL then
			session.sentAt = now
			Remotes.CatchProgress:FireClient(player, session.id, session.progress / Config.CatchTime)
		end
	end
end

function CatchService.init()
	AntiExploit.connect(Remotes.CatchStart, 6, 10, function(player, id)
		if not AntiExploit.isInt(id, 1, 2 ^ 31) or not CreatureService.creatures[id] then
			return
		end
		local session = sessions[player]
		if session and session.id == id then
			return
		end
		sessions[player] = { id = id, progress = 0, sentAt = 0, fullWarnedAt = 0 }
	end)
	AntiExploit.connect(Remotes.CatchStop, 6, 10, stop)
	RunService.Heartbeat:Connect(step)
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

return CatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">CreatureService</string>
          <string name="Source"><![CDATA[--[[
	CreatureService — escaped crops: blocky creatures with vegetable heads, and their escape AI.

	Creatures are simulated entirely on the server (position, direction, timers). The model is an
	anchored root with welded parts, moved every Heartbeat; the client only swings the legs.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameData = require(ReplicatedStorage.Shared.GameData)
local AntiExploit = require(script.Parent.AntiExploit)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Config = GameData.Config

local FLY_HEIGHT = 16
local FLY_TIME = 2.5
local FLEE_DISTANCE = 22
local STOMP_INTERVAL = 4
local STOMP_RADIUS = 16
local KNOCKDOWN_TIME = 1.5

local CreatureService = {}
local creatures = {} -- [id] = creature
CreatureService.creatures = creatures
CreatureService.traps = {} -- [userId] = { part, position, ownerId }
CreatureService.knockedUntil = {} -- [player] = os.clock() time; knocked players cannot catch

local rng = Random.new()
local nextId = 0

-- ---------------------------------------------------------------- model
local function makePart(model: Model, name: string, size: Vector3, color: Color3, cframe: CFrame, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CFrame = cframe
	part.Parent = model
	return part
end

local function weld(root: BasePart, part: BasePart)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = root
	constraint.Part1 = part
	constraint.Parent = part
end

local function makeLabel(parent: Instance, text: string, color: Color3, size: number, order: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0.5, 0)
	label.Position = UDim2.fromScale(0, order * 0.5)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = size
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = text
	label.Parent = parent
	return label
end

-- Builds the creature at the origin; the caller moves it by setting root.CFrame.
local function buildModel(seedId: string, mutationId: string)
	local seed = GameData.Seeds[seedId]
	local mutation = GameData.Mutations[mutationId]
	local s = mutation.scale
	local black = Color3.fromRGB(20, 20, 24)

	local model = Instance.new("Model")
	model.Name = "Creature"

	local rootHeight = 2.4 * s -- legs 1.6 + half of the body
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 2, 1) * s
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new(0, rootHeight, 0)
	root.Parent = model
	model.PrimaryPart = root
	local origin = root.CFrame

	local headSize = seed.head.size * s
	local headColor = seed.head.color
	if mutationId == "infected" then
		headColor = headColor:Lerp(Color3.fromRGB(110, 210, 80), 0.45)
	end
	local headY = 0.8 * s + headSize.Y / 2
	local static = {}

	table.insert(static, makePart(model, "Body", Vector3.new(2, 1.6, 1.2) * s, seed.bodyColor, origin))
	local head = makePart(model, "Head", headSize, headColor, origin * CFrame.new(0, headY, 0), (Enum.PartType :: any)[seed.head.shape])
	if seedId == "golden" then
		head.Material = Enum.Material.Neon
	end
	table.insert(static, head)
	table.insert(static, makePart(model, "Leaf", Vector3.new(0.5, 0.9, 0.5) * s, seed.leafColor,
		origin * CFrame.new(0, headY + headSize.Y / 2 + 0.35 * s, 0)))

	-- face (the creature looks along -Z)
	local faceZ = -headSize.Z / 2
	for _, side in { -1, 1 } do
		table.insert(static, makePart(model, "Eye", Vector3.new(0.5, 0.5, 0.16) * s, Color3.new(1, 1, 1),
			origin * CFrame.new(side * 0.42 * s, headY + headSize.Y * 0.12, faceZ)))
		local pupil = makePart(model, "Pupil", Vector3.new(0.22, 0.22, 0.12) * s,
			mutationId == "infected" and Color3.fromRGB(255, 40, 40) or black,
			origin * CFrame.new(side * 0.42 * s, headY + headSize.Y * 0.12, faceZ - 0.08 * s))
		if mutationId == "infected" then
			pupil.Material = Enum.Material.Neon
		end
		table.insert(static, pupil)
		table.insert(static, makePart(model, "Arm", Vector3.new(0.5, 1.4, 0.5) * s, seed.bodyColor,
			origin * CFrame.new(side * 1.25 * s, 0.05 * s, 0)))
	end
	table.insert(static, makePart(model, "Mouth", Vector3.new(0.7, 0.16, 0.12) * s, black,
		origin * CFrame.new(0, headY - headSize.Y * 0.2, faceZ)))

	-- mutation details
	if mutationId == "sentient" then
		table.insert(static, makePart(model, "BowTie", Vector3.new(0.9, 0.4, 0.2) * s, Color3.fromRGB(220, 50, 60),
			origin * CFrame.new(0, 0.5 * s, -0.65 * s)))
		table.insert(static, makePart(model, "Glasses", Vector3.new(1.5, 0.12, 0.1) * s, black,
			origin * CFrame.new(0, headY + headSize.Y * 0.12 + 0.3 * s, faceZ - 0.05 * s)))
	elseif mutationId == "flying" then
		for _, side in { -1, 1 } do
			table.insert(static, makePart(model, "Wing", Vector3.new(1.8, 1.1, 0.2) * s, Color3.fromRGB(245, 245, 255),
				origin * CFrame.new(side * 1.7 * s, 0.6 * s, 0.5 * s) * CFrame.Angles(0, 0, side * -0.5)))
		end
	elseif mutationId == "royal" then
		local crown = makePart(model, "Crown", Vector3.new(1.3, 0.55, 1.3) * s, Color3.fromRGB(255, 208, 60),
			origin * CFrame.new(0, headY + headSize.Y / 2 + 0.95 * s, 0))
		crown.Material = Enum.Material.Neon
		table.insert(static, crown)
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 214, 80)
		sparkles.Parent = head
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 208, 60)
		light.Range = 16
		light.Brightness = 2
		light.Parent = head
	elseif mutationId == "titan" then
		for _, side in { -1, 1 } do
			table.insert(static, makePart(model, "Brow", Vector3.new(0.6, 0.14, 0.12) * s, black,
				origin * CFrame.new(side * 0.42 * s, headY + headSize.Y * 0.12 + 0.36 * s, faceZ - 0.04 * s)
					* CFrame.Angles(0, 0, side * 0.35)))
		end
	end
	for _, part in static do
		weld(root, part)
	end

	-- legs hang on Motor6Ds so the client can swing them (see client Effects)
	for _, side in { -1, 1 } do
		local leg = makePart(model, side < 0 and "LeftLeg" or "RightLeg", Vector3.new(0.7, 1.6, 0.7) * s,
			seed.bodyColor:Lerp(Color3.new(0, 0, 0), 0.25), origin * CFrame.new(side * 0.5 * s, -1.6 * s, 0))
		local hip = Instance.new("Motor6D")
		hip.Name = side < 0 and "LeftHip" or "RightHip"
		hip.Part0 = root
		hip.Part1 = leg
		hip.C0 = CFrame.new(side * 0.5 * s, -0.8 * s, 0)
		hip.C1 = CFrame.new(0, 0.8 * s, 0)
		hip.Parent = root
	end

	-- name tag
	local tag = Instance.new("BillboardGui")
	tag.Name = "Tag"
	tag.Size = UDim2.fromOffset(260, 48)
	tag.StudsOffset = Vector3.new(0, headSize.Y / 2 + 1.6 * s, 0)
	tag.MaxDistance = 140
	tag.LightInfluence = 0
	tag.Adornee = head
	makeLabel(tag, GameData.itemName(seedId, mutationId), mutation.color, 18, 0)
	local info = makeLabel(tag, "", Color3.new(1, 1, 1), 14, 1)
	tag.Parent = head

	return model, root, head, info, rootHeight
end

local function shout(creature)
	local bubble = Instance.new("BillboardGui")
	bubble.Name = "Bubble"
	bubble.Size = UDim2.fromOffset(190, 46)
	bubble.StudsOffset = Vector3.new(0, creature.head.Size.Y / 2 + 4.2 * creature.mutation.scale, 0)
	bubble.MaxDistance = 120
	bubble.LightInfluence = 0
	bubble.Adornee = creature.head
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.Parent = bubble
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = frame
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 18
	label.TextColor3 = Color3.fromRGB(30, 30, 36)
	label.Text = GameData.Phrases[rng:NextInteger(1, #GameData.Phrases)]
	label.Parent = frame
	bubble.Parent = creature.head
	Debris:AddItem(bubble, 3)
end

-- ---------------------------------------------------------------- public API
function CreatureService.catchRadius(creature): number
	return Config.CatchRadius + (creature.mutation.scale - 1) * 4
end

function CreatureService.position(creature): Vector3
	return creature.root.Position
end

function CreatureService.countOwned(userId: number): number
	local count = 0
	for _, creature in creatures do
		if creature.ownerId == userId then
			count += 1
		end
	end
	return count
end

-- reason: "caught" | "escaped" | "removed"
function CreatureService.despawn(creature, reason: string)
	if not creatures[creature.id] then
		return
	end
	creatures[creature.id] = nil
	creature.model:Destroy()
	if reason == "escaped" then
		PlayerData.notifyUserId(creature.ownerId,
			"Урожай убежал навсегда: " .. GameData.itemName(creature.seedId, creature.mutationId), "bad")
	end
end

function CreatureService.spawn(owner: Player, seedId: string, mutationId: string, position: Vector3, plot: any, fenced: boolean)
	local mutation = GameData.Mutations[mutationId]
	local model, root, head, info, rootHeight = buildModel(seedId, mutationId)
	local now = os.clock()
	local angle = rng:NextNumber() * math.pi * 2
	nextId += 1
	local creature = {
		id = nextId,
		seedId = seedId,
		mutationId = mutationId,
		mutation = mutation,
		ownerId = owner.UserId,
		ownerName = owner.DisplayName,
		model = model,
		root = root,
		head = head,
		info = info,
		rootHeight = rootHeight,
		pos = Vector3.new(position.X, 0, position.Z), -- ground position
		dir = Vector3.new(math.cos(angle), 0, math.sin(angle)),
		altitude = 0,
		nextTurn = now + rng:NextNumber(2, 4),
		expiresAt = now + Config.EscapeTime,
		stunnedUntil = 0,
		fencePlot = fenced and plot or nil,
		fenceUntil = now + Config.FenceTime,
		flyUntil = 0,
		nextFly = now + rng:NextNumber(3, 6),
		nextStomp = now + STOMP_INTERVAL,
		nextShout = now + rng:NextNumber(9, 16),
		infoText = "",
	}
	model:SetAttribute("CreatureId", creature.id)
	model:SetAttribute("OwnerId", creature.ownerId)
	model:SetAttribute("Scale", mutation.scale)
	model:SetAttribute("Speed", mutation.speed)
	model:SetAttribute("Stunned", false)
	root.CFrame = CFrame.lookAt(creature.pos + Vector3.new(0, rootHeight, 0), creature.pos + Vector3.new(0, rootHeight, 0) + creature.dir)
	model.Parent = World.Creatures
	creatures[creature.id] = creature

	shout(creature)
	Remotes.Effect:FireAllClients("scream", root.Position)
	PlayerData.notify(owner, "Твой урожай ожил: " .. GameData.itemName(seedId, mutationId) .. "! Лови!", "info")
	return creature
end

-- Whistle: brings every creature of this owner to a point. Returns how many moved.
function CreatureService.teleportOwned(userId: number, position: Vector3): number
	local count = 0
	for _, creature in creatures do
		if creature.ownerId == userId then
			creature.pos = Vector3.new(position.X + rng:NextNumber(-4, 4), 0, position.Z + rng:NextNumber(-4, 4))
			creature.altitude = 0
			creature.flyUntil = 0
			count += 1
		end
	end
	return count
end

function CreatureService.removeTrap(userId: number)
	local trap = CreatureService.traps[userId]
	if trap then
		trap.part:Destroy()
		CreatureService.traps[userId] = nil
		local owner = Players:GetPlayerByUserId(userId)
		local profile = owner and PlayerData.get(owner)
		if owner and profile then
			profile.trapPlaced = false
			PlayerData.markDirty(owner)
		end
	end
end

-- ---------------------------------------------------------------- AI
local function pickDirection(creature, now: number)
	local nearest, nearestDistance = nil, FLEE_DISTANCE
	for _, player in Players:GetPlayers() do
		local playerRoot = AntiExploit.getRoot(player)
		if playerRoot then
			local offset = creature.pos - playerRoot.Position
			local distance = Vector3.new(offset.X, 0, offset.Z).Magnitude
			if distance < nearestDistance then
				nearest, nearestDistance = Vector3.new(offset.X, 0, offset.Z), distance
			end
		end
	end
	local angle
	if nearest and nearest.Magnitude > 0.1 then
		-- run away from the closest player, with some randomness
		angle = math.atan2(nearest.Z, nearest.X) + rng:NextNumber(-1, 1)
	elseif rng:NextNumber() < 0.3 then
		-- crops love to hide in the forest
		local toForest = World.ForestCenter - creature.pos
		angle = math.atan2(toForest.Z, toForest.X) + rng:NextNumber(-0.6, 0.6)
	else
		angle = rng:NextNumber() * math.pi * 2
	end
	creature.dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
	creature.nextTurn = now + rng:NextNumber(2, 4)
end

local function stomp(creature)
	local position = creature.pos
	Remotes.Effect:FireAllClients("stomp", position)
	for _, player in Players:GetPlayers() do
		local playerRoot = AntiExploit.getRoot(player)
		if playerRoot and (playerRoot.Position - position).Magnitude <= STOMP_RADIUS then
			CreatureService.knockedUntil[player] = os.clock() + KNOCKDOWN_TIME
			Remotes.Effect:FireClient(player, "knockdown", position)
		end
	end
end

local function checkTraps(creature, now: number)
	for userId, trap in CreatureService.traps do
		local offset = creature.pos - trap.position
		if offset.Magnitude <= Config.TrapRadius then
			creature.stunnedUntil = now + Config.TrapStun
			creature.altitude = 0
			creature.model:SetAttribute("Stunned", true)
			Remotes.Effect:FireAllClients("trap", trap.position)
			PlayerData.notifyUserId(userId,
				"Ловушка сработала! Прилип: " .. GameData.itemName(creature.seedId, creature.mutationId), "good")
			CreatureService.removeTrap(userId)
			return
		end
	end
end

local function step(dt: number)
	local now = os.clock()
	for _, creature in creatures do
		if now >= creature.expiresAt then
			CreatureService.despawn(creature, "escaped")
			continue
		end

		local stunned = now < creature.stunnedUntil
		if not stunned then
			if creature.model:GetAttribute("Stunned") then
				creature.model:SetAttribute("Stunned", false)
			end
			if now >= creature.nextTurn then
				pickDirection(creature, now)
			end

			local minX, maxX, minZ, maxZ = -World.Bounds, World.Bounds, -World.Bounds, World.Bounds
			local plot = creature.fencePlot
			if plot and now < creature.fenceUntil then
				minX, maxX, minZ, maxZ = plot.minX + 2, plot.maxX - 2, plot.minZ + 2, plot.maxZ - 2
			end
			local target = creature.pos + creature.dir * creature.mutation.speed * dt
			local x, z = target.X, target.Z
			if x < minX or x > maxX then
				creature.dir = Vector3.new(-creature.dir.X, 0, creature.dir.Z)
				x = math.clamp(x, minX, maxX)
			end
			if z < minZ or z > maxZ then
				creature.dir = Vector3.new(creature.dir.X, 0, -creature.dir.Z)
				z = math.clamp(z, minZ, maxZ)
			end
			creature.pos = Vector3.new(x, 0, z)

			if creature.mutation.canFly then
				if now >= creature.nextFly then
					creature.flyUntil = now + FLY_TIME
					creature.nextFly = now + FLY_TIME + rng:NextNumber(5, 8)
				end
				local targetAltitude = now < creature.flyUntil and FLY_HEIGHT or 0
				creature.altitude += (targetAltitude - creature.altitude) * math.min(1, dt * 4)
			end
			if creature.mutation.stomp and now >= creature.nextStomp then
				creature.nextStomp = now + STOMP_INTERVAL
				stomp(creature)
			end
			if now >= creature.nextShout then
				creature.nextShout = now + rng:NextNumber(10, 18)
				shout(creature)
			end
			if creature.altitude < 3 and next(CreatureService.traps) ~= nil then
				checkTraps(creature, now)
			end
		end

		local base = creature.pos + Vector3.new(0, creature.rootHeight + creature.altitude, 0)
		creature.root.CFrame = CFrame.lookAt(base, base + creature.dir)

		local left = math.ceil(creature.expiresAt - now)
		local text = stunned and string.format("Прилип! · %dс", left) or string.format("%s · %dс", creature.ownerName, left)
		if text ~= creature.infoText then
			creature.infoText = text
			creature.info.Text = text
		end
	end
end

function CreatureService.init()
	RunService.Heartbeat:Connect(step)
	PlayerData.onLeaving(function(player)
		CreatureService.removeTrap(player.UserId)
		CreatureService.knockedUntil[player] = nil
	end)
end

return CreatureService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Debug</string>
          <string name="Source"><![CDATA[--[[
	Debug — test switches that work ONLY in Roblox Studio (never on a published server).
	Set them on Workspace from the server command bar or the Properties panel:

	  workspace:SetAttribute("DebugGrowSpeed", 20)    -- crops grow 20x faster
	  workspace:SetAttribute("DebugMoney", 300000)    -- give this much money to every player
	  workspace:SetAttribute("DebugEvent", "night")   -- start an event: night | rain | silence
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local EventService = require(script.Parent.EventService)
local GrowthService = require(script.Parent.GrowthService)
local PlayerData = require(script.Parent.PlayerData)

local Debug = {}

function Debug.init()
	if not RunService:IsStudio() then
		return
	end
	workspace:GetAttributeChangedSignal("DebugGrowSpeed"):Connect(function()
		local speed = workspace:GetAttribute("DebugGrowSpeed")
		GrowthService.speed = type(speed) == "number" and math.clamp(speed, 1, 100) or 1
	end)
	workspace:GetAttributeChangedSignal("DebugMoney"):Connect(function()
		local amount = workspace:GetAttribute("DebugMoney")
		if type(amount) == "number" and amount > 0 then
			for _, player in Players:GetPlayers() do
				PlayerData.addMoney(player, amount, false)
			end
			workspace:SetAttribute("DebugMoney", nil)
		end
	end)
	workspace:GetAttributeChangedSignal("DebugEvent"):Connect(function()
		local id = workspace:GetAttribute("DebugEvent")
		if type(id) == "string" then
			EventService.force(id)
			workspace:SetAttribute("DebugEvent", nil)
		end
	end)
end

return Debug
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	EventService — random server-wide events every 5–8 minutes.
	  night   «Ночь Большого Побега» — every ripe crop mutates (20 s)
	  rain    «Золотой Дождь»        — mutation chances x3 (60 s)
	  silence «Тишина»               — no mutations (60 s)
	Clients read the timers from Workspace attributes: NextEventAt, ActiveEvent, ActiveEventEnds.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local GameData = require(ReplicatedStorage.Shared.GameData)
local GrowthService = require(script.Parent.GrowthService)

local Remotes = ReplicatedStorage.Remotes
local Config = GameData.Config

local EventService = {}
local forced: string? = nil -- Studio debug: start this event right away
local rng = Random.new()

local DAY_CLOCK = 14
local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "EventTint"
tint.Parent = Lighting

local function tween(instance: Instance, seconds: number, goal: { [string]: any })
	TweenService:Create(instance, TweenInfo.new(seconds, Enum.EasingStyle.Sine), goal):Play()
end

local function apply(id: string)
	if id == "night" then
		tween(Lighting, 2, { ClockTime = 0 })
		tween(tint, 2, { TintColor = Color3.fromRGB(190, 190, 255) })
		GrowthService.forceMutation = true
		GrowthService.tick(0) -- mutate everything that is already ripe, right now
	elseif id == "rain" then
		tween(tint, 2, { TintColor = Color3.fromRGB(255, 236, 170) })
		GrowthService.multiplier = 3
	elseif id == "silence" then
		tween(tint, 2, { Saturation = -0.35 })
		GrowthService.multiplier = 0
	end
end

local function revert()
	GrowthService.forceMutation = false
	GrowthService.multiplier = 1
	tween(Lighting, 2, { ClockTime = DAY_CLOCK })
	tween(tint, 2, { TintColor = Color3.new(1, 1, 1), Saturation = 0 })
end

local function run(id: string)
	local event = GameData.Events[id]
	workspace:SetAttribute("ActiveEvent", id)
	workspace:SetAttribute("ActiveEventEnds", workspace:GetServerTimeNow() + event.duration)
	Remotes.EventAnnounce:FireAllClients(id, event.duration)
	apply(id)
	task.wait(event.duration)
	revert()
	workspace:SetAttribute("ActiveEvent", nil)
	workspace:SetAttribute("ActiveEventEnds", nil)
end

function EventService.force(id: string)
	if GameData.Events[id] then
		forced = id
	end
end

function EventService.init()
	task.spawn(function()
		while true do
			local delay = rng:NextInteger(Config.EventMinDelay, Config.EventMaxDelay)
			workspace:SetAttribute("NextEventAt", workspace:GetServerTimeNow() + delay)
			local deadline = os.clock() + delay
			while os.clock() < deadline and not forced do
				task.wait(0.5)
			end
			local id = forced or GameData.EventOrder[rng:NextInteger(1, #GameData.EventOrder)]
			forced = nil
			run(id)
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">GrowthService</string>
          <string name="Source"><![CDATA[--[[
	GrowthService — growth stages (Росток → Растёт → Созрел) and mutation rolls.
	Everything is timed on the server; clients only see the result.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameData = require(ReplicatedStorage.Shared.GameData)
local CreatureService = require(script.Parent.CreatureService)
local PlayerData = require(script.Parent.PlayerData)
local PlotService = require(script.Parent.PlotService)

local Remotes = ReplicatedStorage.Remotes
local Config = GameData.Config

local GrowthService = {}
GrowthService.multiplier = 1 -- mutation chance multiplier, set by events (0 = no mutations)
GrowthService.forceMutation = false -- "Ночь Большого Побега": every ripe crop mutates
GrowthService.speed = 1 -- growth speed (Studio debug only)

local rng = Random.new()

local function mutate(plot, slot)
	local crop = slot.crop
	local owner = plot.owner
	local profile = owner and PlayerData.get(owner)
	if not crop or not owner or not profile then
		return
	end
	local position = slot.part.Position
	local seedId = crop.seedId
	PlotService.removeCrop(plot, slot)
	CreatureService.spawn(owner, seedId, GameData.rollMutation(rng), position, plot, profile.data.upgrades.fence)
end

local function setLabel(crop, text: string)
	if crop.label.Text ~= text then
		crop.label.Text = text
	end
end

function GrowthService.tick(dt: number)
	local now = os.clock()
	for _, plot in PlotService.plots do
		if not plot.owner then
			continue
		end
		for _, slot in plot.slots do
			local crop = slot.crop
			if not crop then
				continue
			end
			if crop.stage < 3 then
				crop.progress += dt * GrowthService.speed
				local fraction = crop.progress / crop.growTime
				local stage = fraction >= 1 and 3 or (fraction >= 0.33 and 2 or 1)
				if stage ~= crop.stage then
					PlotService.setStage(plot, slot, stage)
					Remotes.Effect:FireClient(plot.owner, "sound", "grow")
					if stage == 3 then
						crop.nextRoll = now + Config.MutationTick
					end
				end
				if stage < 3 then
					setLabel(crop, string.format("%s · %dс", GameData.Stages[stage], math.ceil(crop.growTime - crop.progress)))
					continue
				end
			end

			-- ripe: roll for a mutation once per growth tick
			setLabel(crop, GameData.Stages[3] .. "!")
			if GrowthService.forceMutation then
				mutate(plot, slot)
			elseif now >= crop.nextRoll then
				crop.nextRoll = now + Config.MutationTick
				local rarity = GameData.Rarities[GameData.Seeds[crop.seedId].rarity]
				local chance = math.min(1, rarity.mutationChance * GrowthService.multiplier)
				if rng:NextNumber() < chance then
					mutate(plot, slot)
				end
			end
		end
	end
end

function GrowthService.init()
	task.spawn(function()
		while true do
			local dt = task.wait(1)
			GrowthService.tick(dt)
		end
	end)
end

return GrowthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">PetService</string>
          <string name="Source"><![CDATA[--[[
	PetService — pets follow their owner and auto-catch the owner's escaped crops
	within PetRadius studs, once every PetCooldown seconds.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameData = require(ReplicatedStorage.Shared.GameData)
local AntiExploit = require(script.Parent.AntiExploit)
local CatchService = require(script.Parent.CatchService)
local CreatureService = require(script.Parent.CreatureService)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local Config = GameData.Config

local FOLLOW_SPEED = 24
local ROOT_HEIGHT = 1.5

local PetService = {}
local pets = {} -- [player] = { model, root, pos, readyAt }

local function buildPet(petId: string)
	local pet = GameData.Pets[petId]
	local dark = pet.color:Lerp(Color3.new(0, 0, 0), 0.3)
	local model = Instance.new("Model")
	model.Name = "Pet"

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1.6, 1.2, 2.6)
	root.Color = pet.color
	root.Material = Enum.Material.SmoothPlastic
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new(0, ROOT_HEIGHT, 0)
	root.Parent = model
	model.PrimaryPart = root

	local function add(name: string, size: Vector3, offset: CFrame, color: Color3)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.Material = Enum.Material.SmoothPlastic
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CFrame = root.CFrame * offset
		part.Parent = model
		local constraint = Instance.new("WeldConstraint")
		constraint.Part0 = root
		constraint.Part1 = part
		constraint.Parent = part
	end
	add("Head", Vector3.new(1.4, 1.3, 1.3), CFrame.new(0, 0.8, -1.5), pet.color)
	add("Nose", Vector3.new(0.5, 0.4, 0.5), CFrame.new(0, 0.6, -2.3), Color3.fromRGB(30, 30, 34))
	add("Tail", Vector3.new(0.35, 0.35, 1.3), CFrame.new(0, 0.5, 1.8) * CFrame.Angles(0.6, 0, 0), dark)
	for _, side in { -1, 1 } do
		add("Ear", Vector3.new(0.4, 0.7, 0.3), CFrame.new(side * 0.5, 1.7, -1.4), dark)
		add("Eye", Vector3.new(0.22, 0.22, 0.1), CFrame.new(side * 0.35, 1, -2.16), Color3.fromRGB(20, 20, 24))
		add("FrontLeg", Vector3.new(0.4, 0.9, 0.4), CFrame.new(side * 0.5, -1.05, -0.9), dark)
		add("BackLeg", Vector3.new(0.4, 0.9, 0.4), CFrame.new(side * 0.5, -1.05, 0.9), dark)
	end

	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(180, 24)
	tag.StudsOffset = Vector3.new(0, 2.6, 0)
	tag.MaxDistance = 60
	tag.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.TextColor3 = Color3.fromRGB(255, 240, 200)
	label.TextStrokeTransparency = 0.3
	label.Text = pet.name
	label.Parent = tag
	tag.Parent = root
	return model, root
end

-- Call after the equipped pet changes (or on load).
function PetService.refresh(player: Player)
	local existing = pets[player]
	if existing then
		existing.model:Destroy()
		pets[player] = nil
	end
	local profile = PlayerData.get(player)
	local petId = profile and profile.data.pet
	if not petId or not GameData.Pets[petId] then
		return
	end
	local model, root = buildPet(petId)
	local playerRoot = AntiExploit.getRoot(player)
	local start = playerRoot and playerRoot.Position or Vector3.zero
	pets[player] = {
		model = model,
		root = root,
		pos = Vector3.new(start.X, 0, start.Z),
		readyAt = os.clock() + 3,
	}
	model.Parent = World.Pets
end

local sinceCheck = 0

local function step(dt: number)
	sinceCheck += dt
	local check = sinceCheck >= 0.5
	if check then
		sinceCheck = 0
	end
	local now = os.clock()
	for player, pet in pets do
		local playerRoot = AntiExploit.getRoot(player)
		if not playerRoot then
			continue
		end
		local look = playerRoot.CFrame.LookVector
		local right = playerRoot.CFrame.RightVector
		local target = playerRoot.Position - look * 5 + right * 3
		target = Vector3.new(target.X, 0, target.Z)
		local delta = target - pet.pos
		local distance = delta.Magnitude
		local facing = Vector3.new(look.X, 0, look.Z)
		if distance > 80 then
			pet.pos = target -- owner respawned or teleported
		elseif distance > 0.6 then
			pet.pos += delta.Unit * math.min(distance, FOLLOW_SPEED * dt)
			facing = delta
		end
		if facing.Magnitude < 0.01 then
			facing = Vector3.new(0, 0, -1)
		end
		local hop = distance > 0.6 and math.abs(math.sin(now * 10)) * 0.35 or 0
		local base = pet.pos + Vector3.new(0, ROOT_HEIGHT + hop, 0)
		pet.root.CFrame = CFrame.lookAt(base, base + facing.Unit)

		if check and now >= pet.readyAt then
			for _, creature in CreatureService.creatures do
				if creature.ownerId == player.UserId then
					local offset = CreatureService.position(creature) - pet.root.Position
					if offset.Magnitude <= Config.PetRadius then
						if CatchService.capture(player, creature, true) then
							pet.readyAt = now + Config.PetCooldown
						end
						break
					end
				end
			end
		end
	end
end

function PetService.init()
	PlayerData.onLoaded(function(player)
		PetService.refresh(player)
	end)
	PlayerData.onLeaving(function(player)
		local pet = pets[player]
		if pet then
			pet.model:Destroy()
			pets[player] = nil
		end
	end)
	RunService.Heartbeat:Connect(step)
end

return PetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--[[
	PlayerData — player profiles, DataStore saving and state replication to the client.

	Saved: money, seeds, inventory, upgrades, expansion, pets, rebirth count, total caught.
	Not saved: crops that are still growing and creatures on the loose.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameData = require(ReplicatedStorage.Shared.GameData)
local AntiExploit = require(script.Parent.AntiExploit)

local Remotes = ReplicatedStorage.Remotes
local Config = GameData.Config

local STORE_NAME = "RunawayHarvest_v1"
local KEY_PREFIX = "player_"
local AUTOSAVE_INTERVAL = 120
local INCOME_WINDOW = 60

local PlayerData = {}

local profiles = {} -- [player] = profile
local loadedCallbacks = {}
local leavingCallbacks = {}

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore недоступен: " .. tostring(result))
	end
end

-- ---------------------------------------------------------------- data shape
local function defaultData()
	return {
		money = Config.StartMoney,
		seeds = table.clone(Config.StartSeeds),
		inventory = {}, -- { s = seedId, m = mutationId?, t = unlock time (runtime only) }
		upgrades = { fence = false, whistle = false, traps = 0 },
		expanded = false,
		pets = {}, -- [petId] = true
		pet = nil, -- equipped pet id
		rebirths = 0,
		caught = 0,
	}
end

-- Never trust stored data blindly: rebuild it field by field.
local function sanitize(raw: any)
	local data = defaultData()
	if type(raw) ~= "table" then
		return data
	end
	local function int(value, min, max, fallback)
		if type(value) == "number" and value == value then
			return math.clamp(math.floor(value), min, max)
		end
		return fallback
	end
	data.money = int(raw.money, 0, 1e15, data.money)
	data.rebirths = int(raw.rebirths, 0, 1e6, 0)
	data.caught = int(raw.caught, 0, 1e12, 0)
	data.expanded = raw.expanded == true

	data.seeds = {}
	if type(raw.seeds) == "table" then
		for id, count in raw.seeds do
			if GameData.Seeds[id] then
				data.seeds[id] = int(count, 0, Config.MaxSeedStack, 0)
			end
		end
	end
	if type(raw.inventory) == "table" then
		for _, item in raw.inventory do
			if #data.inventory >= Config.InventoryLimit then
				break
			end
			if type(item) == "table" and GameData.Seeds[item.s] and (item.m == nil or GameData.Mutations[item.m]) then
				table.insert(data.inventory, { s = item.s, m = item.m })
			end
		end
	end
	if type(raw.upgrades) == "table" then
		data.upgrades.fence = raw.upgrades.fence == true
		data.upgrades.whistle = raw.upgrades.whistle == true
		data.upgrades.traps = int(raw.upgrades.traps, 0, Config.MaxTraps, 0)
	end
	if type(raw.pets) == "table" then
		for id, owned in raw.pets do
			if GameData.Pets[id] and owned == true then
				data.pets[id] = true
			end
		end
	end
	if type(raw.pet) == "string" and data.pets[raw.pet] then
		data.pet = raw.pet
	end
	return data
end

local function serialize(data)
	local inventory = table.create(#data.inventory)
	for index, item in data.inventory do
		inventory[index] = { s = item.s, m = item.m }
	end
	return {
		version = 1,
		money = data.money,
		seeds = table.clone(data.seeds),
		inventory = inventory,
		upgrades = table.clone(data.upgrades),
		expanded = data.expanded,
		pets = table.clone(data.pets),
		pet = data.pet,
		rebirths = data.rebirths,
		caught = data.caught,
	}
end

-- ---------------------------------------------------------------- saving
local function save(player: Player, profile)
	if not store or not profile.canSave then
		return
	end
	local payload = serialize(profile.data)
	local key = KEY_PREFIX .. player.UserId
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function()
				return payload
			end)
		end)
		if ok then
			return
		end
		warn(string.format("[PlayerData] сохранение %s, попытка %d: %s", player.Name, attempt, tostring(err)))
		task.wait(1.5 * attempt)
	end
end

local function load(userId: number): (any, boolean)
	if not store then
		return nil, false
	end
	local attempts = RunService:IsStudio() and 1 or 3
	for attempt = 1, attempts do
		local ok, result = pcall(function()
			return store:GetAsync(KEY_PREFIX .. userId)
		end)
		if ok then
			return result, true
		end
		warn(string.format("[PlayerData] загрузка %d, попытка %d: %s", userId, attempt, tostring(result)))
		if attempt < attempts then
			task.wait(1.5)
		end
	end
	return nil, false
end

-- ---------------------------------------------------------------- public API
function PlayerData.get(player: Player)
	return profiles[player]
end

function PlayerData.onLoaded(callback: (Player, any) -> ())
	table.insert(loadedCallbacks, callback)
	-- a profile can finish loading before a later system registers: catch it up
	for player, profile in profiles do
		task.spawn(callback, player, profile)
	end
end

function PlayerData.onLeaving(callback: (Player, any) -> ())
	table.insert(leavingCallbacks, callback)
end

function PlayerData.markDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.dirty = true
	end
end

-- kind: "good" | "bad" | "info"
function PlayerData.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function PlayerData.notifyUserId(userId: number, text: string, kind: string?)
	local player = Players:GetPlayerByUserId(userId)
	if player then
		PlayerData.notify(player, text, kind)
	end
end

local function syncLeaderstats(profile)
	profile.moneyStat.Value = profile.data.money
	profile.caughtStat.Value = profile.data.caught
end

-- isIncome = true counts towards the "Доход" readout in the top bar.
function PlayerData.addMoney(player: Player, amount: number, isIncome: boolean?)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.data.money = math.clamp(profile.data.money + amount, 0, 1e15)
	if isIncome and amount > 0 then
		table.insert(profile.sales, { t = os.clock(), amount = amount })
	end
	syncLeaderstats(profile)
	profile.dirty = true
end

function PlayerData.spend(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or amount < 0 or profile.data.money < amount then
		return false
	end
	profile.data.money -= amount
	syncLeaderstats(profile)
	profile.dirty = true
	return true
end

function PlayerData.addCaught(player: Player)
	local profile = profiles[player]
	if profile then
		profile.data.caught += 1
		syncLeaderstats(profile)
		profile.dirty = true
	end
end

-- Adds a crop to the inventory. lockSeconds > 0 puts the ownership tag on it.
function PlayerData.addItem(player: Player, seedId: string, mutationId: string?, lockSeconds: number?): boolean
	local profile = profiles[player]
	if not profile or #profile.data.inventory >= Config.InventoryLimit then
		return false
	end
	local item = { s = seedId, m = mutationId, t = nil :: number? }
	if lockSeconds and lockSeconds > 0 then
		item.t = os.clock() + lockSeconds
	end
	table.insert(profile.data.inventory, item)
	profile.dirty = true
	return true
end

function PlayerData.sellMultiplier(player: Player): number
	local profile = profiles[player]
	if not profile then
		return 1
	end
	return GameData.sellMultiplier(profile.data.rebirths, profile.data.pet)
end

local function income(profile): number
	local now = os.clock()
	local total = 0
	for index = #profile.sales, 1, -1 do
		local sale = profile.sales[index]
		if now - sale.t > INCOME_WINDOW then
			table.remove(profile.sales, index)
		else
			total += sale.amount
		end
	end
	return total
end

local function snapshot(profile)
	local data = profile.data
	local now = os.clock()
	local inventory = table.create(#data.inventory)
	for index, item in data.inventory do
		inventory[index] = { s = item.s, m = item.m, l = item.t and math.max(0, math.ceil(item.t - now)) or 0 }
	end
	return {
		money = data.money,
		seeds = data.seeds,
		inventory = inventory,
		upgrades = data.upgrades,
		expanded = data.expanded,
		pets = data.pets,
		pet = data.pet,
		rebirths = data.rebirths,
		income = income(profile),
		whistleLeft = math.max(0, math.ceil(profile.whistleReadyAt - now)),
		trapPlaced = profile.trapPlaced,
		plotId = profile.plotId,
	}
end

-- ---------------------------------------------------------------- lifecycle
local function onPlayerAdded(player: Player)
	if profiles[player] then
		return
	end
	local raw, loadedOk = load(player.UserId)
	if not player.Parent then
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local moneyStat = Instance.new("IntValue")
	moneyStat.Name = "Деньги"
	moneyStat.Parent = leaderstats
	local caughtStat = Instance.new("IntValue")
	caughtStat.Name = "Урожай Пойман"
	caughtStat.Parent = leaderstats

	local profile = {
		data = sanitize(raw),
		canSave = loadedOk, -- never overwrite a save that failed to load
		dirty = true,
		sales = {},
		whistleReadyAt = 0,
		trapPlaced = false,
		plotId = 0,
		moneyStat = moneyStat,
		caughtStat = caughtStat,
		saved = false,
	}
	profiles[player] = profile
	syncLeaderstats(profile)
	leaderstats.Parent = player

	if not loadedOk then
		PlayerData.notify(player, "Сохранение сейчас недоступно — прогресс этой игры не запишется.", "bad")
	end
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, profile)
	end
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	for _, callback in leavingCallbacks do
		local ok, err = pcall(callback, player, profile)
		if not ok then
			warn("[PlayerData] ошибка при выходе: " .. tostring(err))
		end
	end
	if not profile.saved then
		profile.saved = true
		save(player, profile)
	end
	profiles[player] = nil
end

function PlayerData.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	AntiExploit.connect(Remotes.RequestState, 1, 3, function(player)
		PlayerData.markDirty(player)
	end)

	-- push changed state to clients (batched)
	task.spawn(function()
		local sinceRefresh = 0
		while true do
			local dt = task.wait(0.25)
			sinceRefresh += dt
			local refresh = sinceRefresh >= 5
			if refresh then
				sinceRefresh = 0
			end
			for player, profile in profiles do
				-- the income readout decays even when nothing else changes
				if profile.dirty or (refresh and #profile.sales > 0) then
					profile.dirty = false
					Remotes.StateUpdate:FireClient(player, snapshot(profile))
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, profile in profiles do
				task.spawn(save, player, profile)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, profile in profiles do
			if not profile.saved then
				profile.saved = true
				pending += 1
				task.spawn(function()
					save(player, profile)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[--[[
	PlotService — garden plots: ownership, soil slots, planting and harvesting.
	Growth itself is driven by GrowthService; this module owns the slot state and visuals.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameData = require(ReplicatedStorage.Shared.GameData)
local AntiExploit = require(script.Parent.AntiExploit)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Config = GameData.Config

local SOIL_COLOR = Color3.fromRGB(106, 72, 48)
local LOCKED_COLOR = Color3.fromRGB(74, 70, 66)
local TOTAL_SLOTS = Config.BaseSlots + Config.ExpansionSlots

local PlotService = {}
PlotService.plots = {} -- array of plot tables
local plotByPlayer = {}

-- ---------------------------------------------------------------- slot visuals
local function updateSlot(plot, slot)
	local state
	if not plot.owner then
		state = "free"
	elseif slot.index > plot.unlocked then
		state = "locked"
	elseif not slot.crop then
		state = "empty"
	elseif slot.crop.stage < 3 then
		state = "growing"
	else
		state = "ripe"
	end
	slot.prompt:SetAttribute("State", state)
	slot.prompt.Enabled = state == "empty" or state == "ripe"
	slot.prompt.ActionText = state == "ripe" and "Собрать" or "Посадить"
	slot.part.Color = (state == "locked" or state == "free") and LOCKED_COLOR or SOIL_COLOR
end

function PlotService.setStage(plot, slot, stage: number)
	local crop = slot.crop
	if not crop then
		return
	end
	crop.stage = stage
	local seed = GameData.Seeds[crop.seedId]
	local part = crop.part
	if stage == 1 then
		part.Shape = Enum.PartType.Block
		part.Size = Vector3.new(0.6, 1.2, 0.6)
		part.Color = Color3.fromRGB(110, 200, 90)
	elseif stage == 2 then
		part.Shape = Enum.PartType.Block
		part.Size = Vector3.new(1.3, 2.4, 1.3)
		part.Color = Color3.fromRGB(70, 160, 70)
	else
		part.Shape = (Enum.PartType :: any)[seed.head.shape]
		part.Size = seed.head.size * 1.15
		part.Color = seed.head.color
	end
	local top = slot.part.Position.Y + slot.part.Size.Y / 2
	part.Position = Vector3.new(slot.part.Position.X, top + part.Size.Y / 2, slot.part.Position.Z)
	updateSlot(plot, slot)
end

local function createCrop(plot, slot, seedId: string)
	local seed = GameData.Seeds[seedId]
	local part = Instance.new("Part")
	part.Name = "Crop"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(170, 40)
	gui.StudsOffset = Vector3.new(0, 3.2, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = GameData.Rarities[seed.rarity].color
	label.TextStrokeTransparency = 0.3
	label.Text = ""
	label.Parent = gui
	gui.Parent = part

	slot.crop = {
		seedId = seedId,
		growTime = seed.growTime,
		progress = 0, -- seconds grown so far
		stage = 0,
		nextRoll = 0,
		part = part,
		label = label,
	}
	PlotService.setStage(plot, slot, 1)
	part.Parent = World.Crops
end

function PlotService.removeCrop(plot, slot)
	if slot.crop then
		slot.crop.part:Destroy()
		slot.crop = nil
	end
	updateSlot(plot, slot)
end

function PlotService.clearCrops(plot)
	for _, slot in plot.slots do
		PlotService.removeCrop(plot, slot)
	end
end

function PlotService.cropCount(plot): number
	local count = 0
	for _, slot in plot.slots do
		if slot.crop then
			count += 1
		end
	end
	return count
end

-- ---------------------------------------------------------------- ownership
function PlotService.getPlot(player: Player)
	return plotByPlayer[player]
end

function PlotService.setFence(plot, enabled: boolean)
	for _, rail in plot.model.Fence:GetChildren() do
		if rail:IsA("BasePart") then
			rail.Transparency = enabled and 0 or 1
		end
	end
end

-- Re-reads the owner's profile: unlocked slots and fence.
function PlotService.refresh(plot)
	local profile = plot.owner and PlayerData.get(plot.owner)
	plot.unlocked = Config.BaseSlots + ((profile and profile.data.expanded) and Config.ExpansionSlots or 0)
	PlotService.setFence(plot, profile ~= nil and profile.data.upgrades.fence)
	for _, slot in plot.slots do
		updateSlot(plot, slot)
	end
end

local function teleportToPlot(plot, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root then
		task.wait(0.1)
		character:PivotTo(CFrame.new(plot.entrance + Vector3.new(0, 4, -3)) * CFrame.Angles(0, math.pi, 0))
	end
end

local function assign(player: Player, profile)
	for _, plot in PlotService.plots do
		if not plot.owner then
			plot.owner = player
			plotByPlayer[player] = plot
			profile.plotId = plot.id
			plot.model:SetAttribute("OwnerId", player.UserId)
			for _, slot in plot.slots do
				slot.prompt:SetAttribute("OwnerId", player.UserId)
			end
			World.setSign(plot.sign, "Грядка: " .. player.DisplayName, Color3.fromRGB(255, 232, 150), 12)
			PlotService.refresh(plot)

			plot.characterConnection = player.CharacterAdded:Connect(function(character)
				teleportToPlot(plot, character)
			end)
			if player.Character then
				task.spawn(teleportToPlot, plot, player.Character)
			end
			PlayerData.notify(player, string.format("Твоя грядка №%d. Выбери семя внизу и нажми F у земли.", plot.id), "info")
			return
		end
	end
	PlayerData.notify(player, "Свободных грядок нет. Можно ловить чужой сбежавший урожай!", "bad")
end

local function release(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	plotByPlayer[player] = nil
	if plot.characterConnection then
		plot.characterConnection:Disconnect()
		plot.characterConnection = nil
	end
	PlotService.clearCrops(plot)
	plot.owner = nil
	plot.model:SetAttribute("OwnerId", 0)
	for _, slot in plot.slots do
		slot.prompt:SetAttribute("OwnerId", 0)
	end
	World.setSign(plot.sign, "Свободная грядка", Color3.fromRGB(200, 200, 200), 12)
	PlotService.refresh(plot)
end

-- ---------------------------------------------------------------- remotes
local function plant(player: Player, index: any, seedId: any)
	if not AntiExploit.isInt(index, 1, TOTAL_SLOTS) or not AntiExploit.isId(seedId, GameData.Seeds) then
		return
	end
	local plot = plotByPlayer[player]
	local profile = PlayerData.get(player)
	if not plot or not profile then
		return
	end
	local slot = plot.slots[index]
	if index > plot.unlocked then
		PlayerData.notify(player, "Эта лунка откроется после «Расширения».", "bad")
		return
	end
	if slot.crop or not AntiExploit.distanceOk(player, slot.part.Position, Config.PlantDistance) then
		return
	end
	local count = profile.data.seeds[seedId] or 0
	if count < 1 then
		PlayerData.notify(player, "Нет таких семян. Загляни в магазин.", "bad")
		return
	end
	profile.data.seeds[seedId] = count - 1
	PlayerData.markDirty(player)
	createCrop(plot, slot, seedId)
	Remotes.Effect:FireClient(player, "sound", "plant")
end

local function harvest(player: Player, index: any)
	if not AntiExploit.isInt(index, 1, TOTAL_SLOTS) then
		return
	end
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local slot = plot.slots[index]
	local crop = slot.crop
	if not crop or crop.stage < 3 or not AntiExploit.distanceOk(player, slot.part.Position, Config.PlantDistance) then
		return
	end
	if not PlayerData.addItem(player, crop.seedId, nil, 0) then
		PlayerData.notify(player, "Инвентарь полон! Сначала продай урожай.", "bad")
		return
	end
	PlotService.removeCrop(plot, slot)
	Remotes.Effect:FireClient(player, "sound", "grow")
	PlayerData.notify(player, "Собрано: " .. GameData.itemName(crop.seedId, nil), "good")
end

function PlotService.init()
	local folder = World.map:WaitForChild("Plots")
	local index = 1
	while folder:FindFirstChild("Plot" .. index) do
		local model = folder:FindFirstChild("Plot" .. index) :: any
		local base = model.Base :: BasePart
		local half = base.Size / 2
		local plot = {
			id = index,
			model = model,
			sign = model.Sign :: BasePart,
			entrance = (model.Entrance :: BasePart).Position,
			minX = base.Position.X - half.X,
			maxX = base.Position.X + half.X,
			minZ = base.Position.Z - half.Z,
			maxZ = base.Position.Z + half.Z,
			owner = nil :: Player?,
			unlocked = Config.BaseSlots,
			slots = {},
			characterConnection = nil :: RBXScriptConnection?,
		}
		for slotIndex = 1, TOTAL_SLOTS do
			local part = model.Slots:FindFirstChild("Slot" .. slotIndex) :: BasePart
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "SlotPrompt"
			prompt.ObjectText = "Грядка"
			prompt.ActionText = "Посадить"
			prompt.KeyboardKeyCode = Enum.KeyCode.F
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 8
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("SlotIndex", slotIndex)
			prompt:SetAttribute("OwnerId", 0)
			prompt.Parent = part
			plot.slots[slotIndex] = { index = slotIndex, part = part, prompt = prompt, crop = nil }
		end
		World.setSign(plot.sign, "Свободная грядка", Color3.fromRGB(200, 200, 200), 12)
		table.insert(PlotService.plots, plot)
		PlotService.refresh(plot)
		index += 1
	end

	PlayerData.onLoaded(assign)
	PlayerData.onLeaving(release)
	AntiExploit.connect(Remotes.Plant, 4, 8, plant)
	AntiExploit.connect(Remotes.Harvest, 4, 8, harvest)
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">SellService</string>
          <string name="Source"><![CDATA[--[[
	SellService — the sell stand. Prices are computed on the server from GameData;
	crops that still carry the ownership tag are kept.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameData = require(ReplicatedStorage.Shared.GameData)
local AntiExploit = require(script.Parent.AntiExploit)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Config = GameData.Config

local SellService = {}

local function sell(player: Player)
	local profile = PlayerData.get(player)
	local stand = World.SellStand
	if not profile or not stand then
		return
	end
	if not AntiExploit.distanceOk(player, stand.Position, Config.SellDistance) then
		PlayerData.notify(player, "Подойди к прилавку «Продажа урожая» на площади.", "bad")
		return
	end

	local now = os.clock()
	local multiplier = PlayerData.sellMultiplier(player)
	local kept = {}
	local total, sold = 0, 0
	for _, item in profile.data.inventory do
		if item.t and item.t > now then
			table.insert(kept, item) -- ownership tag still active
		else
			total += GameData.itemPrice(item.s, item.m, multiplier)
			sold += 1
		end
	end
	if sold == 0 then
		if #kept > 0 then
			PlayerData.notify(player, "На урожае ещё метка владения. Подожди немного.", "bad")
		else
			PlayerData.notify(player, "Продавать нечего. Вырасти или поймай урожай!", "bad")
		end
		return
	end
	profile.data.inventory = kept
	PlayerData.addMoney(player, total, true)
	Remotes.Effect:FireClient(player, "sound", "sell")
	PlayerData.notify(player, string.format("Продано: %d шт. на %s", sold, GameData.formatMoney(total)), "good")
end

function SellService.init()
	AntiExploit.connect(Remotes.Sell, 1, 3, sell)
end

return SellService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--[[
	ShopService — everything bought with money: seeds, base defense (Забор, Липкая Ловушка,
	Свисток), Расширение, pets and Перерождение. Also handles trap placement and the whistle.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameData = require(ReplicatedStorage.Shared.GameData)
local AntiExploit = require(script.Parent.AntiExploit)
local CreatureService = require(script.Parent.CreatureService)
local PetService = require(script.Parent.PetService)
local PlayerData = require(script.Parent.PlayerData)
local PlotService = require(script.Parent.PlotService)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Config = GameData.Config

local ShopService = {}

local function noMoney(player: Player)
	PlayerData.notify(player, "Не хватает денег.", "bad")
	Remotes.Effect:FireClient(player, "sound", "error")
end

local function bought(player: Player, text: string)
	PlayerData.notify(player, text, "good")
	Remotes.Effect:FireClient(player, "sound", "click")
end

-- ---------------------------------------------------------------- purchases
local function buySeed(player: Player, profile, seedId: any, amount: any)
	if not AntiExploit.isId(seedId, GameData.Seeds) or not AntiExploit.isInt(amount, 1, 50) then
		return
	end
	local seed = GameData.Seeds[seedId]
	local data = profile.data
	if seed.requiresRebirth and data.rebirths < seed.requiresRebirth then
		PlayerData.notify(player, "Это семя открывается после Перерождения.", "bad")
		return
	end
	local owned = data.seeds[seedId] or 0
	if owned + amount > Config.MaxSeedStack then
		PlayerData.notify(player, "Столько семян не унести.", "bad")
		return
	end
	if not PlayerData.spend(player, seed.price * amount) then
		noMoney(player)
		return
	end
	data.seeds[seedId] = owned + amount
	bought(player, string.format("Куплено: %s x%d", seed.name, amount))
end

local function buyUpgrade(player: Player, profile, id: any)
	local data = profile.data
	local plot = PlotService.getPlot(player)

	if id == "expansion" then
		if data.expanded then
			return
		end
		if data.money < Config.ExpansionRequirement then
			PlayerData.notify(player, "Расширение откроется, когда накопишь "
				.. GameData.formatMoney(Config.ExpansionRequirement) .. ".", "bad")
			return
		end
		if not PlayerData.spend(player, Config.ExpansionRequirement) then
			return
		end
		data.expanded = true
		if plot then
			PlotService.refresh(plot)
		end
		bought(player, "Расширение куплено: +6 лунок и место для питомца!")
		return
	end

	if not AntiExploit.isId(id, GameData.Upgrades) then
		return
	end
	local upgrade = GameData.Upgrades[id]
	if id == "trap" then
		if data.upgrades.traps >= Config.MaxTraps then
			PlayerData.notify(player, "Больше ловушек не унести.", "bad")
			return
		end
		if not PlayerData.spend(player, upgrade.price) then
			noMoney(player)
			return
		end
		data.upgrades.traps += 1
		bought(player, "Куплена «Липкая Ловушка». Поставь её клавишей T.")
		return
	end

	if data.upgrades[id] then
		return
	end
	if not PlayerData.spend(player, upgrade.price) then
		noMoney(player)
		return
	end
	data.upgrades[id] = true
	if id == "fence" and plot then
		PlotService.refresh(plot)
	end
	bought(player, "Куплено: «" .. upgrade.name .. "»")
end

local function buyPet(player: Player, profile, petId: any)
	if not AntiExploit.isId(petId, GameData.Pets) then
		return
	end
	local data = profile.data
	if not data.expanded then
		PlayerData.notify(player, "Место для питомца появляется после «Расширения».", "bad")
		return
	end
	if data.pets[petId] then
		return
	end
	local pet = GameData.Pets[petId]
	if not PlayerData.spend(player, pet.price) then
		noMoney(player)
		return
	end
	data.pets[petId] = true
	data.pet = petId
	PetService.refresh(player)
	bought(player, "Новый питомец: " .. pet.name .. "!")
end

local function onBuy(player: Player, kind: any, id: any, amount: any)
	local profile = PlayerData.get(player)
	if not profile then
		return
	end
	if kind == "seed" then
		buySeed(player, profile, id, amount)
	elseif kind == "upgrade" then
		buyUpgrade(player, profile, id)
	elseif kind == "pet" then
		buyPet(player, profile, id)
	end
end

local function onEquipPet(player: Player, petId: any)
	local profile = PlayerData.get(player)
	if not profile or not AntiExploit.isId(petId, GameData.Pets) or not profile.data.pets[petId] then
		return
	end
	if profile.data.pet ~= petId then
		profile.data.pet = petId
		PlayerData.markDirty(player)
		PetService.refresh(player)
	end
end

-- ---------------------------------------------------------------- trap & whistle
-- The trap is always placed at the player's own feet: the client sends no position.
local function onPlaceTrap(player: Player)
	local profile = PlayerData.get(player)
	local root = AntiExploit.getRoot(player)
	if not profile or not root then
		return
	end
	local existing = CreatureService.traps[player.UserId]
	if not existing and profile.data.upgrades.traps < 1 then
		PlayerData.notify(player, "Ловушек нет. Купи «Липкую Ловушку» в улучшениях.", "bad")
		return
	end
	local position = Vector3.new(
		math.clamp(root.Position.X, -World.Bounds, World.Bounds), 0,
		math.clamp(root.Position.Z, -World.Bounds, World.Bounds))
	if existing then
		existing.part:Destroy() -- moving an already placed trap is free
	else
		profile.data.upgrades.traps -= 1
	end

	local part = Instance.new("Part")
	part.Name = "StickyTrap"
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.4, Config.TrapRadius * 2, Config.TrapRadius * 2)
	part.CFrame = CFrame.new(position + Vector3.new(0, 0.45, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	part.Color = Color3.fromRGB(230, 220, 70)
	part.Material = Enum.Material.Neon
	part.Transparency = 0.25
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Parent = World.Traps
	World.setSign(part, "Ловушка: " .. player.DisplayName, Color3.fromRGB(255, 240, 120), 9)

	CreatureService.traps[player.UserId] = { part = part, position = position, ownerId = player.UserId }
	profile.trapPlaced = true
	PlayerData.markDirty(player)
	Remotes.Effect:FireClient(player, "sound", "trap")
	PlayerData.notify(player, "Ловушка поставлена. Первый урожай, который наступит, прилипнет.", "good")
end

local function onWhistle(player: Player)
	local profile = PlayerData.get(player)
	local plot = PlotService.getPlot(player)
	if not profile or not plot then
		return
	end
	if not profile.data.upgrades.whistle then
		PlayerData.notify(player, "Сначала купи «Свисток» в улучшениях.", "bad")
		return
	end
	local now = os.clock()
	if now < profile.whistleReadyAt then
		PlayerData.notify(player, string.format("Свисток перезаряжается: %dс.", math.ceil(profile.whistleReadyAt - now)), "bad")
		return
	end
	local count = CreatureService.teleportOwned(player.UserId, plot.entrance)
	if count == 0 then
		PlayerData.notify(player, "Сбежавшего урожая сейчас нет.", "info")
		return
	end
	profile.whistleReadyAt = now + Config.WhistleCooldown
	PlayerData.markDirty(player)
	Remotes.Effect:FireClient(player, "sound", "whistle")
	PlayerData.notify(player, string.format("Свисток! К грядке вернулось: %d.", count), "good")
end

-- ---------------------------------------------------------------- rebirth
-- Resets money, seeds, inventory and growing crops. Upgrades, expansion and pets stay.
local function onRebirth(player: Player)
	local profile = PlayerData.get(player)
	if not profile then
		return
	end
	local data = profile.data
	if data.money < Config.RebirthRequirement then
		PlayerData.notify(player, "Для Перерождения нужно " .. GameData.formatMoney(Config.RebirthRequirement) .. ".", "bad")
		return
	end
	local plot = PlotService.getPlot(player)
	if plot then
		PlotService.clearCrops(plot)
	end
	data.inventory = {}
	data.seeds = table.clone(Config.StartSeeds)
	data.rebirths += 1
	PlayerData.addMoney(player, Config.StartMoney - data.money, false)
	Remotes.Effect:FireClient(player, "sound", "catch")
	Remotes.Notify:FireAllClients(string.format("%s переродился! Перерождений: %d", player.DisplayName, data.rebirths), "info")
	PlayerData.notify(player, "Цены продажи навсегда +25%. В магазине открыто «Золотое Семя»!", "good")
end

-- A player with no money, no seeds and nothing growing could never recover: give one seed.
local function rescueBrokePlayers()
	for _, plot in PlotService.plots do
		local player = plot.owner
		local profile = player and PlayerData.get(player)
		if player and profile then
			local data = profile.data
			local seeds = 0
			for _, count in data.seeds do
				seeds += count
			end
			if seeds == 0 and data.money < GameData.Seeds.carrot.price and #data.inventory == 0
				and PlotService.cropCount(plot) == 0 and CreatureService.countOwned(player.UserId) == 0 then
				data.seeds.carrot = 1
				PlayerData.markDirty(player)
				PlayerData.notify(player, "Подарок от соседей: семя моркови. Не сдавайся!", "good")
			end
		end
	end
end

function ShopService.init()
	AntiExploit.connect(Remotes.Buy, 5, 10, onBuy)
	AntiExploit.connect(Remotes.EquipPet, 2, 4, onEquipPet)
	AntiExploit.connect(Remotes.PlaceTrap, 1, 2, onPlaceTrap)
	AntiExploit.connect(Remotes.Whistle, 1, 2, onWhistle)
	AntiExploit.connect(Remotes.Rebirth, 0.5, 1, onRebirth)
	task.spawn(function()
		while true do
			task.wait(10)
			rescueBrokePlayers()
		end
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--[[
	World — references to the static map (Workspace.Map) plus the runtime folders.
	Adds Russian signs and the proximity prompts of the sell stand and the seed shop.
]]

local World = {}

World.map = workspace:WaitForChild("Map")
World.Bounds = 262 -- creatures stay inside ±Bounds on X and Z
World.ForestCenter = Vector3.new(0, 0, -190)
World.SellStand = nil :: BasePart?
World.ShopStand = nil :: BasePart?

local function runtimeFolder(name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = workspace
	return folder
end

World.Creatures = runtimeFolder("Creatures")
World.Pets = runtimeFolder("Pets")
World.Traps = runtimeFolder("Traps")
World.Crops = runtimeFolder("Crops")

local ZONE_SIGNS = {
	ZoneSignForest = "ЛЕС",
	ZoneSignGardens = "ГРЯДКИ",
	ZoneSignFieldsW = "ДИКИЕ ПОЛЯ",
	ZoneSignFieldsE = "ДИКИЕ ПОЛЯ",
}

-- Creates or updates a text sign that floats on a part and faces the camera.
function World.setSign(part: BasePart, text: string, color: Color3?, studsWide: number?)
	local gui = part:FindFirstChild("SignGui") :: BillboardGui?
	local label
	if gui then
		label = gui:FindFirstChild("Label") :: TextLabel
	else
		local newGui = Instance.new("BillboardGui")
		newGui.Name = "SignGui"
		newGui.Size = UDim2.fromScale(studsWide or 10, 2.6)
		newGui.MaxDistance = 220
		newGui.LightInfluence = 0
		newGui.Adornee = part
		label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextStrokeTransparency = 0.2
		label.Parent = newGui
		newGui.Parent = part
	end
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(255, 244, 214)
end

local function addPrompt(part: BasePart, name: string, objectText: string, actionText: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ObjectText = objectText
	prompt.ActionText = actionText
	prompt.KeyboardKeyCode = Enum.KeyCode.F -- E is reserved for catching
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
end

function World.init()
	local plaza = World.map:WaitForChild("Plaza")
	local sell = plaza:WaitForChild("SellStand") :: BasePart
	local shop = plaza:WaitForChild("ShopStand") :: BasePart
	World.SellStand = sell
	World.ShopStand = shop

	World.setSign(plaza:WaitForChild("SellSign") :: BasePart, "ПРОДАЖА УРОЖАЯ", Color3.fromRGB(255, 214, 90), 14)
	World.setSign(plaza:WaitForChild("ShopSign") :: BasePart, "МАГАЗИН СЕМЯН", Color3.fromRGB(150, 220, 255), 14)
	addPrompt(sell, "SellPrompt", "Прилавок", "Продать Урожай")
	addPrompt(shop, "ShopPrompt", "Магазин семян", "Открыть магазин")

	for _, sign in World.map:WaitForChild("Signs"):GetChildren() do
		local text = ZONE_SIGNS[sign.Name]
		if text and sign:IsA("BasePart") then
			World.setSign(sign, text)
		end
	end
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="37">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="38">
      <Properties>
        <string name="Name">MainGui</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="39">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client — entry point of the Russian UI. Loads the UI modules in order.
	The ScreenGui (MainGui) itself is the container for everything they build.
]]

local folder = script.Parent

local State = require(folder:WaitForChild("ClientState"))
require(folder:WaitForChild("UIKit"))
local Effects = require(folder:WaitForChild("Effects"))
local Windows = require(folder:WaitForChild("Windows"))
local Hud = require(folder:WaitForChild("Hud"))
local Controller = require(folder:WaitForChild("Controller"))

Effects.init()
Windows.init()
Hud.init()
Controller.init()
State.init() -- last: asks the server for the first state snapshot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[--[[
	ClientState — the latest snapshot of the player's profile sent by the server,
	plus the seed currently selected for planting. UI modules listen to State.changed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameData"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local State = {}
State.data = nil :: any -- nil until the first snapshot arrives
State.receivedAt = 0 -- os.clock() of the last snapshot (for local countdowns)
State.selectedSeed = nil :: string?

local changedEvent = Instance.new("BindableEvent")
State.changed = changedEvent.Event

local function fixSelection()
	local seeds = State.data and State.data.seeds or {}
	if State.selectedSeed and (seeds[State.selectedSeed] or 0) > 0 then
		return
	end
	State.selectedSeed = nil
	for _, id in GameData.SeedOrder do
		if (seeds[id] or 0) > 0 then
			State.selectedSeed = id
			return
		end
	end
end

function State.select(seedId: string)
	State.selectedSeed = seedId
	changedEvent:Fire()
end

-- Seconds since the last snapshot; used to count server timers down locally.
function State.elapsed(): number
	return os.clock() - State.receivedAt
end

function State.sellMultiplier(): number
	local data = State.data
	if not data then
		return 1
	end
	return GameData.sellMultiplier(data.rebirths, data.pet)
end

function State.init()
	Remotes:WaitForChild("StateUpdate").OnClientEvent:Connect(function(snapshot)
		State.data = snapshot
		State.receivedAt = os.clock()
		fixSelection()
		changedEvent:Fire()
	end)
	Remotes:WaitForChild("RequestState"):FireServer()
end

return State
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">Controller</string>
          <string name="Source"><![CDATA[--[[
	Controller — player input:
	  hold E (or the «ЛОВИТЬ» button) near an escaped crop → catch meter
	  F at a soil slot → plant the selected seed / harvest; F at the stands → sell / shop
	  Q → whistle, T → place the sticky trap
	The client only asks; the server checks distance, ownership and progress.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GameData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameData"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local State = require(script.Parent:WaitForChild("ClientState"))
local Windows = require(script.Parent:WaitForChild("Windows"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local Config = GameData.Config

local KEEP_TARGET_DISTANCE = 35 -- keep chasing the same creature while it is this close

local Controller = {}
local holding = false
local targetId: number? = nil

local function rootPosition(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

-- Nearest creature inside its catch radius (+margin), and the distance to the current target.
local function scan(position: Vector3, margin: number): (number?, number?)
	local folder = workspace:FindFirstChild("Creatures")
	if not folder then
		return nil, nil
	end
	local nearestId, nearestDistance = nil, math.huge
	local targetDistance = nil
	for _, model in folder:GetChildren() do
		local root = model:FindFirstChild("Root")
		local id = model:GetAttribute("CreatureId")
		if root and root:IsA("BasePart") and type(id) == "number" then
			local distance = (root.Position - position).Magnitude
			local radius = Config.CatchRadius + ((model:GetAttribute("Scale") or 1) - 1) * 4
			if id == targetId then
				targetDistance = distance
			end
			if distance <= radius + margin and distance < nearestDistance then
				nearestId, nearestDistance = id, distance
			end
		end
	end
	return nearestId, targetDistance
end

local function setHolding(value: boolean)
	if holding == value then
		return
	end
	holding = value
	if not holding then
		if targetId then
			Remotes.CatchStop:FireServer()
		end
		targetId = nil
		Hud.setCatch(0)
	end
end

local sinceScan = 0
local function step(dt: number)
	sinceScan += dt
	if sinceScan < 0.15 then
		return
	end
	sinceScan = 0
	local position = rootPosition()
	if not position then
		Hud.setCatchHint(false)
		return
	end
	local nearestId, targetDistance = scan(position, 2)
	Hud.setCatchHint(nearestId ~= nil and not holding)
	if not holding then
		return
	end
	local wanted = nearestId
	if targetId and targetDistance and targetDistance <= KEEP_TARGET_DISTANCE then
		wanted = targetId -- stay on the creature we started with
	end
	if wanted ~= targetId then
		targetId = wanted
		if wanted then
			Remotes.CatchStart:FireServer(wanted)
		else
			Remotes.CatchStop:FireServer()
			Hud.setCatch(0)
		end
	end
end

local function onPrompt(prompt: ProximityPrompt)
	if prompt.Name == "SellPrompt" then
		Windows.open("inventory")
	elseif prompt.Name == "ShopPrompt" then
		Windows.open("shop")
	elseif prompt.Name == "SlotPrompt" then
		if prompt:GetAttribute("OwnerId") ~= player.UserId then
			Hud.notify("Это чужая грядка!", "bad")
			return
		end
		local index = prompt:GetAttribute("SlotIndex")
		local state = prompt:GetAttribute("State")
		if state == "ripe" then
			Remotes.Harvest:FireServer(index)
		elseif state == "empty" then
			if State.selectedSeed then
				Remotes.Plant:FireServer(index, State.selectedSeed)
			else
				Hud.notify("Семян нет. Купи их в магазине.", "bad")
				Windows.open("shop")
			end
		end
	end
end

function Controller.init()
	Hud.callbacks.catchHold = setHolding
	Hud.callbacks.whistle = function()
		Remotes.Whistle:FireServer()
	end
	Hud.callbacks.trap = function()
		Remotes.PlaceTrap:FireServer()
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.E then
			setHolding(true)
		elseif input.KeyCode == Enum.KeyCode.Q then
			Hud.callbacks.whistle()
		elseif input.KeyCode == Enum.KeyCode.T then
			Hud.callbacks.trap()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.E then
			setHolding(false)
		end
	end)

	Remotes:WaitForChild("CatchProgress").OnClientEvent:Connect(function(_id, fraction)
		if holding and type(fraction) == "number" then
			Hud.setCatch(fraction)
		else
			Hud.setCatch(0)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who == player then
			onPrompt(prompt)
		end
	end)
	RunService.Heartbeat:Connect(step)
end

return Controller
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--[[
	Effects — sounds, the leg animation of escaped crops and the titan knockdown.
	The server only moves creatures; legs are swung here so it costs no network traffic.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local GameData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameData"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local HEAR_DISTANCE = 140

local Effects = {}
local templates = {} -- [name] = Sound

-- volumeScale lets distant sounds play quieter.
function Effects.play(name: string, volumeScale: number?)
	local template = templates[name]
	local info = GameData.Sounds[name]
	if not template or not info then
		return
	end
	local function once(pitch: number)
		local sound = template:Clone()
		sound.PlaybackSpeed = pitch
		sound.Volume = info.volume * (volumeScale or 1)
		sound.Parent = SoundService
		sound.Ended:Once(function()
			sound:Destroy()
		end)
		sound:Play()
		task.delay(6, function()
			if sound.Parent then
				sound:Destroy()
			end
		end)
	end
	once(info.pitch)
	if info.double then
		task.delay(0.14, once, info.pitch * 1.25)
	end
end

local function playAt(name: string, position: Vector3)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local distance = (camera.CFrame.Position - position).Magnitude
	if distance < HEAR_DISTANCE then
		Effects.play(name, 1 - distance / HEAR_DISTANCE * 0.8)
	end
end

local function knockdown(from: Vector3)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return
	end
	local away = root.Position - from
	away = Vector3.new(away.X, 0, away.Z)
	if away.Magnitude < 0.1 then
		away = Vector3.new(1, 0, 0)
	end
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = away.Unit * 38 + Vector3.new(0, 36, 0)
	task.delay(1.5, function()
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)
end

local function animateLegs()
	local folder = workspace:FindFirstChild("Creatures")
	if not folder then
		return
	end
	local now = os.clock()
	for _, model in folder:GetChildren() do
		local root = model:FindFirstChild("Root")
		local left = root and root:FindFirstChild("LeftHip")
		local right = root and root:FindFirstChild("RightHip")
		if left and right and left:IsA("Motor6D") and right:IsA("Motor6D") then
			local scale = model:GetAttribute("Scale") or 1
			local speed = model:GetAttribute("Speed") or 14
			local swing = model:GetAttribute("Stunned") and 0 or math.sin(now * speed * 0.9 / math.sqrt(scale)) * 0.9
			left.C0 = CFrame.new(-0.5 * scale, -0.8 * scale, 0) * CFrame.Angles(swing, 0, 0)
			right.C0 = CFrame.new(0.5 * scale, -0.8 * scale, 0) * CFrame.Angles(-swing, 0, 0)
		end
	end
end

function Effects.init()
	for name, info in GameData.Sounds do
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = info.id
		sound.Parent = script
		templates[name] = sound
	end
	UIKit.onClick = function()
		Effects.play("click")
	end

	Remotes:WaitForChild("Effect").OnClientEvent:Connect(function(kind, a)
		if kind == "sound" and type(a) == "string" then
			Effects.play(a)
		elseif kind == "scream" and typeof(a) == "Vector3" then
			playAt("scream", a)
		elseif kind == "stomp" and typeof(a) == "Vector3" then
			playAt("stomp", a)
		elseif kind == "trap" and typeof(a) == "Vector3" then
			playAt("trap", a)
		elseif kind == "caught" and typeof(a) == "Vector3" then
			playAt("grow", a)
		elseif kind == "knockdown" and typeof(a) == "Vector3" then
			knockdown(a)
		end
	end)
	RunService.RenderStepped:Connect(animateLegs)
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Hud</string>
          <string name="Source"><![CDATA[--[[
	Hud — always-visible interface: top bar (Деньги, Доход, таймер события), menu buttons,
	seed bar, action buttons, catch meter, notifications and the big event banner.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local GameData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameData"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local State = require(script.Parent:WaitForChild("ClientState"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Windows = require(script.Parent:WaitForChild("Windows"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Colors = UIKit.Colors
local money = GameData.formatMoney

local Hud = {}
-- Set by Controller: what the action buttons do.
Hud.callbacks = {
	catchHold = function(_holding: boolean) end,
	whistle = function() end,
	trap = function() end,
}

local gui = script.Parent
local moneyLabel, incomeLabel, eventLabel
local seedBar, seedHint
local whistleButton, trapButton
local meter, meterFill, meterLabel, catchHint
local notifications
local banner, bannerTitle, bannerSub
local bannerToken = 0

-- ---------------------------------------------------------------- notifications
local KIND_COLORS = { good = Colors.green, bad = Colors.red, info = Colors.blue }

function Hud.notify(text: string, kind: string?)
	local children = notifications:GetChildren()
	local frames = {}
	for _, child in children do
		if child:IsA("Frame") then
			table.insert(frames, child)
		end
	end
	if #frames >= 5 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end

	local frame = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Colors.bg, BackgroundTransparency = 0.1,
		LayoutOrder = math.floor(os.clock() * 100), Parent = notifications,
	}, { UIKit.corner(10), UIKit.stroke(KIND_COLORS[kind or "info"] or Colors.blue, 2) })
	local label = UIKit.label({
		Text = text, TextSize = 15, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = frame,
	})
	UIKit.padding(10).Parent = frame
	if kind == "bad" then
		Effects.play("error")
	end
	task.delay(5, function()
		if frame.Parent then
			local info = TweenInfo.new(0.4)
			TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, info, { TextTransparency = 1 }):Play()
			task.wait(0.45)
			frame:Destroy()
		end
	end)
end

-- ---------------------------------------------------------------- event banner
function Hud.showBanner(title: string, subtitle: string, color: Color3)
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerTitle.TextColor3 = color
	bannerSub.Text = subtitle
	banner.Visible = true
	bannerTitle.TextTransparency = 0
	bannerSub.TextTransparency = 0
	banner.Size = UDim2.fromOffset(600, 100)
	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(820, 136) }):Play()
	task.delay(6, function()
		if token == bannerToken then
			banner.Visible = false
		end
	end)
end

-- ---------------------------------------------------------------- catch meter
-- fraction 0..1; 0 hides the meter.
function Hud.setCatch(fraction: number)
	meter.Visible = fraction > 0
	meterFill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	meterLabel.Text = string.format("Ловлю… %d%%", math.floor(math.clamp(fraction, 0, 1) * 100))
end

function Hud.setCatchHint(visible: boolean)
	catchHint.Visible = visible and not meter.Visible
end

-- ---------------------------------------------------------------- state rendering
local function renderSeedBar()
	UIKit.clear(seedBar)
	local data = State.data
	local any = false
	if data then
		for order, id in GameData.SeedOrder do
			local count = data.seeds[id] or 0
			if count > 0 then
				any = true
				local seed = GameData.Seeds[id]
				local selected = State.selectedSeed == id
				local button = UIKit.button(string.format("%s\nx%d", seed.name, count), Colors.panel, function()
					State.select(id)
				end, { Size = UDim2.fromOffset(116, 54), TextSize = 14, LayoutOrder = order, Parent = seedBar })
				button.TextColor3 = GameData.Rarities[seed.rarity].color
				UIKit.stroke(selected and Colors.accent or Colors.bg, selected and 4 or 2).Parent = button
			end
		end
	end
	seedHint.Text = any and "Выбери семя и нажми F у своей грядки" or "Семян нет — загляни в Магазин"
end

local function render()
	local data = State.data
	if not data then
		return
	end
	moneyLabel.Text = "Деньги: " .. money(data.money)
	incomeLabel.Text = "Доход: " .. money(data.income) .. "/мин"
	renderSeedBar()
	whistleButton.Visible = data.upgrades.whistle
	trapButton.Visible = data.trapPlaced or data.upgrades.traps > 0
	trapButton.Text = string.format("Ловушка [T]\nв запасе: %d", data.upgrades.traps)
end

local function tick()
	local now = workspace:GetServerTimeNow()
	local active = workspace:GetAttribute("ActiveEvent")
	local event = active and GameData.Events[active]
	if event then
		local ends = workspace:GetAttribute("ActiveEventEnds") or now
		eventLabel.Text = string.format("%s: %s", event.name, GameData.formatTime(ends - now))
		eventLabel.TextColor3 = event.color
	else
		local nextAt = workspace:GetAttribute("NextEventAt")
		eventLabel.Text = nextAt and ("Событие через: " .. GameData.formatTime(nextAt - now)) or "Событие: скоро"
		eventLabel.TextColor3 = Colors.text
	end

	local data = State.data
	if data and data.upgrades.whistle then
		local left = math.ceil(data.whistleLeft - State.elapsed())
		whistleButton.Text = left > 0 and string.format("Свисток\n%dс", left) or "Свисток [Q]"
		UIKit.setEnabled(whistleButton, left <= 0, Colors.blue)
	end
end

-- ---------------------------------------------------------------- build
local function pill(parent: Instance, order: number, width: number): TextLabel
	local frame = UIKit.new("Frame", {
		Size = UDim2.fromOffset(width, 42), BackgroundColor3 = Colors.bg, BackgroundTransparency = 0.15,
		LayoutOrder = order, Parent = parent,
	}, { UIKit.corner(12), UIKit.stroke(Colors.panel, 2) })
	return UIKit.label({
		Text = "", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false,
		Size = UDim2.fromScale(1, 1), Parent = frame,
	})
end

function Hud.init()
	-- keep the layout readable on phones and big monitors alike
	local scale = UIKit.new("UIScale", { Parent = gui })
	local function updateScale()
		local camera = workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.5, 1.3)
		end
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end

	-- top bar
	local topBar = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(760, 42),
		BackgroundTransparency = 1, Parent = gui,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) })
	moneyLabel = pill(topBar, 1, 220)
	moneyLabel.TextColor3 = Colors.accent
	incomeLabel = pill(topBar, 2, 220)
	incomeLabel.TextColor3 = Colors.green
	eventLabel = pill(topBar, 3, 300)

	-- menu buttons (left)
	local menu = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(160, 170),
		BackgroundTransparency = 1, Parent = gui,
	}, { UIKit.list(Enum.FillDirection.Vertical, 8) })
	local menuItems = { { "Магазин", "shop", Colors.green }, { "Инвентарь", "inventory", Colors.blue }, { "Улучшения", "upgrades", Colors.accent } }
	for order, item in menuItems do
		local button = UIKit.button(item[1], item[3], function()
			Windows.toggle(item[2])
		end, { Size = UDim2.fromOffset(160, 50), TextSize = 18, LayoutOrder = order, Parent = menu })
		UIKit.stroke(Colors.bg, 2).Parent = button
	end

	-- action buttons (right)
	local actions = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(160, 200),
		BackgroundTransparency = 1, Parent = gui,
	}, { UIKit.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right) })
	local catchButton = UIKit.button("ЛОВИТЬ", Colors.red, function() end, {
		Size = UDim2.fromOffset(160, 70), TextSize = 22, LayoutOrder = 1, Visible = UserInputService.TouchEnabled, Parent = actions,
	})
	catchButton.MouseButton1Down:Connect(function()
		Hud.callbacks.catchHold(true)
	end)
	catchButton.MouseButton1Up:Connect(function()
		Hud.callbacks.catchHold(false)
	end)
	catchButton.MouseLeave:Connect(function()
		Hud.callbacks.catchHold(false)
	end)
	whistleButton = UIKit.button("Свисток [Q]", Colors.blue, function()
		Hud.callbacks.whistle()
	end, { Size = UDim2.fromOffset(160, 50), LayoutOrder = 2, Visible = false, Parent = actions })
	trapButton = UIKit.button("Ловушка [T]", Colors.accent, function()
		Hud.callbacks.trap()
	end, { Size = UDim2.fromOffset(160, 50), LayoutOrder = 3, Visible = false, TextColor3 = Colors.bg, Parent = actions })

	-- seed bar (bottom)
	seedHint = UIKit.label({
		Text = "", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -76), Size = UDim2.fromOffset(600, 20), Parent = gui,
	})
	seedBar = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(0, 58),
		AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Parent = gui,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })

	-- catch meter
	catchHint = UIKit.label({
		Text = UserInputService.TouchEnabled and "Удерживай кнопку «ЛОВИТЬ»" or "Удерживай E, чтобы поймать",
		TextSize = 18, TextColor3 = Colors.accent, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.2,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -112), Size = UDim2.fromOffset(500, 26),
		Visible = false, Parent = gui,
	})
	meter = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -108), Size = UDim2.fromOffset(360, 34),
		BackgroundColor3 = Colors.bg, Visible = false, Parent = gui,
	}, { UIKit.corner(10), UIKit.stroke(Colors.accent, 2) })
	meterFill = UIKit.new("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = Colors.green, Parent = meter,
	}, { UIKit.corner(10) })
	meterLabel = UIKit.label({
		Text = "", TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = meter,
	})

	-- notifications (right top)
	notifications = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 56), Size = UDim2.fromOffset(340, 300),
		BackgroundTransparency = 1, Parent = gui,
	}, {
		UIKit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- event banner
	banner = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.26), Size = UDim2.fromOffset(820, 136),
		BackgroundColor3 = Colors.bg, BackgroundTransparency = 0.2, Visible = false, ZIndex = 20, Parent = gui,
	}, { UIKit.corner(18), UIKit.stroke(Colors.accent, 3) })
	bannerTitle = UIKit.label({
		Text = "", TextSize = 46, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextScaled = true,
		Position = UDim2.new(0.04, 0, 0.08, 0), Size = UDim2.new(0.92, 0, 0.52, 0), ZIndex = 21, Parent = banner,
	})
	bannerSub = UIKit.label({
		Text = "", TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, TextScaled = true,
		Position = UDim2.new(0.04, 0, 0.64, 0), Size = UDim2.new(0.92, 0, 0.26, 0), ZIndex = 21, Parent = banner,
	})

	-- wiring
	State.changed:Connect(render)
	Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text, kind)
		if type(text) == "string" then
			Hud.notify(text, kind)
		end
	end)
	Remotes:WaitForChild("EventAnnounce").OnClientEvent:Connect(function(id)
		local event = GameData.Events[id]
		if event then
			Effects.play("alarm")
			Hud.showBanner(event.name, event.desc, event.color)
		end
	end)
	task.spawn(function()
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return Hud
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source"><![CDATA[--[[
	UIKit — small helpers for building the interface in code: colours, labels, buttons, windows.
]]

local UIKit = {}

UIKit.Colors = {
	bg = Color3.fromRGB(30, 27, 44),
	panel = Color3.fromRGB(46, 42, 66),
	row = Color3.fromRGB(58, 53, 82),
	accent = Color3.fromRGB(255, 200, 60),
	green = Color3.fromRGB(84, 190, 96),
	red = Color3.fromRGB(226, 84, 84),
	blue = Color3.fromRGB(80, 150, 240),
	grey = Color3.fromRGB(110, 106, 130),
	text = Color3.fromRGB(255, 255, 255),
	dim = Color3.fromRGB(190, 186, 210),
}

UIKit.onClick = nil :: (() -> ())? -- set by Effects to play the click sound

function UIKit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className) :: any
	local parent = nil
	for key, value in (props or {}) :: { [string]: any } do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in (children or {}) :: { Instance } do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.corner(radius: number?): UICorner
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UIKit.stroke(color: Color3?, thickness: number?): UIStroke
	return UIKit.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.padding(amount: number): UIPadding
	return UIKit.new("UIPadding", {
		PaddingLeft = UDim.new(0, amount), PaddingRight = UDim.new(0, amount),
		PaddingTop = UDim.new(0, amount), PaddingBottom = UDim.new(0, amount),
	})
end

function UIKit.list(direction: Enum.FillDirection, gap: number, align: Enum.HorizontalAlignment?): UIListLayout
	return UIKit.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
end

function UIKit.label(props: { [string]: any }): TextLabel
	local label = UIKit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = UIKit.Colors.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	})
	for key, value in props do
		(label :: any)[key] = value
	end
	return label
end

function UIKit.button(text: string, color: Color3, callback: () -> (), props: { [string]: any }?): TextButton
	local button = UIKit.new("TextButton", {
		Text = text,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = UIKit.Colors.text,
		BackgroundColor3 = color,
		AutoButtonColor = true,
		TextWrapped = true,
	}, { UIKit.corner(8) })
	for key, value in (props or {}) :: { [string]: any } do
		(button :: any)[key] = value
	end
	button.MouseButton1Click:Connect(function()
		if not button.Active then
			return
		end
		if UIKit.onClick then
			UIKit.onClick()
		end
		callback()
	end)
	return button
end

-- Greys a button out and makes it ignore clicks.
function UIKit.setEnabled(button: TextButton, enabled: boolean, color: Color3?)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundColor3 = enabled and (color or button.BackgroundColor3) or UIKit.Colors.grey
end

-- Removes everything from a list container except its layout objects.
function UIKit.clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

--[[
	Centered window with a title, a close button, a scrolling list and an optional footer.
	Returns { frame, content, footer }.
]]
function UIKit.window(parent: Instance, title: string, footerHeight: number?, onClose: () -> ())
	local footerSize = footerHeight or 0
	local frame = UIKit.new("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(660, 480),
		BackgroundColor3 = UIKit.Colors.bg,
		Visible = false,
		ZIndex = 10,
		Parent = parent,
	}, { UIKit.corner(16), UIKit.stroke(UIKit.Colors.accent, 3) })

	UIKit.label({
		Text = title, TextSize = 24, Font = Enum.Font.GothamBlack, TextColor3 = UIKit.Colors.accent,
		Position = UDim2.fromOffset(20, 10), Size = UDim2.new(1, -90, 0, 40), ZIndex = 11, Parent = frame,
	})
	UIKit.button("×", UIKit.Colors.red, onClose, {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(36, 36), TextSize = 26, ZIndex = 11, Parent = frame,
	})

	local content = UIKit.new("ScrollingFrame", {
		Position = UDim2.fromOffset(14, 58),
		Size = UDim2.new(1, -28, 1, -(72 + footerSize)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 11,
		Parent = frame,
	}, { UIKit.list(Enum.FillDirection.Vertical, 8) })

	local footer = nil
	if footerSize > 0 then
		footer = UIKit.new("Frame", {
			AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -12),
			Size = UDim2.new(1, -28, 0, footerSize), BackgroundColor3 = UIKit.Colors.panel,
			ZIndex = 11, Parent = frame,
		}, { UIKit.corner(10) })
	end
	return { frame = frame, content = content, footer = footer }
end

-- A list row: dark rounded frame of the given height.
function UIKit.row(parent: Instance, height: number, order: number): Frame
	return UIKit.new("Frame", {
		Size = UDim2.new(1, -12, 0, height),
		BackgroundColor3 = UIKit.Colors.row,
		LayoutOrder = order,
		ZIndex = 12,
		Parent = parent,
	}, { UIKit.corner(10) })
end

return UIKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Windows</string>
          <string name="Source"><![CDATA[--[[
	Windows — the three windows of the game, all in Russian:
	  shop      «Магазин семян»
	  inventory «Инвентарь» (also the sell window)
	  upgrades  «Улучшения» (defense, expansion, pets, rebirth)
	Buttons only send requests; the server decides and sends the new state back.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameData"))
local State = require(script.Parent:WaitForChild("ClientState"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Config = GameData.Config
local Colors = UIKit.Colors
local money = GameData.formatMoney

local Windows = {}
local windows: { [string]: any } = {} -- [name] = { frame, content, footer, render }
local current: string? = nil
local rebirthArmedAt = 0 -- the rebirth button must be pressed twice

function Windows.close()
	if current then
		windows[current].frame.Visible = false
		current = nil
	end
end

function Windows.open(name: string)
	if current == name then
		return
	end
	Windows.close()
	current = name
	windows[name].frame.Visible = true
	windows[name].render()
end

function Windows.toggle(name: string)
	if current == name then
		Windows.close()
	else
		Windows.open(name)
	end
end

-- Row with a title, a description and up to two buttons on the right.
local function actionRow(parent: Instance, order: number, title: string, titleColor: Color3, desc: string, buttons)
	local row = UIKit.row(parent, 76, order)
	local buttonsWidth = #buttons * 150
	UIKit.label({
		Text = title, TextSize = 18, TextColor3 = titleColor, ZIndex = 13,
		Position = UDim2.fromOffset(22, 8), Size = UDim2.new(1, -(buttonsWidth + 36), 0, 22), Parent = row,
	})
	UIKit.label({
		Text = desc, TextSize = 13, Font = Enum.Font.GothamMedium, TextColor3 = Colors.dim, ZIndex = 13,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(22, 32), Size = UDim2.new(1, -(buttonsWidth + 36), 0, 40), Parent = row,
	})
	for index, info in buttons do
		local button = UIKit.button(info.text, info.color or Colors.green, info.callback or function() end, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10 - (#buttons - index) * 150, 0.5, 0),
			Size = UDim2.fromOffset(142, 54), TextSize = 14, ZIndex = 13, Parent = row,
		})
		if info.enabled == false then
			UIKit.setEnabled(button, false)
		end
	end
	return row
end

local function header(parent: Instance, order: number, text: string)
	UIKit.label({
		Text = text, TextSize = 17, Font = Enum.Font.GothamBlack, TextColor3 = Colors.accent,
		Size = UDim2.new(1, -12, 0, 26), LayoutOrder = order, ZIndex = 12, Parent = parent,
	})
end

-- ---------------------------------------------------------------- shop
local function renderShop()
	local window = windows.shop
	local data = State.data
	UIKit.clear(window.content)
	if not data then
		return
	end
	for order, id in GameData.SeedOrder do
		local seed = GameData.Seeds[id]
		local rarity = GameData.Rarities[seed.rarity]
		local locked = seed.requiresRebirth ~= nil and data.rebirths < seed.requiresRebirth
		local desc = string.format("Рост: %dс · Шанс мутации: %d%% · Продажа: %s\nУ тебя семян: %d",
			seed.growTime, math.floor(rarity.mutationChance * 100 + 0.5),
			money(GameData.itemPrice(id, nil, State.sellMultiplier())), data.seeds[id] or 0)
		local buttons
		if locked then
			buttons = { { text = "Откроется после Перерождения", enabled = false } }
		else
			buttons = {
				{
					text = "Купить 1\n" .. money(seed.price), enabled = data.money >= seed.price,
					callback = function()
						Remotes.Buy:FireServer("seed", id, 1)
					end,
				},
				{
					text = "Купить 10\n" .. money(seed.price * 10), color = Colors.blue, enabled = data.money >= seed.price * 10,
					callback = function()
						Remotes.Buy:FireServer("seed", id, 10)
					end,
				},
			}
		end
		local row = actionRow(window.content, order, seed.name .. " — " .. rarity.name, rarity.color, desc, buttons)
		UIKit.new("Frame", {
			Position = UDim2.fromOffset(6, 8), Size = UDim2.new(0, 8, 1, -16), BackgroundColor3 = rarity.color,
			BorderSizePixel = 0, ZIndex = 13, Parent = row,
		}, { UIKit.corner(4) })
	end
end

-- ---------------------------------------------------------------- inventory / selling
local function renderInventory()
	local window = windows.inventory
	local data = State.data
	UIKit.clear(window.content)
	if not data then
		return
	end
	local elapsed = State.elapsed()
	local multiplier = State.sellMultiplier()

	-- group identical crops into one row
	local groups, order = {}, {}
	local total, sellable = 0, 0
	for _, item in data.inventory do
		local key = item.s .. "|" .. (item.m or "")
		local group = groups[key]
		if not group then
			group = { s = item.s, m = item.m, count = 0, locked = 0, lockLeft = 0, price = GameData.itemPrice(item.s, item.m, multiplier) }
			groups[key] = group
			table.insert(order, group)
		end
		group.count += 1
		local left = item.l - elapsed
		if left > 0 then
			group.locked += 1
			group.lockLeft = math.max(group.lockLeft, left)
		else
			total += group.price
			sellable += 1
		end
	end
	table.sort(order, function(a, b)
		return a.price > b.price
	end)

	if #order == 0 then
		UIKit.label({
			Text = "Пока пусто. Собери созревший урожай или поймай сбежавший!", TextSize = 16, TextColor3 = Colors.dim,
			TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -12, 0, 80), ZIndex = 12, Parent = window.content,
		})
	end
	for index, group in order do
		local mutation = group.m and GameData.Mutations[group.m]
		local row = UIKit.row(window.content, 58, index)
		UIKit.label({
			Text = string.format("%s  x%d", GameData.itemName(group.s, group.m), group.count), TextSize = 17,
			TextColor3 = mutation and mutation.color or Colors.text, ZIndex = 13,
			Position = UDim2.fromOffset(16, 6), Size = UDim2.new(1, -220, 0, 24), Parent = row,
		})
		local note = mutation and string.format("Мутация: цена x%d", mutation.multiplier) or "Обычный урожай"
		if group.locked > 0 then
			note = string.format("Метка владения: %dс (%d шт.)", math.ceil(group.lockLeft), group.locked)
		end
		UIKit.label({
			Text = note, TextSize = 13, Font = Enum.Font.GothamMedium, ZIndex = 13,
			TextColor3 = group.locked > 0 and Colors.red or Colors.dim,
			Position = UDim2.fromOffset(16, 30), Size = UDim2.new(1, -220, 0, 20), Parent = row,
		})
		UIKit.label({
			Text = money(group.price) .. " за шт.", TextSize = 16, TextColor3 = Colors.accent, ZIndex = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(190, 24), Parent = row,
		})
	end

	window.totalLabel.Text = string.format("Итого к продаже: %s  (%d шт.)\nМест в инвентаре: %d из %d",
		money(total), sellable, #data.inventory, Config.InventoryLimit)
	UIKit.setEnabled(window.sellButton, sellable > 0, Colors.green)
end

-- ---------------------------------------------------------------- upgrades
local function renderUpgrades()
	local window = windows.upgrades
	local data = State.data
	UIKit.clear(window.content)
	if not data then
		return
	end
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end
	local function buy(kind: string, id: string)
		return function()
			Remotes.Buy:FireServer(kind, id)
		end
	end

	header(window.content, nextOrder(), "Защита грядки")
	local fence = GameData.Upgrades.fence
	actionRow(window.content, nextOrder(), fence.name, Colors.text, fence.desc, {
		data.upgrades.fence and { text = "Куплено", enabled = false }
			or { text = "Купить\n" .. money(fence.price), enabled = data.money >= fence.price, callback = buy("upgrade", "fence") },
	})

	local trap = GameData.Upgrades.trap
	actionRow(window.content, nextOrder(), string.format("%s (в запасе: %d)", trap.name, data.upgrades.traps), Colors.text,
		trap.desc .. (data.trapPlaced and " Сейчас одна стоит на карте." or ""), {
			{
				text = "Купить\n" .. money(trap.price), callback = buy("upgrade", "trap"),
				enabled = data.money >= trap.price and data.upgrades.traps < Config.MaxTraps,
			},
			{
				text = data.trapPlaced and "Переставить\n[T]" or "Поставить\n[T]", color = Colors.blue,
				enabled = data.trapPlaced or data.upgrades.traps > 0,
				callback = function()
					Remotes.PlaceTrap:FireServer()
				end,
			},
		})

	local whistle = GameData.Upgrades.whistle
	local whistleLeft = math.ceil(data.whistleLeft - State.elapsed())
	local whistleButton
	if not data.upgrades.whistle then
		whistleButton = { text = "Купить\n" .. money(whistle.price), enabled = data.money >= whistle.price, callback = buy("upgrade", "whistle") }
	elseif whistleLeft > 0 then
		whistleButton = { text = string.format("Перезарядка\n%dс", whistleLeft), enabled = false }
	else
		whistleButton = {
			text = "Свистнуть\n[Q]", color = Colors.blue,
			callback = function()
				Remotes.Whistle:FireServer()
			end,
		}
	end
	actionRow(window.content, nextOrder(), whistle.name, Colors.text, whistle.desc, { whistleButton })

	header(window.content, nextOrder(), "Развитие")
	local expansionButton
	if data.expanded then
		expansionButton = { text = "Куплено", enabled = false }
	elseif data.money < Config.ExpansionRequirement then
		expansionButton = { text = "Нужно\n" .. money(Config.ExpansionRequirement), enabled = false }
	else
		expansionButton = { text = "Купить\n" .. money(Config.ExpansionRequirement), callback = buy("upgrade", "expansion") }
	end
	actionRow(window.content, nextOrder(), "Расширение", Colors.text,
		"+6 лунок на грядке и место для питомца. Открывается, когда накопишь " .. money(Config.ExpansionRequirement) .. ".",
		{ expansionButton })

	header(window.content, nextOrder(), "Питомцы")
	for _, id in GameData.PetOrder do
		local pet = GameData.Pets[id]
		local desc = string.format("Сам ловит твой сбежавший урожай в %d шагах раз в %d секунд.", Config.PetRadius, Config.PetCooldown)
		if pet.bonus > 0 then
			desc ..= string.format(" Цены продажи +%d%%.", math.floor(pet.bonus * 100 + 0.5))
		end
		local button
		if not data.expanded then
			button = { text = "Нужно\n«Расширение»", enabled = false }
		elseif data.pet == id then
			button = { text = "Выбран", enabled = false }
		elseif data.pets[id] then
			button = {
				text = "Выбрать", color = Colors.blue,
				callback = function()
					Remotes.EquipPet:FireServer(id)
				end,
			}
		else
			button = { text = "Купить\n" .. money(pet.price), enabled = data.money >= pet.price, callback = buy("pet", id) }
		end
		actionRow(window.content, nextOrder(), pet.name, pet.color, desc, { button })
	end

	header(window.content, nextOrder(), "Перерождение")
	local armed = os.clock() - rebirthArmedAt < 5
	local rebirthButton
	if data.money < Config.RebirthRequirement then
		rebirthButton = { text = "Нужно\n" .. money(Config.RebirthRequirement), enabled = false }
	else
		rebirthButton = {
			text = armed and "Точно?\nНажми ещё раз" or "Переродиться", color = armed and Colors.red or Colors.accent,
			callback = function()
				if os.clock() - rebirthArmedAt < 5 then
					rebirthArmedAt = 0
					Remotes.Rebirth:FireServer()
				else
					rebirthArmedAt = os.clock()
					renderUpgrades()
				end
			end,
		}
	end
	actionRow(window.content, nextOrder(),
		string.format("Перерождение (сейчас: %d, бонус +%d%%)", data.rebirths, math.floor(data.rebirths * Config.RebirthBonus * 100 + 0.5)),
		Colors.accent,
		"Сбрасывает деньги, семена и урожай. Взамен: навсегда +25% к ценам продажи и «Золотое Семя» в магазине. Улучшения и питомцы остаются.",
		{ rebirthButton })
end

-- ---------------------------------------------------------------- init
function Windows.init()
	local gui = script.Parent

	local shop = UIKit.window(gui, "Магазин семян", 0, Windows.close) :: any
	shop.render = renderShop
	windows.shop = shop

	local inventory = UIKit.window(gui, "Инвентарь", 66, Windows.close) :: any
	inventory.render = renderInventory
	inventory.totalLabel = UIKit.label({
		Text = "", TextSize = 15, ZIndex = 12,
		Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -230, 1, 0), Parent = inventory.footer,
	})
	inventory.sellButton = UIKit.button("Продать Урожай", Colors.green, function()
		Remotes.Sell:FireServer()
	end, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(200, 48), TextSize = 17, ZIndex = 12, Parent = inventory.footer,
	})
	windows.inventory = inventory

	local upgrades = UIKit.window(gui, "Улучшения", 0, Windows.close) :: any
	upgrades.render = renderUpgrades
	windows.upgrades = upgrades

	State.changed:Connect(function()
		if current then
			windows[current].render()
		end
	end)
	-- ownership tags and the whistle cooldown tick down while a window is open
	task.spawn(function()
		while true do
			task.wait(1)
			if current == "inventory" or current == "upgrades" then
				windows[current].render()
			end
		end
	end)
end

return Windows
