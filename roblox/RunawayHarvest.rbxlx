	cat = { name = "Кот Мурзик", price = 150000, bonus = 0.10, color = Color3.fromRGB(240, 150, 60) },
	fox = { name = "Лиса Алиса", price = 400000, bonus = 0.25, color = Color3.fromRGB(232, 96, 40) },
}

-- ---------------------------------------------------------------- events
