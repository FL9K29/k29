		color = Color3.fromRGB(110, 190, 255), speed = 16, scale = 1,
	},
	flying = {
		nameM = "Летающий", nameF = "Летающая", multiplier = 15, weight = 12,
		color = Color3.fromRGB(200, 160, 255), speed = 17, scale = 1, canFly = true,
