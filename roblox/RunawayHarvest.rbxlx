		head = { shape = "Block", size = Vector3.new(1.2, 2.2, 1.2), color = Color3.fromRGB(245, 140, 40) },
		bodyColor = Color3.fromRGB(230, 120, 30), leafColor = Color3.fromRGB(80, 180, 70),
	},
	potato = {
		name = "Картошка", crop = "Картошка", gender = "f", rarity = "common",
