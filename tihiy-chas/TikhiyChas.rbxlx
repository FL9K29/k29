	TvOn = "Телевизор шумит ещё %dс — Родитель хуже слышит",
	Team = "Команда",
	StatusNames = {
		playing = "крадётся", hidden = "спрятался", caught = "пойман",
		stunned = "в кровати", sleeping = "спит", lobby = "в подъезде",
	},
	Done = "готово!",

	-- buttons
	BtnCrouch = "Красться",
