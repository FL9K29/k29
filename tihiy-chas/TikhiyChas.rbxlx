  <Item class="ServerScriptService" referent="20">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="21">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main — server entry point. Loads every system module in dependency order.
	Each system is a ModuleScript under Systems and exposes init().
]]

local Systems = script.Parent:WaitForChild("Systems")

local ORDER = {
	"World", -- map references, prompts, signs
	"PlayerData", -- Звёздочки, skins, upgrades, wins; DataStore
	"Session", -- per-round state of every player
	"StealthService", -- crouch, footstep noise, speed checks, stun timer
	"HideService", -- шкафы, под кроватью, за шторкой
	"NpcBrain", -- Родитель: patrol, senses, chase, carry
	"SnackService", -- pickup, delivery, going to bed
	"InteractService", -- throwables, TV, bathroom tap
	"EventService", -- кот, сон на диване, свет мигнул
	"ShopService", -- пижамы and upgrades
	"RoundManager", -- lobby → countdown → round → results
}

for _, name in ORDER do
	local module = require(Systems:WaitForChild(name)) :: any
	if module.init then
		module.init()
	end
end

print("[Тихий Час] сервер запущен")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="22">
      <Properties>
        <string name="Name">Systems</string>
      </Properties>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">AntiExploit</string>
          <string name="Source"><![CDATA[--[[
	AntiExploit — rate limits, argument validation and distance checks for every remote.
	All remotes are connected through AntiExploit.connect so nothing reaches game logic unchecked.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local AntiExploit = {}

local buckets = {} -- [player] = { [key] = { tokens, last } }
local violations = {} -- [player] = { count, windowStart }

local VIOLATION_WINDOW = 10
local VIOLATION_LIMIT = 150

local function flag(player: Player)
	local now = os.clock()
	local v = violations[player]
	if not v or now - v.windowStart > VIOLATION_WINDOW then
		v = { count = 0, windowStart = now }
		violations[player] = v
	end
	v.count += 1
	if v.count > VIOLATION_LIMIT then
		player:Kick(Config.Text.TooManyRequests)
	end
end

-- Token bucket: `rate` calls per second on average, `burst` at once.
function AntiExploit.allow(player: Player, key: string, rate: number, burst: number): boolean
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local now = os.clock()
	local bucket = playerBuckets[key]
	if not bucket then
		bucket = { tokens = burst, last = now }
		playerBuckets[key] = bucket
	end
	bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.last) * rate)
	bucket.last = now
	if bucket.tokens < 1 then
		flag(player)
		return false
	end
	bucket.tokens -= 1
	return true
end

function AntiExploit.connect(remote: RemoteEvent, rate: number, burst: number, handler: (Player, ...any) -> ())
	remote.OnServerEvent:Connect(function(player, ...)
		if not AntiExploit.allow(player, remote.Name, rate, burst) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[AntiExploit] %s от %s: %s", remote.Name, player.Name, tostring(err)))
		end
	end)
end

function AntiExploit.isInt(value: any, min: number, max: number): boolean
	return type(value) == "number" and value == value and value % 1 == 0 and value >= min and value <= max
end

function AntiExploit.isId(value: any, dictionary: { [string]: any }): boolean
	return type(value) == "string" and dictionary[value] ~= nil
end

-- HumanoidRootPart of a living character, or nil.
function AntiExploit.getRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function AntiExploit.distanceOk(player: Player, position: Vector3, maxDistance: number): boolean
	local root = AntiExploit.getRoot(player)
	return root ~= nil and (root.Position - position).Magnitude <= maxDistance
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
	violations[player] = nil
end)

return AntiExploit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	EventService — random events during a round, announced with a banner:
	  cat     «Кот пробежал!» — noise in the corridor, Родитель goes to check it
	  sleep   «Родитель уснул на диване» — 20 s without vision (running nearby may wake him)
	  flicker «Свет мигнул» — lamps off for 10 s, his flashlight only reaches 12 studs
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Noise = require(script.Parent.Noise)
local NpcBrain = require(script.Parent.NpcBrain)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes

local EventService = {}
local token = 0 -- changes whenever the round starts or stops; old loops then exit
local rng = Random.new()
local lampsOn = true

local function announce(id: string)
	local event = Config.Events[id]
	Remotes.Banner:FireAllClients(event.name, event.desc)
end

local function setLamps(on: boolean)
	lampsOn = on
	for _, lamp in World.lamps do
		lamp.light.Enabled = on
		lamp.part.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
	end
end

local function runCat()
	announce("cat")
	local from = World.nodes.CorridorW
	local to = World.nodes.CorridorE
	Remotes.Effect:FireAllClients("cat", from, to)
	local centre = World.nodes.CorridorC
	Noise.emit(centre, Config.Noise.Cat, "cat")
	NpcBrain.lure(centre)
end

local function runFlicker(myToken: number)
	announce("flicker")
	setLamps(false)
	NpcBrain.setVisionRange(Config.Parent.FlickerVisionRange)
	task.wait(Config.Events.flicker.duration)
	-- a newer round may have started meanwhile; it restores the lamps itself
	if token == myToken then
		setLamps(true)
		NpcBrain.setVisionRange(nil)
	end
end

local function run(id: string, myToken: number)
	if id == "cat" then
		runCat()
	elseif id == "sleep" then
		local started = NpcBrain.goSleep(Config.Events.sleep.duration, function()
			if token == myToken then
				announce("sleep")
			end
		end)
		if not started then
			runCat() -- he is busy chasing somebody: the cat comes instead
		end
	elseif id == "flicker" then
		runFlicker(myToken)
	end
end

function EventService.start()
	token += 1
	local myToken = token
	task.spawn(function()
		local last = nil
		while token == myToken do
			task.wait(rng:NextInteger(Config.Round.EventMinDelay, Config.Round.EventMaxDelay))
			if token ~= myToken then
				break
			end
			local id
			repeat
				id = Config.EventOrder[rng:NextInteger(1, #Config.EventOrder)]
			until id ~= last
			last = id
			run(id, myToken)
		end
	end)
end

function EventService.stop()
	token += 1
	if not lampsOn then
		setLamps(true)
	end
	NpcBrain.setVisionRange(nil)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">HideService</string>
          <string name="Source"><![CDATA[--[[
	HideService — hiding spots: 2 шкафа, 3 места «под кроватью» and the bath curtain.
	A hidden player is invisible to Родитель unless he was watching when they climbed in
	(HideService.watchCheck is provided by NpcBrain).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local AntiExploit = require(script.Parent.AntiExploit)
local PlayerData = require(script.Parent.PlayerData)
local Session = require(script.Parent.Session)
local StealthService = require(script.Parent.StealthService)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Text = Config.Text

local HideService = {}

-- Replaced by NpcBrain: returns true if Родитель saw the player enter the spot.
HideService.watchCheck = function(_s): boolean
	return false
end

-- Takes the player out of the spot. toPlaying = false when Родитель is pulling them out.
function HideService.release(s, toPlaying: boolean)
	local spot = s.spot
	if not spot then
		return
	end
	spot.occupant = nil
	s.spot = nil
	s.spotSeen = false
	local character = s.player.Character
	if character then
		World.unfreeze(character, spot.exit)
	end
	if toPlaying then
		s.status = "playing"
	end
	StealthService.grace(s)
	Session.sync(s)
end

local function onHide(player: Player, spotId: any)
	local s = Session.get(player)
	if not s then
		return
	end
	if s.status == "hidden" then
		HideService.release(s, true)
		Remotes.Effect:FireClient(player, "sound", "hide")
		return
	end
	if s.status ~= "playing" or type(spotId) ~= "string" then
		return
	end
	local spot = World.spots[spotId]
	local character = player.Character
	if not spot or not character then
		return
	end
	if spot.occupant then
		PlayerData.notify(player, Text.SpotBusy, "bad")
		return
	end
	if not AntiExploit.distanceOk(player, spot.part.Position, Config.Player.InteractDistance) then
		return
	end

	local seen = HideService.watchCheck(s)
	spot.occupant = s
	s.spot = spot
	s.spotSeen = seen
	s.status = "hidden"
	s.pickup = nil
	World.freeze(character, World.spotCFrame(spot))
	Session.sync(s)
	Remotes.Effect:FireClient(player, "sound", "hide")
	PlayerData.notify(player, seen and Text.HiddenSeen or Text.Hidden, seen and "bad" or "good")
end

function HideService.init()
	AntiExploit.connect(Remotes.Hide, 2, 4, onHide)
end

return HideService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">InteractService</string>
          <string name="Source"><![CDATA[--[[
	InteractService — things players use to manage noise:
	  * throwable items (тапки, мячик): pick up, throw, the landing lures Родитель
	  * the TV: 30 seconds during which he hears twice as badly
	  * the bathroom tap: a noisy distraction
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local AntiExploit = require(script.Parent.AntiExploit)
local Noise = require(script.Parent.Noise)
local PlayerData = require(script.Parent.PlayerData)
local Session = require(script.Parent.Session)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Text = Config.Text

local STORAGE = CFrame.new(0, -200, 0) -- where a held item waits, out of sight
local RESPAWN_TIME = 25
local THROW_SPEED = 60

local InteractService = {}
local items: { [string]: any } = {} -- [itemId] = { id, kind, name, part, prompt, home, state, token, holder }
local tvToken = 0
local tvCooldownUntil = 0
local tapCooldownUntil = 0

-- ---------------------------------------------------------------- throwables
local function sendHome(item)
	item.token += 1
	item.state = "home"
	item.holder = nil
	item.part.Anchored = true
	item.part.AssemblyLinearVelocity = Vector3.zero
	item.part.AssemblyAngularVelocity = Vector3.zero
	item.part.CFrame = item.home
	item.prompt.Enabled = true
end

local function onGrab(player: Player, itemId: any)
	local s = Session.get(player)
	if not s or s.status ~= "playing" or type(itemId) ~= "string" then
		return
	end
	local item = items[itemId]
	if not item or (item.state ~= "home" and item.state ~= "landed") then
		return
	end
	if s.holding then
		PlayerData.notify(player, Text.HandsItemBusy, "bad")
		return
	end
	if not AntiExploit.distanceOk(player, item.part.Position, Config.Player.InteractDistance) then
		return
	end
	item.token += 1
	item.state = "held"
	item.part.Anchored = true
	item.part.CFrame = STORAGE
	item.prompt.Enabled = false
	item.holder = player
	s.holding = item
	Session.sync(s)
	Remotes.Effect:FireClient(player, "sound", "pickup")
	PlayerData.notify(player, string.format(Text.ItemGrabbed, item.name), "info")
end

local function onThrow(player: Player, direction: any)
	local s = Session.get(player)
	local root = AntiExploit.getRoot(player)
	if not s or not root or s.status ~= "playing" or not s.holding then
		return
	end
	if typeof(direction) ~= "Vector3" or direction ~= direction or direction.Magnitude < 0.1 or direction.Magnitude > 10 then
		return
	end
	local item = s.holding
	s.holding = nil
	Session.sync(s)

	-- only the direction comes from the client; origin and speed are decided here
	local aim = direction.Unit
	aim = Vector3.new(aim.X, math.clamp(aim.Y, -0.2, 0.5), aim.Z).Unit
	local flatAim = Vector3.new(aim.X, 0, aim.Z)
	if flatAim.Magnitude < 0.05 then
		flatAim = root.CFrame.LookVector
	end
	local part = item.part
	item.token += 1
	item.state = "flying"
	local token = item.token
	part.CFrame = CFrame.new(root.Position + Vector3.new(0, 2, 0) + flatAim.Unit * 2.5)
	part.Anchored = false
	part:SetNetworkOwner(nil)
	part.AssemblyLinearVelocity = aim * THROW_SPEED + Vector3.new(0, 14, 0)

	local connection: RBXScriptConnection? = nil
	local function land()
		if item.token ~= token or item.state ~= "flying" then
			return
		end
		if connection then
			connection:Disconnect()
		end
		item.state = "landed"
		item.prompt.Enabled = true
		Noise.emit(part.Position, Config.Noise.Throw, "throw")
		Remotes.Effect:FireAllClients("thud", part.Position)
		task.delay(RESPAWN_TIME, function()
			if item.token == token and (item.state :: string) == "landed" then
				sendHome(item)
			end
		end)
	end
	local character = player.Character
	connection = part.Touched:Connect(function(hit)
		if hit.CanCollide and not (character and hit:IsDescendantOf(character)) then
			land()
		end
	end)
	task.delay(2.5, land)
end

-- ---------------------------------------------------------------- TV and tap
local function stopTv()
	tvToken += 1
	Noise.tvUntil = 0
	workspace:SetAttribute("TVUntil", 0)
	local tv = World.tv
	if tv then
		tv.Color = Color3.fromRGB(16, 16, 20)
		tv.Material = Enum.Material.SmoothPlastic
		local light = tv:FindFirstChildOfClass("PointLight")
		if light then
			light.Brightness = 0
		end
	end
end

local function startTv()
	local tv = World.tv
	if not tv then
		return
	end
	tvToken += 1
	local token = tvToken
	local now = os.clock()
	Noise.tvUntil = now + Config.Noise.TvDuration
	tvCooldownUntil = now + Config.Noise.TvDuration + Config.Noise.TvCooldown
	workspace:SetAttribute("TVUntil", workspace:GetServerTimeNow() + Config.Noise.TvDuration)
	local light = tv:FindFirstChildOfClass("PointLight")
	tv.Material = Enum.Material.Neon
	task.spawn(function()
		local rng = Random.new()
		while tvToken == token and os.clock() < Noise.tvUntil do
			tv.Color = Color3.fromHSV(rng:NextNumber(0.5, 0.7), 0.5, rng:NextNumber(0.6, 1))
			if light then
				light.Brightness = rng:NextNumber(0.8, 1.6)
			end
			task.wait(0.45)
		end
		if tvToken == token then
			stopTv()
		end
	end)
end

local function onUse(player: Player, objectId: any)
	local s = Session.get(player)
	if not s or s.status ~= "playing" then
		return
	end
	local now = os.clock()
	if objectId == "tv" and World.tv then
		if not AntiExploit.distanceOk(player, World.tv.Position, Config.Player.InteractDistance) then
			return
		end
		if now < Noise.tvUntil then
			PlayerData.notify(player, Text.TvAlready, "info")
		elseif now < tvCooldownUntil then
			PlayerData.notify(player, Text.TvCooldown, "bad")
		else
			startTv()
			Remotes.Notify:FireAllClients(Text.TvStarted, "good")
		end
	elseif objectId == "tap" and World.tap then
		local tap = World.tap
		if not AntiExploit.distanceOk(player, tap.Position, Config.Player.InteractDistance) then
			return
		end
		if now < tapCooldownUntil then
			PlayerData.notify(player, Text.TapCooldown, "bad")
			return
		end
		tapCooldownUntil = now + Config.Noise.TapCooldown
		Remotes.Notify:FireAllClients(Text.TapStarted, "info")
		task.spawn(function()
			for _ = 1, Config.Noise.TapDuration do
				if Session.phase ~= "round" then
					break
				end
				Noise.emit(tap.Position, Config.Noise.Tap, "tap")
				Remotes.Effect:FireAllClients("tap", tap.Position)
				task.wait(1)
			end
		end)
	end
end

-- Called by RoundManager between rounds.
function InteractService.resetAll()
	for _, item in items do
		sendHome(item)
	end
	for _, s in Session.players do
		s.holding = nil
	end
	stopTv()
	tvCooldownUntil = 0
	tapCooldownUntil = 0
end

function InteractService.init()
	for itemId, part in World.itemParts do
		local kind = string.match(itemId, "^Item_(%a+)%d*$")
		local info = kind and Config.Items[kind]
		if kind and info then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "ItemPrompt"
			prompt.ObjectText = info.name
			prompt.ActionText = Text.PromptGrab
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.MaxActivationDistance = 8
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("ItemId", itemId)
			prompt.Parent = part
			items[itemId] = {
				id = itemId, kind = kind, name = info.name, part = part, prompt = prompt,
				home = part.CFrame, state = "home", token = 0,
			}
		end
	end
	-- an item must not vanish with a player who leaves while holding it
	Players.PlayerRemoving:Connect(function(player)
		for _, item in items do
			if item.state == "held" and item.holder == player then
				sendHome(item)
			end
		end
	end)
	AntiExploit.connect(Remotes.GrabItem, 2, 4, onGrab)
	AntiExploit.connect(Remotes.Throw, 2, 4, onThrow)
	AntiExploit.connect(Remotes.UseObject, 2, 4, onUse)
end

return InteractService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Navigation</string>
          <string name="Source"><![CDATA[--[[
	Navigation — routes for Родитель.
	First choice is PathfindingService (navmesh). If it fails or finds no path, the hand-made
	waypoint graph (Config.Graph over Workspace.Map.Waypoints) is used instead.
]]

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local World = require(script.Parent.World)

local Navigation = {}

local AGENT = { AgentRadius = 2, AgentHeight = 6, AgentCanJump = false, WaypointSpacing = 6 }

local neighbours = nil :: { [string]: { string } }?
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Include

local function buildGraph()
	local graph = {}
	for name in World.nodes do
		graph[name] = {}
	end
	for _, edge in Config.Graph do
		local a, b = edge[1], edge[2]
		if graph[a] and graph[b] then
			table.insert(graph[a], b)
			table.insert(graph[b], a)
		end
	end
	wallParams.FilterDescendantsInstances = { World.map:WaitForChild("Apartment"):WaitForChild("Walls") }
	return graph
end

local function wallBetween(a: Vector3, b: Vector3): boolean
	local from = Vector3.new(a.X, 3, a.Z)
	local to = Vector3.new(b.X, 3, b.Z)
	return workspace:Raycast(from, to - from, wallParams) ~= nil
end

-- Closest waypoint that is not behind a wall (or simply the closest one).
local function nearestNode(position: Vector3): string?
	local best, bestDistance = nil, math.huge
	local fallback, fallbackDistance = nil, math.huge
	for name, nodePosition in World.nodes do
		local distance = (nodePosition - position).Magnitude
		if distance < fallbackDistance then
			fallback, fallbackDistance = name, distance
		end
		if distance < bestDistance and not wallBetween(position, nodePosition) then
			best, bestDistance = name, distance
		end
	end
	return best or fallback
end

-- Dijkstra over the waypoint graph.
function Navigation.graphPath(from: Vector3, to: Vector3): { Vector3 }
	if not neighbours then
		neighbours = buildGraph()
	end
	local graph = neighbours :: { [string]: { string } }
	local start, goal = nearestNode(from), nearestNode(to)
	local points = {}
	if start and goal then
		local distances = { [start] = 0 }
		local previous = {}
		local open = { [start] = true }
		while next(open) do
			local current, currentDistance = nil, math.huge
			for name in open do
				if distances[name] < currentDistance then
					current, currentDistance = name, distances[name]
				end
			end
			if not current or current == goal then
				break
			end
			open[current] = nil
			for _, neighbour in graph[current] do
				local distance = currentDistance + (World.nodes[neighbour] - World.nodes[current]).Magnitude
				if distance < (distances[neighbour] or math.huge) then
					distances[neighbour] = distance
					previous[neighbour] = current
					open[neighbour] = true
				end
			end
		end
		local chain = {}
		local cursor = goal
		while cursor do
			table.insert(chain, 1, World.nodes[cursor])
			cursor = previous[cursor]
		end
		if previous[goal] or goal == start then
			points = chain
		end
	end
	table.insert(points, Vector3.new(to.X, 0, to.Z))
	return points
end

-- Returns a list of floor points from `from` to `to`. May yield.
function Navigation.compute(from: Vector3, to: Vector3): ({ Vector3 }, string)
	local path = PathfindingService:CreatePath(AGENT)
	local ok = pcall(function()
		path:ComputeAsync(Vector3.new(from.X, 1, from.Z), Vector3.new(to.X, 1, to.Z))
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		local points = {}
		for _, waypoint in path:GetWaypoints() do
			table.insert(points, Vector3.new(waypoint.Position.X, 0, waypoint.Position.Z))
		end
		if #points > 0 then
			return points, "navmesh"
		end
	end
	return Navigation.graphPath(from, to), "graph"
end

return Navigation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Noise</string>
          <string name="Source"><![CDATA[--[[
	Noise — a tiny message bus for sounds Родитель can hear.
	Anything noisy calls Noise.emit(position, radius, kind); NpcBrain listens.
	While the TV plays, every radius is halved.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Noise = {}
Noise.tvUntil = 0 -- os.clock() time until which the TV masks noise
local listeners = {}

function Noise.factor(): number
	return os.clock() < Noise.tvUntil and Config.Noise.TvFactor or 1
end

-- kind: "step" | "throw" | "tap" | "cat"
function Noise.emit(position: Vector3, radius: number, kind: string)
	local effective = radius * Noise.factor()
	for _, listener in listeners do
		listener(position, effective, kind)
	end
end

function Noise.listen(listener: (Vector3, number, string) -> ())
	table.insert(listeners, listener)
end

return Noise
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">NpcBrain</string>
          <string name="Source"><![CDATA[--[[
	NpcBrain — «Родитель», the threat. Everything here runs on the server.

	States:
	  idle        no round is running
	  wait        short grace period at the start of a round
	  patrol      walks Config.PatrolRoute, stops and looks around at each waypoint
	  investigate goes to a noise, looks around, returns to patrol
	  alert       saw a player: 1 second «!» reaction
	  chase       runs after the target; gives up 5 s after losing sight
	  grab/carry  «Ага! Спать!» — carries the caught player to their bed
	  gotoSleep   walking to the sofa (event)
	  sleep       asleep on the sofa: no vision, running nearby may wake him

	He is kinematic: an invisible anchored root part moved along paths from Navigation
	(PathfindingService with the waypoint graph as fallback). Clients draw the visible body.
	Vision is a server-side cone check plus a raycast; hearing comes from the Noise bus.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local HideService = require(script.Parent.HideService)
local Navigation = require(script.Parent.Navigation)
local Noise = require(script.Parent.Noise)
local PlayerData = require(script.Parent.PlayerData)
local Session = require(script.Parent.Session)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Text = Config.Text
local P = Config.Parent

local ROOT_HEIGHT = 3
local EYE_HEIGHT = 5
local TURN_RATE = 7 -- radians per second
local COS_HALF_CONE = math.cos(math.rad(P.VisionAngle / 2))
-- the caught kid is carried lying across his arms
local CARRY_OFFSET = CFrame.new(0, 0.6, -2.2) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(math.pi / 2, 0, 0)

local NpcBrain = {}
local rng = Random.new()
local root: Part
local rayParams = RaycastParams.new()

local npc = {
	state = "idle",
	emote = "",
	pos = Vector3.zero, -- floor position
	facing = Vector3.new(-1, 0, 0),
	path = nil :: { Vector3 }?,
	pathIndex = 1,
	request = 0, -- increases with every path request; stale results are dropped
	destination = nil :: Vector3?,
	visionRange = P.VisionRange,
	shownRange = -1,
	seen = nil :: any, -- player session currently inside the vision cone
	nextSense = 0,
	target = nil :: any,
	lastSeenAt = 0,
	lastKnown = Vector3.zero,
	nextRepath = 0,
	stateUntil = 0,
	patrolIndex = 1,
	scanning = false,
	scanStart = 0,
	scanUntil = 0,
	scanBase = 0,
	carried = nil :: any,
	weld = nil :: Weld?,
	carryDeadline = 0,
	sleepDuration = 0,
	sleepUntil = 0,
	nextSnoreCheck = 0,
	onAsleep = nil :: (() -> ())?,
}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function setEmote(emote: string)
	if npc.emote ~= emote then
		npc.emote = emote
		root:SetAttribute("Emote", emote)
	end
end

local function setState(state: string, emote: string?)
	npc.state = state
	root:SetAttribute("State", state)
	setEmote(emote or "")
end

local function playerRoot(s): BasePart?
	local character = s.player.Character
	local part = character and character:FindFirstChild("HumanoidRootPart")
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

-- ---------------------------------------------------------------- movement
local function cancelPath()
	npc.request += 1
	npc.path = nil
	npc.destination = nil
end

-- Requests a path; the old one stays in use until the new one is ready.
local function goTo(destination: Vector3)
	npc.request += 1
	npc.destination = destination
	local request = npc.request
	task.spawn(function()
		local points = Navigation.compute(npc.pos, destination)
		if request ~= npc.request then
			return
		end
		-- skip points we are already standing on, so he never steps backwards
		local index = 1
		while index < #points and (points[index] - npc.pos).Magnitude < 2 do
			index += 1
		end
		npc.path = points
		npc.pathIndex = index
	end)
end

local function face(direction: Vector3, dt: number)
	if direction.Magnitude < 0.01 then
		return
	end
	local current = math.atan2(npc.facing.Z, npc.facing.X)
	local target = math.atan2(direction.Z, direction.X)
	local difference = (target - current + math.pi) % (2 * math.pi) - math.pi
	local angle = current + math.clamp(difference, -TURN_RATE * dt, TURN_RATE * dt)
	npc.facing = Vector3.new(math.cos(angle), 0, math.sin(angle))
end

-- Walks along the current path. Returns true once the end is reached.
local function follow(dt: number, speed: number): boolean
	local path = npc.path
	if not path then
		return false
	end
	local budget = speed * dt
	while budget > 0 and npc.pathIndex <= #path do
		local delta = flat(path[npc.pathIndex] - npc.pos)
		local distance = delta.Magnitude
		if distance <= budget then
			npc.pos = flat(path[npc.pathIndex])
			budget -= distance
			npc.pathIndex += 1
		else
			local direction = delta / distance
			npc.pos += direction * budget
			face(direction, dt)
			budget = 0
		end
	end
	return npc.pathIndex > #path
end

local function startScan(now: number, seconds: number)
	npc.scanning = true
	npc.scanStart = now
	npc.scanUntil = now + seconds
	npc.scanBase = math.atan2(npc.facing.Z, npc.facing.X)
end

-- Looks left and right. Returns true while still scanning.
local function scan(now: number): boolean
	if now < npc.scanUntil then
		local angle = npc.scanBase + math.sin((now - npc.scanStart) * 2.2) * 1.1
		npc.facing = Vector3.new(math.cos(angle), 0, math.sin(angle))
		return true
	end
	return false
end

-- ---------------------------------------------------------------- senses
-- Server-side vision: range, 70° cone, then a raycast that walls and furniture block.
local function canSee(s, range: number, ignoreCone: boolean): boolean
	local part = playerRoot(s)
	if not part then
		return false
	end
	local eye = npc.pos + Vector3.new(0, EYE_HEIGHT, 0)
	local offset = part.Position - eye
	if offset.Magnitude > range then
		return false
	end
	local flatOffset = flat(offset)
	if not ignoreCone and flatOffset.Magnitude > P.TouchRange and flatOffset.Unit:Dot(npc.facing) < COS_HALF_CONE then
		return false
	end
	local hit = workspace:Raycast(eye, offset, rayParams)
	return hit == nil or hit.Instance:IsDescendantOf(part.Parent :: Instance)
end

local function sense(now: number)
	if now < npc.nextSense then
		return
	end
	npc.nextSense = now + 0.1
	local best, bestDistance = nil, math.huge
	for _, s in Session.players do
		if s.status == "playing" and canSee(s, npc.visionRange, false) then
			local part = playerRoot(s)
			local distance = part and (flat(part.Position) - npc.pos).Magnitude or math.huge
			if distance < bestDistance then
				best, bestDistance = s, distance
			end
		end
	end
	npc.seen = best
end

-- ---------------------------------------------------------------- state changes
local function endChase()
	local target = npc.target
	if target then
		target.chased = false
		if Session.players[target.player] then
			Session.sync(target)
		end
	end
	npc.target = nil
end

local function resumePatrol()
	endChase()
	-- continue from the closest waypoint of the route
	local best, bestDistance = 1, math.huge
	for index, name in Config.PatrolRoute do
		local node = World.nodes[name]
		if node and (node - npc.pos).Magnitude < bestDistance then
			best, bestDistance = index, (node - npc.pos).Magnitude
		end
	end
	npc.patrolIndex = best
	npc.scanning = false
	npc.scanUntil = 0
	setState("patrol")
	goTo(World.nodes[Config.PatrolRoute[best]])
end

local function investigate(position: Vector3)
	endChase()
	npc.scanning = false
	npc.scanUntil = 0
	setState("investigate", Text.EmoteSearch)
	goTo(flat(position))
end

local function startAlert(s, now: number)
	local part = playerRoot(s)
	npc.target = s
	npc.lastSeenAt = now
	npc.lastKnown = part and flat(part.Position) or npc.pos
	npc.stateUntil = now + P.ReactionTime
	cancelPath()
	setState("alert", Text.EmoteAlert)
	s.chased = true
	Session.sync(s)
	Remotes.Effect:FireClient(s.player, "spotted")
end

local function catch(s, now: number)
	if s.status == "hidden" then
		HideService.release(s, false)
	end
	s.status = "caught"
	s.chased = false
	s.crouched = false
	s.pickup = nil
	if #s.carried > 0 then
		local lost = table.remove(s.carried, rng:NextInteger(1, #s.carried)) :: string
		PlayerData.notify(s.player, string.format(Text.LostSnack, Config.Snacks[lost].name), "bad")
	end
	Session.sync(s)
	PlayerData.notify(s.player, Text.Caught, "bad")
	Remotes.Effect:FireClient(s.player, "caught")

	-- weld the kid to the (anchored) root: the character now moves with Родитель
	local part = playerRoot(s)
	local character = s.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if part then
		if humanoid then
			humanoid.PlatformStand = true
		end
		part.Anchored = false
		local weld = Instance.new("Weld")
		weld.Name = "CarryWeld"
		weld.Part0 = root
		weld.Part1 = part
		weld.C0 = CARRY_OFFSET
		weld.Parent = root
		npc.weld = weld
	end
	npc.carried = s
	npc.target = nil
	npc.stateUntil = now + 1.4
	cancelPath()
	setState("grab", Text.EmoteCatch)
end

local function finishCarry(now: number)
	local s = npc.carried
	npc.carried = nil
	if npc.weld then
		npc.weld:Destroy()
		npc.weld = nil
	end
	if s and Session.players[s.player] and s.status == "caught" then
		local character = s.player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.PlatformStand = false
		end
		if character then
			World.layInBed(character, s.bed)
		end
		s.status = "stunned"
		s.stunnedUntil = now + Config.Player.StunTime
		s.stunnedUntilServer = workspace:GetServerTimeNow() + Config.Player.StunTime
		Session.sync(s)
		Remotes.Effect:FireClient(s.player, "stunned")
	end
end

-- ---------------------------------------------------------------- per-state updates
local function updatePatrol(dt: number, now: number)
	if npc.seen then
		startAlert(npc.seen, now)
		return
	end
	if npc.scanning then
		if scan(now) then
			return
		end
		npc.scanning = false
		npc.patrolIndex = npc.patrolIndex % #Config.PatrolRoute + 1
		goTo(World.nodes[Config.PatrolRoute[npc.patrolIndex]])
		return
	end
	if follow(dt, P.PatrolSpeed) then
		startScan(now, rng:NextNumber(1.5, 3))
	end
end

local function updateInvestigate(dt: number, now: number)
	if npc.seen then
		startAlert(npc.seen, now)
		return
	end
	if npc.scanning then
		if not scan(now) then
			resumePatrol()
		end
		return
	end
	if follow(dt, P.InvestigateSpeed) then
		startScan(now, 3)
	end
end

local function updateAlert(dt: number, now: number)
	local target = npc.target
	local part = target and playerRoot(target)
	if part then
		face(flat(part.Position) - npc.pos, dt)
	end
	if now >= npc.stateUntil then
		if target and Session.players[target.player] and (target.status == "playing" or target.status == "hidden") then
			npc.nextRepath = 0
			setState("chase", Text.EmoteAlert)
		else
			resumePatrol()
		end
	end
end

local function updateChase(dt: number, now: number)
	local target = npc.target
	if not target or not Session.players[target.player] or (target.status ~= "playing" and target.status ~= "hidden") then
		resumePatrol()
		return
	end
	local part = playerRoot(target)
	if not part then
		resumePatrol()
		return
	end

	local goal = npc.lastKnown
	local visible = false
	if target.status == "hidden" then
		if target.spotSeen and target.spot then
			-- he watched you climb in: walks up and pulls you out
			goal = flat(target.spot.exit)
			npc.lastSeenAt = now
			if (goal - npc.pos).Magnitude <= P.CatchDistance + 1.5 then
				catch(target, now)
				return
			end
		end
	else
		visible = canSee(target, P.ChaseVisionRange, true)
		if visible then
			npc.lastSeenAt = now
			npc.lastKnown = flat(part.Position)
			goal = npc.lastKnown
		end
		local reach = (flat(part.Position) - npc.pos).Magnitude
		-- catch validation: close enough, on the same floor level, and actually in sight
		if reach <= P.CatchDistance and math.abs(part.Position.Y - ROOT_HEIGHT) < 7 and now - npc.lastSeenAt < 1 then
			catch(target, now)
			return
		end
	end

	if now - npc.lastSeenAt > P.LoseSightTime then
		resumePatrol()
		return
	end
	if now >= npc.nextRepath then
		npc.nextRepath = now + 0.35
		goTo(goal)
	end
	local direct = goal - npc.pos
	if visible and direct.Magnitude < 9 and direct.Magnitude > 0.05 then
		-- nothing between them: run straight at the player
		local direction = direct.Unit
		npc.pos += direction * math.min(direct.Magnitude, P.ChaseSpeed * dt)
		face(direction, dt)
	else
		follow(dt, P.ChaseSpeed)
	end
end

local function updateCarry(dt: number, now: number)
	local s = npc.carried
	local valid = s and Session.players[s.player] and s.status == "caught"
	if npc.state == "grab" then
		if not valid then
			finishCarry(now)
			resumePatrol()
		elseif now >= npc.stateUntil then
			npc.carryDeadline = now + 20
			setState("carry", Text.EmoteCatch)
			goTo(flat(World.beds[s.bed].standPosition))
		end
		return
	end
	if not valid or follow(dt, P.CarrySpeed) or now >= npc.carryDeadline then
		finishCarry(now)
		resumePatrol()
	end
end

local function updateSleep(dt: number, now: number)
	if npc.state == "gotoSleep" then
		if npc.seen then
			startAlert(npc.seen, now)
		elseif follow(dt, P.PatrolSpeed) then
			npc.facing = Vector3.new(-1, 0, 0) -- towards the TV
			npc.sleepUntil = now + npc.sleepDuration
			npc.nextSnoreCheck = now + 2
			setState("sleep", Text.EmoteSleep)
			if npc.onAsleep then
				npc.onAsleep()
			end
		end
		return
	end
	if now >= npc.sleepUntil then
		resumePatrol()
		return
	end
	-- snoring: every 2 seconds, somebody running nearby may wake him up
	if now >= npc.nextSnoreCheck then
		npc.nextSnoreCheck = now + 2
		for _, s in Session.players do
			local part = playerRoot(s)
			if part and s.status == "playing" and s.noiseRadius >= Config.Noise.Run
				and (flat(part.Position) - npc.pos).Magnitude <= P.SleepWakeRadius
				and rng:NextNumber() < P.SleepWakeChance then
				investigate(part.Position)
				return
			end
		end
	end
end

local function update(dt: number)
	local now = os.clock()
	local state = npc.state
	if state ~= "idle" then
		if state ~= "sleep" and state ~= "grab" and state ~= "carry" and state ~= "wait" then
			sense(now)
		else
			npc.seen = nil
		end
		if state == "wait" then
			if now >= npc.stateUntil then
				resumePatrol()
			end
		elseif state == "patrol" then
			updatePatrol(dt, now)
		elseif state == "investigate" then
			updateInvestigate(dt, now)
		elseif state == "alert" then
			updateAlert(dt, now)
		elseif state == "chase" then
			updateChase(dt, now)
		elseif state == "grab" or state == "carry" then
			updateCarry(dt, now)
		elseif state == "gotoSleep" or state == "sleep" then
			updateSleep(dt, now)
		end
	end

	local base = npc.pos + Vector3.new(0, ROOT_HEIGHT, 0)
	root.CFrame = CFrame.lookAt(base, base + npc.facing)
	local range = (npc.state == "sleep" or npc.state == "idle") and 0 or npc.visionRange
	if range ~= npc.shownRange then
		npc.shownRange = range
		root:SetAttribute("VisionRange", range)
	end
end

-- ---------------------------------------------------------------- public API
function NpcBrain.start()
	npc.pos = World.sofa
	npc.facing = Vector3.new(-1, 0, 0)
	npc.visionRange = P.VisionRange
	npc.seen = nil
	npc.target = nil
	npc.stateUntil = os.clock() + Config.Round.GraceTime
	cancelPath()
	setState("wait")
end

function NpcBrain.stop()
	if npc.carried then
		local s = npc.carried
		local character = s.player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.PlatformStand = false
		end
	end
	if npc.weld then
		npc.weld:Destroy()
		npc.weld = nil
	end
	npc.carried = nil
	endChase()
	cancelPath()
	npc.pos = World.sofa
	npc.facing = Vector3.new(-1, 0, 0)
	setState("idle")
end

-- Event «Свет мигнул»: nil restores the normal range.
function NpcBrain.setVisionRange(range: number?)
	npc.visionRange = range or P.VisionRange
end

-- Event «Кот пробежал!» and other scripted lures. Returns false if he is busy with a player.
function NpcBrain.lure(position: Vector3): boolean
	if npc.state == "patrol" or npc.state == "investigate" or npc.state == "gotoSleep" or npc.state == "sleep" then
		investigate(position)
		return true
	end
	return false
end

-- Event «Родитель уснул на диване». onAsleep fires when he actually sits down.
function NpcBrain.goSleep(duration: number, onAsleep: () -> ()): boolean
	if npc.state ~= "patrol" and npc.state ~= "investigate" then
		return false
	end
	npc.sleepDuration = duration
	npc.onAsleep = onAsleep
	npc.scanning = false
	setState("gotoSleep")
	goTo(World.sofa)
	return true
end

function NpcBrain.init()
	root = Instance.new("Part")
	root.Name = "ParentRoot"
	root.Size = Vector3.new(2, 6, 2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root:SetAttribute("State", "idle")
	root:SetAttribute("Emote", "")
	root:SetAttribute("VisionRange", 0)
	npc.pos = World.sofa
	root.CFrame = CFrame.new(npc.pos + Vector3.new(0, ROOT_HEIGHT, 0))
	root.Parent = World.npcFolder

	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { World.npcFolder, World.map:WaitForChild("Items") }

	-- Did he watch this player climb into a hiding spot?
	HideService.watchCheck = function(s): boolean
		local now = os.clock()
		if (npc.state == "chase" or npc.state == "alert") and npc.target == s and now - npc.lastSeenAt < 1 then
			return true
		end
		if (npc.state == "patrol" or npc.state == "investigate" or npc.state == "gotoSleep") and canSee(s, npc.visionRange, false) then
			startAlert(s, now)
			return true
		end
		return false
	end

	-- hearing
	Noise.listen(function(position, radius, kind)
		local state = npc.state
		if (flat(position) - npc.pos).Magnitude > radius then
			return
		end
		if state == "patrol" or state == "investigate" or state == "gotoSleep" then
			-- do not restart the search for every single footstep in the same place
			if state == "investigate" and npc.destination and (npc.destination - flat(position)).Magnitude < 4 then
				return
			end
			investigate(position)
		elseif state == "sleep" and kind ~= "step" then
			investigate(position) -- loud things wake him; footsteps go through the snore check
		end
	end)

	RunService.Heartbeat:Connect(update)
end

return NpcBrain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--[[
	PlayerData — the saved profile: Звёздочки, owned skins, equipped skin, upgrades, wins.
	The profile is mirrored into Player attributes (Stars, Wins, Skin, Skins, Upgrades) so the
	client UI can read it without extra remotes.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Remotes = ReplicatedStorage.Remotes
local Text = Config.Text

local STORE_NAME = "TikhiyChas_v1"
local KEY_PREFIX = "player_"
local AUTOSAVE_INTERVAL = 120

local PlayerData = {}
local profiles = {} -- [player] = profile
local loadedCallbacks = {}

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore недоступен: " .. tostring(result))
	end
end

local function defaultData()
	return { stars = 0, wins = 0, skins = { default = true }, skin = "default", upgrades = {} }
end

-- Never trust stored data blindly: rebuild it field by field.
local function sanitize(raw: any)
	local data = defaultData()
	if type(raw) ~= "table" then
		return data
	end
	local function int(value, max)
		if type(value) == "number" and value == value then
			return math.clamp(math.floor(value), 0, max)
		end
		return 0
	end
	data.stars = int(raw.stars, 1e9)
	data.wins = int(raw.wins, 1e9)
	if type(raw.skins) == "table" then
		for id, owned in raw.skins do
			if Config.Skins[id] and owned == true then
				data.skins[id] = true
			end
		end
	end
	if type(raw.upgrades) == "table" then
		for id, owned in raw.upgrades do
			if Config.Upgrades[id] and owned == true then
				data.upgrades[id] = true
			end
		end
	end
	if type(raw.skin) == "string" and data.skins[raw.skin] then
		data.skin = raw.skin
	end
	return data
end

local function keys(dictionary): string
	local list = {}
	for id in dictionary do
		table.insert(list, id)
	end
	table.sort(list)
	return table.concat(list, ",")
end

local function sync(player: Player, profile)
	local data = profile.data
	player:SetAttribute("Stars", data.stars)
	player:SetAttribute("Wins", data.wins)
	player:SetAttribute("Skin", data.skin)
	player:SetAttribute("Skins", keys(data.skins))
	player:SetAttribute("Upgrades", keys(data.upgrades))
	profile.starsStat.Value = data.stars
	profile.winsStat.Value = data.wins
end

local function save(player: Player, profile)
	if not store or not profile.canSave then
		return
	end
	local data = profile.data
	local payload = {
		version = 1, stars = data.stars, wins = data.wins,
		skins = table.clone(data.skins), skin = data.skin, upgrades = table.clone(data.upgrades),
	}
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(KEY_PREFIX .. player.UserId, function()
				return payload
			end)
		end)
		if ok then
			return
		end
		warn(string.format("[PlayerData] сохранение %s, попытка %d: %s", player.Name, attempt, tostring(err)))
		task.wait(1.5 * attempt)
	end
end

local function load(userId: number): (any, boolean)
	if not store then
		return nil, false
	end
	local attempts = RunService:IsStudio() and 1 or 3
	for attempt = 1, attempts do
		local ok, result = pcall(function()
			return store:GetAsync(KEY_PREFIX .. userId)
		end)
		if ok then
			return result, true
		end
		warn(string.format("[PlayerData] загрузка %d, попытка %d: %s", userId, attempt, tostring(result)))
		if attempt < attempts then
			task.wait(1.5)
		end
	end
	return nil, false
end

-- ---------------------------------------------------------------- public API
function PlayerData.get(player: Player)
	return profiles[player]
end

-- callback(player, profile) runs once the profile is ready (also for already loaded players).
function PlayerData.onLoaded(callback: (Player, any) -> ())
	table.insert(loadedCallbacks, callback)
	for player, profile in profiles do
		task.spawn(callback, player, profile)
	end
end

function PlayerData.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function PlayerData.has(player: Player, upgradeId: string): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.data.upgrades[upgradeId] == true
end

function PlayerData.addStars(player: Player, amount: number)
	local profile = profiles[player]
	if profile then
		profile.data.stars = math.clamp(profile.data.stars + amount, 0, 1e9)
		sync(player, profile)
	end
end

function PlayerData.spend(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or amount < 0 or profile.data.stars < amount then
		return false
	end
	profile.data.stars -= amount
	sync(player, profile)
	return true
end

function PlayerData.addWin(player: Player)
	local profile = profiles[player]
	if profile then
		profile.data.wins += 1
		sync(player, profile)
	end
end

function PlayerData.sync(player: Player)
	local profile = profiles[player]
	if profile then
		sync(player, profile)
	end
end

-- ---------------------------------------------------------------- lifecycle
local function onPlayerAdded(player: Player)
	if profiles[player] then
		return
	end
	local raw, loadedOk = load(player.UserId)
	if not player.Parent then
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local starsStat = Instance.new("IntValue")
	starsStat.Name = Text.LeaderStars
	starsStat.Parent = leaderstats
	local winsStat = Instance.new("IntValue")
	winsStat.Name = Text.LeaderWins
	winsStat.Parent = leaderstats

	local profile = {
		data = sanitize(raw),
		canSave = loadedOk, -- never overwrite a save that failed to load
		starsStat = starsStat,
		winsStat = winsStat,
		saved = false,
	}
	profiles[player] = profile
	sync(player, profile)
	leaderstats.Parent = player

	if not loadedOk then
		PlayerData.notify(player, Text.SaveUnavailable, "bad")
	end
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, profile)
	end
end

function PlayerData.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(function(player)
		local profile = profiles[player]
		if profile and not profile.saved then
			profile.saved = true
			save(player, profile)
		end
		profiles[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, profile in profiles do
				task.spawn(save, player, profile)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, profile in profiles do
			if not profile.saved then
				profile.saved = true
				pending += 1
				task.spawn(function()
					save(player, profile)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">RoundManager</string>
          <string name="Source"><![CDATA[--[[
	RoundManager — the game loop:
	  lobby («подъезд») → everybody presses «Готов» → 10 s lift countdown → round (6 minutes)
	  → results («Победа!» / «Вас поймали...») → back to the lobby.

	Win:  at least one player delivered all 5 snacks and every other player is either
	      finished too or lying in bed.
	Lose: the timer runs out («рассвет»).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local AntiExploit = require(script.Parent.AntiExploit)
local EventService = require(script.Parent.EventService)
local HideService = require(script.Parent.HideService)
local InteractService = require(script.Parent.InteractService)
local NpcBrain = require(script.Parent.NpcBrain)
local PlayerData = require(script.Parent.PlayerData)
local Session = require(script.Parent.Session)
local StealthService = require(script.Parent.StealthService)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Text = Config.Text

local RoundManager = {}
local rng = Random.new()

local function lobbyPosition(): Vector3
	return World.lobbySpawn + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
end

local function everyoneReady(): boolean
	local count = 0
	for _, s in Session.players do
		if not s.ready then
			return false
		end
		count += 1
	end
	return count > 0
end

local function roomCode(): string
	local alphabet = "АБВГДЕЖИКЛМНПРСТ0123456789"
	local letters = {}
	for _, codepoint in utf8.codes(alphabet) do
		table.insert(letters, utf8.char(codepoint))
	end
	local seed = 0
	for index = 1, #game.JobId do
		seed = (seed * 31 + string.byte(game.JobId, index)) % 2147483647
	end
	local generator = Random.new(seed ~= 0 and seed or os.time())
	local code = ""
	for _ = 1, 4 do
		code ..= letters[generator:NextInteger(1, #letters)]
	end
	return code
end

-- ---------------------------------------------------------------- round start / end
local function startRound()
	local bed = 0
	for _, s in Session.players do
		bed = bed % #World.beds + 1
		Session.reset(s)
		s.status = "playing"
		s.bed = bed
		s.ready = false
		StealthService.teleport(s, World.beds[bed].standPosition)
		StealthService.grace(s, 3)
		StealthService.applySpeed(s)
		Session.sync(s)
	end
	InteractService.resetAll()
	NpcBrain.start()
	EventService.start()
	workspace:SetAttribute("Result", "")
	Session.setPhase("round", Config.Round.Duration)
	Remotes.Notify:FireAllClients(Text.RoundStart, "info")
end

-- "win" | "lose" | nil (keep playing)
local function checkRound(endsAt: number): string?
	local participants = Session.participants()
	if #participants == 0 then
		return "lose"
	end
	local anyComplete, allDone = false, true
	for _, s in participants do
		if s.complete then
			anyComplete = true
		elseif s.status ~= "sleeping" then
			allDone = false
		end
	end
	if anyComplete and allDone then
		return "win"
	elseif os.clock() >= endsAt then
		return "lose"
	end
	return nil
end

local function endRound(result: string)
	NpcBrain.stop()
	EventService.stop()
	InteractService.resetAll()
	local participants = Session.participants()
	for _, s in participants do
		if s.spot then
			HideService.release(s, false)
		end
		s.chased = false
		s.pickup = nil
		if result == "win" then
			local bonus = Config.Rewards.Win + (s.complete and Config.Rewards.Complete or 0)
			s.roundStars += bonus
			PlayerData.addStars(s.player, bonus)
			PlayerData.addWin(s.player)
		end
		Session.sync(s)
	end
	workspace:SetAttribute("Result", result)
	Session.setPhase("results", Config.Round.Results)
	Remotes.Effect:FireAllClients("sound", result == "win" and "win" or "lose")
	task.wait(Config.Round.Results)

	for _, s in participants do
		if Session.players[s.player] then
			local character = s.player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.PlatformStand = false
			end
			Session.reset(s)
			StealthService.teleport(s, lobbyPosition())
			StealthService.applySpeed(s)
			Session.sync(s)
			Remotes.Effect:FireClient(s.player, "released")
		end
	end
end

-- A player who respawns in the middle of a round goes back to their bed.
local function onCharacter(player: Player)
	local s = Session.get(player)
	if not s or s.status == "lobby" then
		return
	end
	if s.spot then
		s.spot.occupant = nil
		s.spot = nil
	end
	s.status = "playing"
	s.crouched = false
	s.chased = false
	Session.sync(s)
	task.defer(function()
		local character = player.Character
		if character and character:WaitForChild("HumanoidRootPart", 5) then
			task.wait(0.1)
			StealthService.teleport(s, World.beds[s.bed].standPosition)
			StealthService.applySpeed(s)
		end
	end)
end

function RoundManager.init()
	workspace:SetAttribute("RoomCode", roomCode())
	workspace:SetAttribute("Result", "")

	AntiExploit.connect(Remotes.Ready, 3, 5, function(player, ready)
		local s = Session.get(player)
		if s and s.status == "lobby" and type(ready) == "boolean" then
			s.ready = ready
			Session.sync(s)
		end
	end)
	PlayerData.onLoaded(function(player)
		player.CharacterAdded:Connect(function()
			onCharacter(player)
		end)
	end)

	task.spawn(function()
		while true do
			-- lobby: wait until everybody is ready
			Session.setPhase("lobby", 0)
			repeat
				task.wait(0.5)
			until everyoneReady()

			-- lift countdown; anybody un-readying cancels it
			Session.setPhase("countdown", Config.Round.Countdown)
			local deadline = os.clock() + Config.Round.Countdown
			local cancelled = false
			while os.clock() < deadline do
				task.wait(0.25)
				if not everyoneReady() then
					cancelled = true
					break
				end
			end

			if not cancelled then
				startRound()
				local endsAt = os.clock() + Config.Round.Duration
				local result = nil
				repeat
					task.wait(0.25)
					result = checkRound(endsAt)
				until result
				endRound(result)
			end
		end
	end)
end

return RoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source"><![CDATA[--[[
	Session — the live state of the current round: phase, timer and one table per player
	(status, snacks, bed, crouch, hiding spot...). It holds data only; other systems change it
	and call Session.sync so the client sees it through Player attributes.

	status: "lobby" | "playing" | "hidden" | "caught" | "stunned" | "sleeping"
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)

local Session = {}
Session.phase = "lobby" -- "lobby" | "countdown" | "round" | "results"
Session.players = {} -- [player] = session table

function Session.get(player: Player)
	return Session.players[player]
end

-- Mirrors the session into attributes of the Player (read by every client's UI).
function Session.sync(s)
	local player = s.player
	player:SetAttribute("Status", s.status)
	player:SetAttribute("Delivered", s.delivered)
	player:SetAttribute("Carried", table.concat(s.carried, ","))
	player:SetAttribute("Complete", s.complete)
	player:SetAttribute("Ready", s.ready)
	player:SetAttribute("Crouched", s.crouched)
	player:SetAttribute("Chased", s.chased)
	player:SetAttribute("Holding", s.holding and s.holding.kind or "")
	player:SetAttribute("StunnedUntil", s.stunnedUntilServer)
	player:SetAttribute("RoundStars", s.roundStars)
	player:SetAttribute("Capacity", Session.capacity(s))
end

function Session.capacity(s): number
	return PlayerData.has(s.player, "backpack") and Config.Player.BackpackCapacity or Config.Player.BaseCapacity
end

-- Clears everything that belongs to one round.
function Session.reset(s)
	s.status = "lobby"
	s.delivered = 0
	s.carried = {}
	s.complete = false
	s.bed = 0
	s.crouched = false
	s.chased = false
	s.spot = nil
	s.spotSeen = false
	s.holding = nil
	s.stunnedUntil = 0
	s.stunnedUntilServer = 0
	s.roundStars = 0
	s.noiseRadius = 0
	s.pickup = nil
	s.graceUntil = 0
	s.speedStrikes = 0
end

function Session.setPhase(phase: string, duration: number)
	Session.phase = phase
	workspace:SetAttribute("Phase", phase)
	workspace:SetAttribute("PhaseEnds", workspace:GetServerTimeNow() + duration)
end

-- Players taking part in the running round.
function Session.participants()
	local list = {}
	for _, s in Session.players do
		if s.status ~= "lobby" then
			table.insert(list, s)
		end
	end
	return list
end

function Session.init()
	workspace:SetAttribute("Phase", "lobby")
	PlayerData.onLoaded(function(player)
		if Session.players[player] then
			return
		end
		local s = { player = player, ready = false, lastPos = nil, lastSampleAt = os.clock(), lastGood = nil }
		Session.reset(s)
		Session.players[player] = s
		Session.sync(s)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local s = Session.players[player]
		if s then
			if s.spot then
				s.spot.occupant = nil
			end
			Session.players[player] = nil
		end
	end)
end

return Session
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--[[
	ShopService — spending Звёздочки: пижамы (skins) and the three upgrades
	(Рюкзак, Тапок-подошва, Удача). Prices and ownership are checked on the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local AntiExploit = require(script.Parent.AntiExploit)
local PlayerData = require(script.Parent.PlayerData)
local Session = require(script.Parent.Session)

local Remotes = ReplicatedStorage.Remotes
local Text = Config.Text

local ShopService = {}

-- Paints the character as a pajama: plain coloured top and bottom plus a nightcap.
local function applySkin(player: Player)
	local profile = PlayerData.get(player)
	local character = player.Character
	local skin = profile and Config.Skins[profile.data.skin]
	if not character or not skin or not skin.top then
		return
	end
	for _, child in character:GetChildren() do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child:Destroy()
		end
	end
	local colors = character:FindFirstChildOfClass("BodyColors")
	if not colors then
		colors = Instance.new("BodyColors")
		colors.Parent = character
	end
	colors.TorsoColor3 = skin.top
	colors.LeftArmColor3 = skin.top
	colors.RightArmColor3 = skin.top
	colors.LeftLegColor3 = skin.bottom
	colors.RightLegColor3 = skin.bottom

	local head = character:FindFirstChild("Head")
	local cap = character:FindFirstChild("Nightcap")
	if head and head:IsA("BasePart") then
		if not cap then
			local part = Instance.new("Part")
			part.Name = "Nightcap"
			part.Size = Vector3.new(1.3, 0.7, 1.3)
			part.Material = Enum.Material.Fabric
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			part.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.3, 0)
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = head
			weld.Part1 = part
			weld.Parent = part
			part.Parent = character
			cap = part
		end
		(cap :: BasePart).Color = skin.top
	end
end

local function onCharacter(player: Player)
	task.spawn(function()
		local waited = 0
		while not player:HasAppearanceLoaded() and waited < 5 do
			waited += task.wait(0.2)
		end
		applySkin(player)
	end)
end

local function equip(player: Player, skinId: string)
	local profile = PlayerData.get(player)
	local s = Session.get(player)
	if not profile or not s or not profile.data.skins[skinId] or profile.data.skin == skinId then
		return
	end
	if s.status ~= "lobby" then
		PlayerData.notify(player, Text.ShopOnlyLobby, "bad")
		return
	end
	profile.data.skin = skinId
	PlayerData.sync(player)
	-- respawning restores the original clothes before the new pajama is painted on
	player:LoadCharacter()
end

local function onBuy(player: Player, kind: any, id: any)
	local profile = PlayerData.get(player)
	if not profile then
		return
	end
	if kind == "skin" and AntiExploit.isId(id, Config.Skins) then
		local skin = Config.Skins[id]
		if profile.data.skins[id] then
			return
		end
		if not PlayerData.spend(player, skin.price) then
			PlayerData.notify(player, Text.NoMoney, "bad")
			return
		end
		profile.data.skins[id] = true
		PlayerData.sync(player)
		PlayerData.notify(player, string.format(Text.Bought, skin.name), "good")
		equip(player, id)
	elseif kind == "upgrade" and AntiExploit.isId(id, Config.Upgrades) then
		local upgrade = Config.Upgrades[id]
		if profile.data.upgrades[id] then
			return
		end
		if not PlayerData.spend(player, upgrade.price) then
			PlayerData.notify(player, Text.NoMoney, "bad")
			return
		end
		profile.data.upgrades[id] = true
		PlayerData.sync(player)
		local s = Session.get(player)
		if s then
			Session.sync(s) -- carrying capacity may have changed
		end
		PlayerData.notify(player, string.format(Text.Bought, upgrade.name), "good")
	end
end

function ShopService.init()
	AntiExploit.connect(Remotes.Buy, 2, 4, onBuy)
	AntiExploit.connect(Remotes.Equip, 1, 2, function(player, skinId)
		if AntiExploit.isId(skinId, Config.Skins) then
			equip(player, skinId)
		end
	end)
	PlayerData.onLoaded(function(player)
		player.CharacterAdded:Connect(function()
			onCharacter(player)
		end)
		if player.Character then
			onCharacter(player)
		end
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">SnackService</string>
          <string name="Source"><![CDATA[--[[
	SnackService — the objective: take snacks in the kitchen (4 s hold), hide them in a bed
	in the bedroom, and optionally go to bed once a teammate has finished.

	The hold itself is shown by the ProximityPrompt on the client; the server checks the
	real elapsed time, the distance and the carrying capacity before giving a snack.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local AntiExploit = require(script.Parent.AntiExploit)
local PlayerData = require(script.Parent.PlayerData)
local Session = require(script.Parent.Session)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Text = Config.Text
local Needed = Config.Round.SnacksNeeded

local SnackService = {}

local function nearBed(player: Player): boolean
	for _, bed in World.beds do
		if AntiExploit.distanceOk(player, bed.mattress.Position, Config.Player.InteractDistance) then
			return true
		end
	end
	return false
end

-- Why the player cannot take one more snack right now (nil = they can).
local function pickupBlock(s): string?
	if s.delivered + #s.carried >= Needed then
		return Text.AlreadyEnough
	elseif #s.carried >= Session.capacity(s) then
		return Text.HandsFull
	end
	return nil
end

local function onPickup(player: Player, action: any, snackId: any)
	local s = Session.get(player)
	if not s or s.status ~= "playing" then
		return
	end
	if action == "cancel" then
		s.pickup = nil
		return
	end
	if not AntiExploit.isId(snackId, Config.Snacks) then
		return
	end
	local source = World.sources[snackId]
	if not source or not AntiExploit.distanceOk(player, source.Position, Config.Player.InteractDistance + 4) then
		return
	end

	if action == "start" then
		local reason = pickupBlock(s)
		if reason then
			PlayerData.notify(player, reason, "bad")
			return
		end
		s.pickup = { id = snackId, startedAt = os.clock() }
	elseif action == "finish" then
		local pickup = s.pickup
		s.pickup = nil
		if not pickup or pickup.id ~= snackId then
			return
		end
		local required = Config.Player.PickupTime * (PlayerData.has(player, "luck") and Config.Player.LuckMultiplier or 1)
		if os.clock() - pickup.startedAt < required - 0.35 or pickupBlock(s) then
			return -- held for too short a time: ignore
		end
		table.insert(s.carried, snackId)
		Session.sync(s)
		Remotes.Effect:FireClient(player, "sound", "pickup")
		PlayerData.notify(player, string.format(Text.PickedUp, Config.Snacks[snackId].name), "good")
	end
end

local function onDeliver(player: Player)
	local s = Session.get(player)
	if not s or s.status ~= "playing" or not nearBed(player) then
		return
	end
	local count = #s.carried
	if count == 0 then
		PlayerData.notify(player, Text.NothingToDeliver, "bad")
		return
	end
	local stars = count * Config.Rewards.PerSnack
	s.carried = {}
	s.delivered = math.min(Needed, s.delivered + count)
	s.roundStars += stars
	PlayerData.addStars(player, stars)
	Remotes.Effect:FireClient(player, "sound", "deliver")
	PlayerData.notify(player, string.format(Text.Delivered, s.delivered, Needed, stars), "good")

	if s.delivered >= Needed and not s.complete then
		s.complete = true
		PlayerData.notify(player, Text.Completed, "good")
		for other in Session.players do
			if other ~= player then
				PlayerData.notify(other, string.format(Text.TeammateCompleted, player.DisplayName), "info")
			end
		end
	end
	Session.sync(s)
end

-- «Лечь спать»: a player who will not finish can go to bed once somebody has all 5 snacks.
local function onSleep(player: Player)
	local s = Session.get(player)
	local character = player.Character
	if not s or not character or s.status ~= "playing" or not nearBed(player) then
		return
	end
	local anyComplete = false
	for _, other in Session.players do
		if other.complete then
			anyComplete = true
		end
	end
	if not anyComplete then
		PlayerData.notify(player, Text.SleepNeedComplete, "bad")
		return
	end
	s.status = "sleeping"
	s.pickup = nil
	World.layInBed(character, s.bed)
	Session.sync(s)
	PlayerData.notify(player, Text.Sleeping, "good")
end

function SnackService.init()
	AntiExploit.connect(Remotes.Pickup, 6, 10, onPickup)
	AntiExploit.connect(Remotes.Deliver, 2, 4, onDeliver)
	AntiExploit.connect(Remotes.Sleep, 1, 2, onSleep)
end

return SnackService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">StealthService</string>
          <string name="Source"><![CDATA[--[[
	StealthService — how players move during a round:
	  * crouch toggle (slower, quiet)
	  * footstep noise: running 20 studs, crouched 6, creaky floor 35
	  * anti-exploit speed check with rubber-banding
	  * the 10-second "stunned in bed" timer after being caught
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local AntiExploit = require(script.Parent.AntiExploit)
local Noise = require(script.Parent.Noise)
local PlayerData = require(script.Parent.PlayerData)
local Session = require(script.Parent.Session)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Text = Config.Text
local SAMPLE_INTERVAL = 0.25

local StealthService = {}

function StealthService.applySpeed(s)
	local character = s.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local crouching = s.status == "playing" and s.crouched
		humanoid.WalkSpeed = crouching and Config.Player.CrouchSpeed or Config.Player.RunSpeed
	end
end

-- After a server teleport the speed check must not fire.
function StealthService.grace(s, seconds: number?)
	s.graceUntil = os.clock() + (seconds or 2)
	s.lastPos = nil
	s.lastGood = nil
	s.speedStrikes = 0
end

function StealthService.teleport(s, position: Vector3)
	local character = s.player.Character
	if character then
		World.unfreeze(character, position)
	end
	StealthService.grace(s)
end

local function sample(s, now: number)
	local root = AntiExploit.getRoot(s.player)
	if not root then
		s.lastPos = nil
		return
	end
	local position = root.Position
	local dt = now - s.lastSampleAt
	s.lastSampleAt = now

	-- stun timer
	if s.status == "stunned" and now >= s.stunnedUntil then
		s.status = "playing"
		s.stunnedUntilServer = 0
		StealthService.teleport(s, World.beds[s.bed].standPosition)
		StealthService.applySpeed(s)
		Session.sync(s)
		Remotes.Effect:FireClient(s.player, "released")
		PlayerData.notify(s.player, Text.Released, "info")
		return
	end

	if s.status ~= "playing" then
		s.noiseRadius = 0
		s.lastPos = position
		return
	end

	local last = s.lastPos
	s.lastPos = position
	if not last or dt <= 0 then
		s.lastGood = position
		return
	end
	local speed = Vector3.new(position.X - last.X, 0, position.Z - last.Z).Magnitude / dt

	-- speed check: nobody may move faster than a running kid (with some tolerance for lag)
	if now > s.graceUntil and speed > Config.Player.RunSpeed * 1.7 + 4 then
		s.speedStrikes += 1
		if s.speedStrikes >= 3 and s.lastGood then
			s.speedStrikes = 0
			local character = s.player.Character
			if character then
				character:PivotTo(CFrame.new(s.lastGood))
			end
			s.lastPos = s.lastGood
			PlayerData.notify(s.player, Text.SpeedWarning, "bad")
			return
		end
	else
		s.speedStrikes = math.max(0, s.speedStrikes - 0.25)
		s.lastGood = position
	end

	-- footstep noise is decided from the real measured speed, not from what the client claims
	local radius = 0
	if speed > 2 then
		local quiet = s.crouched and speed <= Config.Player.CrouchSpeed * 1.6
		radius = quiet and Config.Noise.Crouch or Config.Noise.Run
		if World.inCreak(position) and not PlayerData.has(s.player, "soles") then
			radius = Config.Noise.Creak
		end
		Noise.emit(position, radius, "step")
	end
	s.noiseRadius = radius
end

function StealthService.init()
	AntiExploit.connect(Remotes.Crouch, 4, 6, function(player, enabled)
		local s = Session.get(player)
		if not s or type(enabled) ~= "boolean" or s.status ~= "playing" then
			return
		end
		s.crouched = enabled
		StealthService.applySpeed(s)
		Session.sync(s)
	end)

	task.spawn(function()
		while true do
			task.wait(SAMPLE_INTERVAL)
			local now = os.clock()
			for _, s in Session.players do
				sample(s, now)
			end
		end
	end)
end

return StealthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--[[
	World — references to the static map (Workspace.Map) and everything scripts need from it:
	beds, snack sources, hiding spots, throwable items, creaky zones, lights, waypoints.
	Also creates the proximity prompts (their text comes from Config.Text).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Text = Config.Text

local World = {}

World.map = workspace:WaitForChild("Map")
World.beds = {} -- [index] = { mattress, layCFrame, standPosition }
World.sources = {} -- [snackId] = BasePart
World.spots = {} -- [spotId] = { id, kind, part, inside, exit, occupant }
World.itemParts = {} -- [itemId] = BasePart
World.creaks = {} -- array of BasePart
World.lamps = {} -- array of { part, light }
World.nodes = {} -- [name] = Vector3 (floor level)
World.tv = nil :: BasePart?
World.tap = nil :: BasePart?
World.sofa = Vector3.zero
World.lobbySpawn = Vector3.zero

-- Родитель's server-side root part lives here; raycasts ignore this folder.
World.npcFolder = Instance.new("Folder")
World.npcFolder.Name = "NPC"
World.npcFolder.Parent = workspace

-- A character lying on its back with the head to the north (towards the pillow).
local LYING = CFrame.Angles(0, math.pi, 0) * CFrame.Angles(math.pi / 2, 0, 0)

local function addPrompt(part: BasePart, name: string, objectText: string, actionText: string, hold: number?, key: Enum.KeyCode?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ObjectText = objectText
	prompt.ActionText = actionText
	prompt.KeyboardKeyCode = key or Enum.KeyCode.E
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	return prompt
end

function World.setSign(part: BasePart, text: string, color: Color3?, studsWide: number?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "SignGui"
	gui.Size = UDim2.fromScale(studsWide or 10, 2.4)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Adornee = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.3
	label.TextColor3 = color or Color3.fromRGB(255, 232, 170)
	label.Text = text
	label.Parent = gui
	gui.Parent = part
end

-- Is this position on a creaky floorboard?
function World.inCreak(position: Vector3): boolean
	for _, zone in World.creaks do
		local offset = position - zone.Position
		if math.abs(offset.X) <= zone.Size.X / 2 and math.abs(offset.Z) <= zone.Size.Z / 2 then
			return true
		end
	end
	return false
end

function World.spotCFrame(spot): CFrame
	if spot.kind == "bed" then
		return CFrame.new(spot.inside) * LYING
	end
	return CFrame.new(spot.inside)
end

local function freeze(character: Model, cframe: CFrame)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.Anchored = true
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(cframe)
	end
end

-- Puts a character somewhere and makes it stay there (anchored root).
World.freeze = freeze

function World.unfreeze(character: Model, position: Vector3)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		character:PivotTo(CFrame.new(position))
		root.Anchored = false
	end
end

function World.layInBed(character: Model, bedIndex: number)
	freeze(character, World.beds[bedIndex].layCFrame)
end

function World.init()
	local map = World.map

	for _, model in map:WaitForChild("Beds"):GetChildren() do
		local index = tonumber(string.match(model.Name, "%d+"))
		local mattress = model:FindFirstChild("Mattress") :: BasePart
		local stand = model:FindFirstChild("Stand") :: BasePart
		if index then
			World.beds[index] = {
				mattress = mattress,
				layCFrame = CFrame.new(mattress.Position + Vector3.new(0, 1.5, 0)) * LYING,
				standPosition = stand.Position,
			}
			addPrompt(mattress, "DeliverPrompt", Text.PromptBed, Text.PromptDeliver)
			addPrompt(mattress, "SleepPrompt", Text.PromptBed, Text.PromptSleep, 1, Enum.KeyCode.G)
		end
	end

	for _, part in map:WaitForChild("Sources"):GetChildren() do
		local snackId = string.match(part.Name, "^Source_(%a+)$")
		if snackId and Config.Snacks[snackId] and part:IsA("BasePart") then
			World.sources[snackId] = part
			local prompt = addPrompt(part, "PickupPrompt", Config.Snacks[snackId].name, Text.PromptTake, Config.Player.PickupTime)
			prompt:SetAttribute("SnackId", snackId)
		end
	end

	for _, model in map:WaitForChild("HideSpots"):GetChildren() do
		local kind = "wardrobe"
		if string.find(model.Name, "UnderBed") then
			kind = "bed"
		elseif model.Name == "Bath" then
			kind = "bath"
		end
		local part = model:FindFirstChild("Prompt") :: BasePart
		local prompt = addPrompt(part, "HidePrompt", Text.SpotNames[kind], Text.PromptHide)
		prompt:SetAttribute("SpotId", model.Name)
		World.spots[model.Name] = {
			id = model.Name,
			kind = kind,
			part = part,
			inside = (model:FindFirstChild("Inside") :: BasePart).Position,
			exit = (model:FindFirstChild("Exit") :: BasePart).Position,
			occupant = nil,
		}
	end

	for _, part in map:WaitForChild("Items"):GetChildren() do
		if part:IsA("BasePart") then
			World.itemParts[part.Name] = part
		end
	end
	for _, part in map:WaitForChild("CreakyZones"):GetChildren() do
		if part:IsA("BasePart") then
			table.insert(World.creaks, part)
		end
	end
	for _, part in map:WaitForChild("Lights"):GetChildren() do
		local light = part:FindFirstChildOfClass("PointLight")
		if light and part:IsA("BasePart") then
			table.insert(World.lamps, { part = part, light = light })
		end
	end
	for _, part in map:WaitForChild("Waypoints"):GetChildren() do
		if part:IsA("BasePart") then
			World.nodes[part.Name] = Vector3.new(part.Position.X, 0, part.Position.Z)
		end
	end

	local interactables = map:WaitForChild("Interactables")
	local tv = interactables:WaitForChild("TV") :: BasePart
	local tap = interactables:WaitForChild("Tap") :: BasePart
	World.tv = tv
	World.tap = tap
	addPrompt(tv, "UsePrompt", Text.PromptTvName, Text.PromptTv):SetAttribute("ObjectId", "tv")
	addPrompt(tap, "UsePrompt", Text.PromptTapName, Text.PromptTap):SetAttribute("ObjectId", "tap")
	local sofa = (interactables:WaitForChild("SofaSeat") :: BasePart).Position
	World.sofa = Vector3.new(sofa.X, 0, sofa.Z)

	local lobby = map:WaitForChild("Lobby")
	World.lobbySpawn = (lobby:WaitForChild("SpawnLocation") :: BasePart).Position + Vector3.new(0, 4, 0)
	World.setSign(lobby:WaitForChild("LobbySign") :: BasePart, Text.LobbySign, nil, 10)
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="37">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="38">
      <Properties>
        <string name="Name">MainGui</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="39">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client — entry point of the Russian UI. Loads the client modules in order.
	MainGui (the ScreenGui) is the container for everything they build.
]]

local folder = script.Parent

require(folder:WaitForChild("UIKit"))
local Sounds = require(folder:WaitForChild("Sounds"))
local ParentVisual = require(folder:WaitForChild("ParentVisual"))
local Hud = require(folder:WaitForChild("Hud"))
local Lobby = require(folder:WaitForChild("Lobby"))
local Controls = require(folder:WaitForChild("Controls"))

Sounds.init()
ParentVisual.init()
Hud.init()
Lobby.init()
Controls.init()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Controls</string>
          <string name="Source"><![CDATA[--[[
	Controls — player input:
	  E            use the prompt in front of you (take a snack — hold 4 s, hide, pick up, TV, tap)
	  E            climb out of a hiding spot
	  Ctrl / C     toggle crouch (slow and quiet)
	  F            throw the item in your hand where the camera looks
	  G (hold)     lie down in bed
	Every action is only a request: the server checks distance, timing and state.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local Text = Config.Text

local Controls = {}
local lastHideRequest = 0
local baseHipHeight: number? = nil

local function attr(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function status(): string
	return attr("Status", "lobby")
end

-- ---------------------------------------------------------------- actions
local function toggleCrouch()
	if status() == "playing" then
		Remotes.Crouch:FireServer(not attr("Crouched", false))
	end
end

-- Hiding and climbing out share one debounce, so a single key press never does both.
local function requestHide(spotId: string?)
	local now = os.clock()
	if now - lastHideRequest < 0.5 then
		return
	end
	lastHideRequest = now
	Remotes.Hide:FireServer(spotId)
end

local function throwItem()
	local camera = workspace.CurrentCamera
	if camera and status() == "playing" and attr("Holding", "") ~= "" then
		Remotes.Throw:FireServer(camera.CFrame.LookVector)
	end
end

-- Why one more snack cannot be taken right now (nil = it can).
local function pickupBlock(): string?
	local carried = attr("Carried", "")
	local count = carried == "" and 0 or #string.split(carried, ",")
	if attr("Delivered", 0) + count >= Config.Round.SnacksNeeded then
		return Text.AlreadyEnough
	elseif count >= attr("Capacity", 1) then
		return Text.HandsFull
	end
	return nil
end

-- ---------------------------------------------------------------- crouch look
-- The server owns the speed; here the character is only lowered so the crouch is visible.
local function applyCrouchLook()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if not baseHipHeight then
		baseHipHeight = humanoid.HipHeight
	end
	local crouched = attr("Crouched", false) and status() == "playing"
	humanoid.HipHeight = (baseHipHeight :: number) - (crouched and 1 or 0)
	humanoid.CameraOffset = Vector3.new(0, crouched and -1 or 0, 0)
end

-- «Удача»: the hold shown on the prompt is 20% shorter (the server uses the same number).
local function applyLuck()
	local lucky = string.find(attr("Upgrades", ""), "luck", 1, true) ~= nil
	local duration = Config.Player.PickupTime * (lucky and Config.Player.LuckMultiplier or 1)
	local sources = workspace:WaitForChild("Map"):WaitForChild("Sources")
	for _, source in sources:GetChildren() do
		local prompt = source:FindFirstChild("PickupPrompt")
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.HoldDuration = duration
		end
	end
end

-- ---------------------------------------------------------------- prompts
local function onHoldBegan(prompt: ProximityPrompt)
	if prompt.Name == "PickupPrompt" then
		local reason = pickupBlock()
		if reason then
			Hud.notify(reason, "bad")
		else
			Remotes.Pickup:FireServer("start", prompt:GetAttribute("SnackId"))
		end
	end
end

local function onTriggered(prompt: ProximityPrompt)
	local name = prompt.Name
	if name == "PickupPrompt" then
		if not pickupBlock() then
			Remotes.Pickup:FireServer("finish", prompt:GetAttribute("SnackId"))
		end
	elseif name == "DeliverPrompt" then
		Remotes.Deliver:FireServer()
	elseif name == "SleepPrompt" then
		Remotes.Sleep:FireServer()
	elseif name == "HidePrompt" then
		requestHide(prompt:GetAttribute("SpotId") :: any)
	elseif name == "ItemPrompt" then
		Remotes.GrabItem:FireServer(prompt:GetAttribute("ItemId"))
	elseif name == "UsePrompt" then
		Remotes.UseObject:FireServer(prompt:GetAttribute("ObjectId"))
	end
end

function Controls.init()
	Hud.callbacks.crouch = toggleCrouch
	Hud.callbacks.throw = throwItem
	Hud.callbacks.exit = function()
		requestHide(nil)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.RightControl or key == Enum.KeyCode.C then
			toggleCrouch()
		elseif key == Enum.KeyCode.F then
			throwItem()
		elseif key == Enum.KeyCode.E and status() == "hidden" then
			requestHide(nil)
		end
	end)

	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, who)
		if who == player then
			onHoldBegan(prompt)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who == player then
			onTriggered(prompt)
		end
	end)

	player:GetAttributeChangedSignal("Crouched"):Connect(applyCrouchLook)
	player:GetAttributeChangedSignal("Status"):Connect(applyCrouchLook)
	player.CharacterAdded:Connect(function()
		baseHipHeight = nil
	end)
	player:GetAttributeChangedSignal("Upgrades"):Connect(applyLuck)
	task.spawn(applyLuck)
end

return Controls
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">Hud</string>
          <string name="Source"><![CDATA[--[[
	Hud — the in-round interface, all in Russian:
	objective tracker, «До рассвета» timer, snack icons, team list, crouch/noise indicator,
	«Тебя заметили!» red vignette, event banners, notifications and the big centre messages.
	It reads the round state from Player and Workspace attributes set by the server.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local Text = Config.Text
local Colors = UIKit.Colors
local Needed = Config.Round.SnacksNeeded

local Hud = {}
-- Set by Controls: what the touch buttons do.
Hud.callbacks = {
	crouch = function() end,
	throw = function() end,
	exit = function() end,
}

local gui = script.Parent
local container: Frame
local objectiveLabel, timerLabel, handsLabel, noiseLabel, noisePill, contextLabel, centerLabel
local teamList: Frame
local vignette: Frame
local notifications: Frame
local banner: Frame, bannerTitle: TextLabel, bannerSub: TextLabel
local crouchButton, throwButton, exitButton
local bannerToken = 0
local wasOnCreak = false
local creakParts: { BasePart } = {}

local function attr(instance: Instance, name: string, default: any): any
	local value = instance:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

-- ---------------------------------------------------------------- notifications & banner
local KIND_COLORS = { good = Colors.green, bad = Colors.red, info = Colors.blue }

function Hud.notify(text: string, kind: string?)
	local frames = {}
	for _, child in notifications:GetChildren() do
		if child:IsA("Frame") then
			table.insert(frames, child)
		end
	end
	if #frames >= 4 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
	local frame = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Colors.bg, BackgroundTransparency = 0.1,
		LayoutOrder = math.floor(os.clock() * 100), Parent = notifications,
	}, { UIKit.corner(10), UIKit.stroke(KIND_COLORS[kind or "info"] or Colors.blue, 2), UIKit.padding(10) })
	local label = UIKit.label({
		Text = text, TextSize = 15, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = frame,
	})
	if kind == "bad" then
		Sounds.play("error")
	end
	task.delay(5, function()
		if frame.Parent then
			local info = TweenInfo.new(0.4)
			TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, info, { TextTransparency = 1 }):Play()
			task.wait(0.45)
			frame:Destroy()
		end
	end)
end

function Hud.showBanner(title: string, subtitle: string)
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerSub.Text = subtitle
	banner.Visible = true
	banner.Size = UDim2.fromOffset(560, 96)
	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(760, 126) }):Play()
	Sounds.play("event")
	task.delay(6, function()
		if token == bannerToken then
			banner.Visible = false
		end
	end)
end

-- ---------------------------------------------------------------- rendering
local function onCreak(position: Vector3): boolean
	for _, zone in creakParts do
		local offset = position - zone.Position
		if math.abs(offset.X) <= zone.Size.X / 2 and math.abs(offset.Z) <= zone.Size.Z / 2 then
			return true
		end
	end
	return false
end

local function renderNoise(status: string)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if status ~= "playing" or not humanoid or not root or not root:IsA("BasePart") then
		noisePill.Visible = false
		wasOnCreak = false
		return
	end
	noisePill.Visible = true
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	local soles = string.find(attr(player, "Upgrades", ""), "soles", 1, true) ~= nil
	local creaking = moving and not soles and onCreak(root.Position)
	if creaking and not wasOnCreak then
		Sounds.play("creak")
	end
	wasOnCreak = creaking
	if not moving then
		noiseLabel.Text = Text.Standing
		noiseLabel.TextColor3 = Colors.dim
	elseif creaking then
		noiseLabel.Text = Text.CrouchCreak
		noiseLabel.TextColor3 = Colors.red
	elseif attr(player, "Crouched", false) then
		noiseLabel.Text = Text.CrouchOn
		noiseLabel.TextColor3 = Colors.green
	else
		noiseLabel.Text = Text.CrouchOff
		noiseLabel.TextColor3 = Colors.accent
	end
end

local function renderTeam()
	UIKit.clear(teamList)
	local order = 0
	for _, other in Players:GetPlayers() do
		local status = attr(other, "Status", "lobby")
		if status ~= "lobby" then
			order += 1
			local complete = attr(other, "Complete", false)
			UIKit.label({
				Text = string.format("%s — %d/%d · %s", other.DisplayName, attr(other, "Delivered", 0), Needed,
					complete and status == "playing" and Text.Done or (Text.StatusNames[status] or "")),
				TextSize = 14, TextColor3 = complete and Colors.green or (status == "caught" and Colors.red or Colors.text),
				TextStrokeTransparency = 0.5, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order, Parent = teamList,
			})
		end
	end
end

local function render()
	local status = attr(player, "Status", "lobby")
	local phase = workspace:GetAttribute("Phase")
	local inRound = status ~= "lobby" and phase == "round"
	container.Visible = inRound
	if not inRound then
		vignette.Visible = false
		return
	end
	local now = workspace:GetServerTimeNow()

	-- objective, timer, hands
	objectiveLabel.Text = attr(player, "Complete", false) and Text.ObjectiveDone
		or string.format(Text.Objective, attr(player, "Delivered", 0), Needed)
	timerLabel.Text = string.format(Text.Timer, Config.formatTime((workspace:GetAttribute("PhaseEnds") or now) - now))
	local carried = attr(player, "Carried", "")
	if carried == "" then
		handsLabel.Text = string.format(Text.HandsEmpty, attr(player, "Capacity", 1))
	else
		local names = {}
		for _, id in string.split(carried, ",") do
			local snack = Config.Snacks[id]
			if snack then
				table.insert(names, snack.icon .. " " .. snack.name)
			end
		end
		handsLabel.Text = string.format(Text.Hands, table.concat(names, ", "))
	end

	renderTeam()
	renderNoise(status)

	-- context hint
	local holding = attr(player, "Holding", "")
	local tvLeft = (workspace:GetAttribute("TVUntil") or 0) - now
	if status == "hidden" then
		contextLabel.Text = Text.HiddenHint
	elseif holding ~= "" and Config.Items[holding] then
		contextLabel.Text = string.format(Text.HeldHint, Config.Items[holding].name)
	elseif tvLeft > 0 then
		contextLabel.Text = string.format(Text.TvOn, math.ceil(tvLeft))
	else
		contextLabel.Text = status == "playing" and Text.CrouchHint or ""
	end

	-- big centre message
	if status == "caught" then
		centerLabel.Text = Text.CaughtBig
	elseif status == "stunned" then
		centerLabel.Text = string.format(Text.StunnedHint, math.max(0, math.ceil(attr(player, "StunnedUntil", 0) - now)))
	elseif status == "sleeping" then
		centerLabel.Text = Text.SleepingHint
	else
		centerLabel.Text = ""
	end

	vignette.Visible = attr(player, "Chased", false)
	crouchButton.Visible = UserInputService.TouchEnabled and status == "playing"
	crouchButton.BackgroundColor3 = attr(player, "Crouched", false) and Colors.green or Colors.panel
	throwButton.Visible = UserInputService.TouchEnabled and status == "playing" and holding ~= ""
	exitButton.Visible = UserInputService.TouchEnabled and status == "hidden"
end

-- ---------------------------------------------------------------- build
local function pill(parent: Instance, order: number, width: number): TextLabel
	local frame = UIKit.new("Frame", {
		Size = UDim2.fromOffset(width, 42), BackgroundColor3 = Colors.bg, BackgroundTransparency = 0.15,
		LayoutOrder = order, Parent = parent,
	}, { UIKit.corner(12), UIKit.stroke(Colors.panel, 2) })
	return UIKit.label({
		Text = "", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false,
		Size = UDim2.fromScale(1, 1), Parent = frame,
	})
end

local function vignetteEdge(position: UDim2, size: UDim2, anchor: Vector2, rotation: number)
	UIKit.new("Frame", {
		AnchorPoint = anchor, Position = position, Size = size, BackgroundColor3 = Color3.fromRGB(230, 30, 30),
		BorderSizePixel = 0, Parent = vignette,
	}, {
		UIKit.new("UIGradient", {
			Rotation = rotation,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }),
		}),
	})
end

function Hud.init()
	-- one scale for every screen size
	local scale = UIKit.new("UIScale", { Parent = gui })
	local function updateScale()
		local camera = workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.5, 1.3)
		end
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end

	-- red vignette (behind everything else)
	vignette = UIKit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	vignetteEdge(UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.2), Vector2.new(0, 0), 90)
	vignetteEdge(UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.2), Vector2.new(0, 1), 270)
	vignetteEdge(UDim2.fromScale(0, 0), UDim2.fromScale(0.14, 1), Vector2.new(0, 0), 0)
	vignetteEdge(UDim2.fromScale(1, 0), UDim2.fromScale(0.14, 1), Vector2.new(1, 0), 180)
	UIKit.label({
		Text = Text.Spotted, TextSize = 38, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 70, 60),
		TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0,
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 150), Size = UDim2.fromOffset(700, 46), Parent = vignette,
	})

	container = UIKit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })

	-- top: objective and timer, then what is in the hands
	local topBar = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(640, 42),
		BackgroundTransparency = 1, Parent = container,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) })
	objectiveLabel = pill(topBar, 1, 340)
	objectiveLabel.TextColor3 = Colors.accent
	timerLabel = pill(topBar, 2, 280)
	local handsBar = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 54), Size = UDim2.fromOffset(630, 42),
		BackgroundTransparency = 1, Parent = container,
	})
	handsLabel = pill(handsBar, 1, 630)

	-- left: the team
	local team = UIKit.new("Frame", {
		Position = UDim2.fromOffset(12, 110), Size = UDim2.fromOffset(300, 140), BackgroundTransparency = 1, Parent = container,
	})
	UIKit.label({
		Text = Text.Team, TextSize = 16, TextColor3 = Colors.accent, TextStrokeTransparency = 0.5,
		Size = UDim2.new(1, 0, 0, 22), Parent = team,
	})
	teamList = UIKit.new("Frame", {
		Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 1, -24), BackgroundTransparency = 1, Parent = team,
	}, { UIKit.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }) })

	-- bottom: noise indicator and context hint
	contextLabel = UIKit.label({
		Text = "", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -64), Size = UDim2.fromOffset(760, 24), Parent = container,
	})
	noisePill = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(300, 42),
		BackgroundColor3 = Colors.bg, BackgroundTransparency = 0.15, Parent = container,
	}, { UIKit.corner(12), UIKit.stroke(Colors.panel, 2) })
	noiseLabel = UIKit.label({
		Text = "", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = noisePill,
	})

	-- centre: caught / in bed
	centerLabel = UIKit.label({
		Text = "", TextSize = 54, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(900, 70), Parent = container,
	})

	-- touch buttons
	local actions = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(160, 200),
		BackgroundTransparency = 1, Parent = container,
	}, { UIKit.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right) })
	crouchButton = UIKit.button(Text.BtnCrouch, Colors.panel, function()
		Hud.callbacks.crouch()
	end, { Size = UDim2.fromOffset(160, 56), TextSize = 18, LayoutOrder = 1, Visible = false, Parent = actions })
	throwButton = UIKit.button(Text.BtnThrow, Colors.blue, function()
		Hud.callbacks.throw()
	end, { Size = UDim2.fromOffset(160, 56), TextSize = 18, LayoutOrder = 2, Visible = false, Parent = actions })
	exitButton = UIKit.button(Text.BtnExit, Colors.accent, function()
		Hud.callbacks.exit()
	end, { Size = UDim2.fromOffset(160, 56), TextSize = 18, LayoutOrder = 3, Visible = false, TextColor3 = Colors.bg, Parent = actions })

	-- notifications and banner (visible in the lobby too)
	notifications = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 56), Size = UDim2.fromOffset(340, 300),
		BackgroundTransparency = 1, Parent = gui,
	}, { UIKit.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	banner = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.27), Size = UDim2.fromOffset(760, 126),
		BackgroundColor3 = Colors.bg, BackgroundTransparency = 0.2, Visible = false, ZIndex = 20, Parent = gui,
	}, { UIKit.corner(18), UIKit.stroke(Colors.accent, 3) })
	bannerTitle = UIKit.label({
		Text = "", Font = Enum.Font.GothamBlack, TextColor3 = Colors.accent, TextXAlignment = Enum.TextXAlignment.Center,
		TextScaled = true, Position = UDim2.new(0.04, 0, 0.08, 0), Size = UDim2.new(0.92, 0, 0.5, 0), ZIndex = 21, Parent = banner,
	})
	bannerSub = UIKit.label({
		Text = "", TextXAlignment = Enum.TextXAlignment.Center, TextScaled = true,
		Position = UDim2.new(0.04, 0, 0.62, 0), Size = UDim2.new(0.92, 0, 0.28, 0), ZIndex = 21, Parent = banner,
	})

	-- creaky floorboards, for the noise indicator
	task.spawn(function()
		local zones = workspace:WaitForChild("Map"):WaitForChild("CreakyZones")
		for _, zone in zones:GetChildren() do
			if zone:IsA("BasePart") then
				table.insert(creakParts, zone)
			end
		end
	end)

	-- server messages
	Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text, kind)
		if type(text) == "string" then
			Hud.notify(text, kind)
		end
	end)
	Remotes:WaitForChild("Banner").OnClientEvent:Connect(function(title, subtitle)
		if type(title) == "string" then
			Hud.showBanner(title, type(subtitle) == "string" and subtitle or "")
		end
	end)
	Remotes:WaitForChild("Effect").OnClientEvent:Connect(function(kind, a)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if kind == "sound" and type(a) == "string" then
			Sounds.play(a)
		elseif kind == "spotted" then
			Sounds.play("spotted")
		elseif kind == "caught" then
			Sounds.play("caught")
			if humanoid then
				humanoid.PlatformStand = true
			end
		elseif kind == "stunned" or kind == "released" then
			if humanoid then
				humanoid.PlatformStand = false
			end
		elseif (kind == "thud" or kind == "tap") and typeof(a) == "Vector3" then
			Sounds.playAt(kind, a)
		end
	end)

	-- text refreshes a few times per second; the vignette pulses every frame
	task.spawn(function()
		while true do
			render()
			task.wait(0.2)
		end
	end)
	RunService.RenderStepped:Connect(function()
		if vignette.Visible then
			local pulse = 0.25 + 0.2 * math.sin(os.clock() * 7)
			for _, edge in vignette:GetChildren() do
				if edge:IsA("Frame") then
					edge.BackgroundTransparency = pulse
				end
			end
		end
	end)
end

return Hud
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--[[
	Lobby — everything outside the round, all in Russian:
	  * lobby panel: room code, player list with «готов» marks, Звёздочки, «Готов» and «Магазин»
	  * lift countdown text
	  * results screen: «Победа!» / «Вас поймали...»
	  * the shop window: пижамы and upgrades
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local Text = Config.Text
local Colors = UIKit.Colors
local Needed = Config.Round.SnacksNeeded

local Lobby = {}

local gui = script.Parent
local panel: Frame, roomLabel: TextLabel, playersLabel: TextLabel, playerList: Frame
local statsLabel: TextLabel, statusLabel: TextLabel, readyButton: TextButton
local results: Frame, resultTitle: TextLabel, resultSub: TextLabel, resultList: Frame, resultFooter: TextLabel
local shop: any
local shopOpen = false

local function attr(instance: Instance, name: string, default: any): any
	local value = instance:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function owns(listAttribute: string, id: string): boolean
	for _, owned in string.split(attr(player, listAttribute, ""), ",") do
		if owned == id then
			return true
		end
	end
	return false
end

-- ---------------------------------------------------------------- shop
local function shopRow(order: number, title: string, desc: string, buttonText: string, color: Color3, enabled: boolean, callback: () -> ())
	local row = UIKit.row(shop.content, 70, order)
	UIKit.label({
		Text = title, TextSize = 18, ZIndex = 13,
		Position = UDim2.fromOffset(18, 8), Size = UDim2.new(1, -190, 0, 22), Parent = row,
	})
	UIKit.label({
		Text = desc, TextSize = 13, Font = Enum.Font.GothamMedium, TextColor3 = Colors.dim, ZIndex = 13,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(18, 32), Size = UDim2.new(1, -190, 0, 34), Parent = row,
	})
	local button = UIKit.button(buttonText, color, callback, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(150, 50), TextSize = 15, ZIndex = 13, Parent = row,
	})
	if not enabled then
		UIKit.setEnabled(button, false)
	end
end

local function shopHeader(order: number, text: string)
	UIKit.label({
		Text = text, TextSize = 17, Font = Enum.Font.GothamBlack, TextColor3 = Colors.accent,
		Size = UDim2.new(1, -12, 0, 26), LayoutOrder = order, ZIndex = 12, Parent = shop.content,
	})
end

local function renderShop()
	if not shopOpen then
		return
	end
	UIKit.clear(shop.content)
	local stars = attr(player, "Stars", 0)
	local equipped = attr(player, "Skin", "default")
	local order = 1
	shopHeader(order, string.format(Text.ShopBalance, stars))

	order += 1
	shopHeader(order, Text.ShopSkins)
	for _, id in Config.SkinOrder do
		local skin = Config.Skins[id]
		order += 1
		if equipped == id then
			shopRow(order, skin.name, "", Text.BtnEquipped, Colors.grey, false, function() end)
		elseif owns("Skins", id) then
			shopRow(order, skin.name, "", Text.BtnEquip, Colors.blue, true, function()
				Remotes.Equip:FireServer(id)
			end)
		else
			shopRow(order, skin.name, "", string.format(Text.BtnBuy, skin.price), Colors.green, stars >= skin.price, function()
				Remotes.Buy:FireServer("skin", id)
			end)
		end
	end

	order += 1
	shopHeader(order, Text.ShopUpgrades)
	for _, id in Config.UpgradeOrder do
		local upgrade = Config.Upgrades[id]
		order += 1
		if owns("Upgrades", id) then
			shopRow(order, upgrade.name, upgrade.desc, Text.BtnOwned, Colors.grey, false, function() end)
		else
			shopRow(order, upgrade.name, upgrade.desc, string.format(Text.BtnBuy, upgrade.price), Colors.green,
				stars >= upgrade.price, function()
					Remotes.Buy:FireServer("upgrade", id)
				end)
		end
	end
end

local function setShop(open: boolean)
	shopOpen = open
	shop.frame.Visible = open
	renderShop()
end

-- ---------------------------------------------------------------- lobby panel & results
local function renderLobby(phase: string, now: number)
	local everyone = Players:GetPlayers()
	roomLabel.Text = string.format(Text.Room, workspace:GetAttribute("RoomCode") or "")
	playersLabel.Text = string.format(Text.Players, #everyone, Config.Round.MaxPlayers)
	UIKit.clear(playerList)
	for order, other in everyone do
		local status = attr(other, "Status", "lobby")
		local ready = attr(other, "Ready", false)
		local mark = status ~= "lobby" and (Text.StatusNames[status] or "") or (ready and Text.ReadyMark or Text.NotReadyMark)
		UIKit.label({
			Text = string.format("%s — %s", other.DisplayName, mark), TextSize = 16,
			TextColor3 = (status == "lobby" and ready) and Colors.green or Colors.text,
			Size = UDim2.new(1, 0, 0, 24), LayoutOrder = order, Parent = playerList,
		})
	end
	statsLabel.Text = string.format(Text.Stars, attr(player, "Stars", 0)) .. "   " .. string.format(Text.Wins, attr(player, "Wins", 0))

	local left = (workspace:GetAttribute("PhaseEnds") or now) - now
	if phase == "countdown" then
		statusLabel.Text = string.format(Text.Countdown, math.max(0, math.ceil(left)))
		statusLabel.TextColor3 = Colors.accent
	elseif phase == "round" or phase == "results" then
		statusLabel.Text = string.format(Text.RoundRunning, Config.formatTime(phase == "round" and left or 0))
		statusLabel.TextColor3 = Colors.dim
	else
		statusLabel.Text = Text.LobbyHint
		statusLabel.TextColor3 = Colors.dim
	end

	local ready = attr(player, "Ready", false)
	readyButton.Text = ready and Text.BtnNotReady or Text.BtnReady
	readyButton.BackgroundColor3 = ready and Colors.red or Colors.green
	readyButton.Visible = phase == "lobby" or phase == "countdown"
end

local function renderResults(now: number)
	local win = workspace:GetAttribute("Result") == "win"
	resultTitle.Text = win and Text.Win or Text.Lose
	resultTitle.TextColor3 = win and Colors.green or Colors.red
	resultSub.Text = win and Text.WinSub or Text.LoseSub
	UIKit.clear(resultList)
	local order = 0
	for _, other in Players:GetPlayers() do
		if attr(other, "Status", "lobby") ~= "lobby" then
			order += 1
			UIKit.label({
				Text = string.format(Text.ResultRow, other.DisplayName, attr(other, "Delivered", 0), Needed, attr(other, "RoundStars", 0)),
				TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center,
				TextColor3 = attr(other, "Complete", false) and Colors.accent or Colors.text,
				Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order, Parent = resultList,
			})
		end
	end
	local left = (workspace:GetAttribute("PhaseEnds") or now) - now
	resultFooter.Text = string.format(Text.BackToLobby, math.max(0, math.ceil(left)))
end

local function render()
	local status = attr(player, "Status", "lobby")
	local phase = workspace:GetAttribute("Phase") or "lobby"
	local now = workspace:GetServerTimeNow()
	local showResults = phase == "results" and status ~= "lobby"

	results.Visible = showResults
	if showResults then
		renderResults(now)
	end
	panel.Visible = status == "lobby"
	if status == "lobby" then
		renderLobby(phase, now)
	elseif shopOpen then
		setShop(false) -- the shop is only for the lobby
	end
end

-- ---------------------------------------------------------------- build
function Lobby.init()
	panel = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, 0), Size = UDim2.fromOffset(400, 500),
		BackgroundColor3 = Colors.bg, BackgroundTransparency = 0.08, Visible = false, Parent = gui,
	}, { UIKit.corner(16), UIKit.stroke(Colors.accent, 3) })
	UIKit.label({
		Text = Text.Title, TextSize = 36, Font = Enum.Font.GothamBlack, TextColor3 = Colors.accent,
		Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -40, 0, 42), Parent = panel,
	})
	UIKit.label({
		Text = Text.Subtitle, TextSize = 15, TextColor3 = Colors.dim,
		Position = UDim2.fromOffset(20, 54), Size = UDim2.new(1, -40, 0, 20), Parent = panel,
	})
	roomLabel = UIKit.label({ Text = "", TextSize = 18, Position = UDim2.fromOffset(20, 86), Size = UDim2.new(1, -40, 0, 24), Parent = panel })
	playersLabel = UIKit.label({
		Text = "", TextSize = 16, TextColor3 = Colors.accent,
		Position = UDim2.fromOffset(20, 120), Size = UDim2.new(1, -40, 0, 22), Parent = panel,
	})
	playerList = UIKit.new("Frame", {
		Position = UDim2.fromOffset(20, 146), Size = UDim2.new(1, -40, 0, 110), BackgroundTransparency = 1, Parent = panel,
	}, { UIKit.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }) })
	statsLabel = UIKit.label({
		Text = "", TextSize = 16, TextColor3 = Colors.accent,
		Position = UDim2.fromOffset(20, 264), Size = UDim2.new(1, -40, 0, 22), Parent = panel,
	})
	statusLabel = UIKit.label({
		Text = "", TextSize = 15, TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(20, 296), Size = UDim2.new(1, -40, 0, 62), Parent = panel,
	})
	readyButton = UIKit.button(Text.BtnReady, Colors.green, function()
		Remotes.Ready:FireServer(not attr(player, "Ready", false))
	end, { Position = UDim2.fromOffset(20, 368), Size = UDim2.new(1, -40, 0, 54), TextSize = 22, Parent = panel })
	UIKit.button(Text.BtnShop, Colors.blue, function()
		setShop(not shopOpen)
	end, { Position = UDim2.fromOffset(20, 432), Size = UDim2.new(1, -40, 0, 48), TextSize = 19, Parent = panel })

	-- results
	results = UIKit.new("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 8, 16), BackgroundTransparency = 0.25,
		Visible = false, ZIndex = 30, Parent = gui,
	})
	resultTitle = UIKit.label({
		Text = "", TextSize = 84, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.16),
		Size = UDim2.fromOffset(1000, 96), ZIndex = 31, Parent = results,
	})
	resultSub = UIKit.label({
		Text = "", TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.16, 104), Size = UDim2.fromOffset(1000, 32),
		ZIndex = 31, Parent = results,
	})
	resultList = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.16, 160), Size = UDim2.fromOffset(800, 150),
		BackgroundTransparency = 1, ZIndex = 31, Parent = results,
	}, { UIKit.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
	resultFooter = UIKit.label({
		Text = "", TextSize = 18, TextColor3 = Colors.dim, TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40), Size = UDim2.fromOffset(800, 26),
		ZIndex = 31, Parent = results,
	})

	-- shop window
	shop = UIKit.window(gui, Text.ShopTitle, 0, function()
		setShop(false)
	end)
	for _, name in { "Stars", "Skin", "Skins", "Upgrades" } do
		player:GetAttributeChangedSignal(name):Connect(renderShop)
	end

	task.spawn(function()
		while true do
			render()
			task.wait(0.2)
		end
	end)
end

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">ParentVisual</string>
          <string name="Source"><![CDATA[--[[
	ParentVisual — draws «Родитель» on the client.

	The server only moves an invisible root part (Workspace.NPC.ParentRoot) and sets its
	attributes State / Emote / VisionRange. Here we build the visible blocky body, follow the
	root smoothly every frame, swing the legs, show the «!» / «?» / «Zzz» bubble and aim the
	flashlight (a SpotLight with the same angle and range as his server-side vision cone).
	Also plays the cat that dashes through the corridor.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local ROBE = Color3.fromRGB(86, 104, 150)
local SKIN = Color3.fromRGB(240, 200, 170)
local DARK = Color3.fromRGB(40, 40, 50)

local ParentVisual = {}

local model: Model
local root: Part
local leftHip: Motor6D, rightHip: Motor6D, leftShoulder: Motor6D, rightShoulder: Motor6D
local spot: SpotLight
local emoteLabel: TextLabel
local current: CFrame? = nil
local lastPosition = Vector3.zero
local walkPhase = 0
local speedSmooth = 0

local function newPart(name: string, size: Vector3, color: Color3, cframe: CFrame, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CFrame = cframe
	part.Parent = model
	return part
end

local function weldTo(base: BasePart, part: BasePart)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
end

local function joint(name: string, part: BasePart, c0: CFrame, c1: CFrame): Motor6D
	local motor = Instance.new("Motor6D")
	motor.Name = name
	motor.Part0 = root
	motor.Part1 = part
	motor.C0 = c0
	motor.C1 = c1
	motor.Parent = root
	return motor
end

-- The root's centre is 3 studs above the floor (same as the server part).
local function build()
	model = Instance.new("Model")
	model.Name = "ParentVisual"

	root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 6, 2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new(0, -50, 0)
	root.Parent = model
	local origin = root.CFrame

	-- body: bathrobe, head, hair, face (he looks along -Z)
	weldTo(root, newPart("Robe", Vector3.new(2.6, 3, 1.4), ROBE, origin * CFrame.new(0, 1.5, 0), Enum.Material.Fabric))
	weldTo(root, newPart("Belt", Vector3.new(2.7, 0.3, 1.5), DARK, origin * CFrame.new(0, 0.9, 0), Enum.Material.Fabric))
	local head = newPart("Head", Vector3.new(1.6, 1.6, 1.6), SKIN, origin * CFrame.new(0, 3.8, 0))
	weldTo(root, head)
	weldTo(root, newPart("Hair", Vector3.new(1.7, 0.5, 1.7), Color3.fromRGB(90, 64, 44), origin * CFrame.new(0, 4.75, 0.05)))
	for _, side in { -1, 1 } do
		weldTo(root, newPart("Eye", Vector3.new(0.25, 0.25, 0.1), DARK, origin * CFrame.new(side * 0.35, 3.95, -0.82)))
	end
	weldTo(root, newPart("Mouth", Vector3.new(0.6, 0.12, 0.1), DARK, origin * CFrame.new(0, 3.45, -0.82)))

	-- limbs on joints so they can be animated
	local function limb(name: string, size: Vector3, color: Color3): Part
		return newPart(name, size, color, origin)
	end
	leftHip = joint("LeftHip", limb("LeftLeg", Vector3.new(1, 3, 1), Color3.fromRGB(70, 80, 110)), CFrame.new(-0.65, 0, 0), CFrame.new(0, 1.5, 0))
	rightHip = joint("RightHip", limb("RightLeg", Vector3.new(1, 3, 1), Color3.fromRGB(70, 80, 110)), CFrame.new(0.65, 0, 0), CFrame.new(0, 1.5, 0))
	leftShoulder = joint("LeftShoulder", limb("LeftArm", Vector3.new(0.8, 2.6, 0.8), ROBE), CFrame.new(-1.75, 2.8, 0), CFrame.new(0, 1.2, 0))
	rightShoulder = joint("RightShoulder", limb("RightArm", Vector3.new(0.8, 2.6, 0.8), ROBE), CFrame.new(1.75, 2.8, 0), CFrame.new(0, 1.2, 0))

	-- flashlight: welded to the root so the beam always matches the server-side cone
	local torch = newPart("Flashlight", Vector3.new(0.5, 0.5, 1.4), DARK, origin * CFrame.new(1.75, 2.1, -2.3), Enum.Material.Metal)
	weldTo(root, torch)
	local lens = newPart("Lens", Vector3.new(0.4, 0.4, 0.1), Color3.fromRGB(255, 244, 200), origin * CFrame.new(1.75, 2.1, -3.02), Enum.Material.Neon)
	weldTo(root, lens)
	spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Angle = Config.Parent.VisionAngle
	spot.Range = Config.Parent.VisionRange
	spot.Brightness = 4
	spot.Color = Color3.fromRGB(255, 240, 200)
	spot.Shadows = true
	spot.Parent = torch

	-- emote bubble and name
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 90)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.AlwaysOnTop = true
	gui.Adornee = head
	emoteLabel = Instance.new("TextLabel")
	emoteLabel.Size = UDim2.new(1, 0, 0.65, 0)
	emoteLabel.BackgroundTransparency = 1
	emoteLabel.Font = Enum.Font.GothamBlack
	emoteLabel.TextScaled = true
	emoteLabel.TextStrokeTransparency = 0
	emoteLabel.Text = ""
	emoteLabel.Parent = gui
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0.3, 0)
	nameLabel.Position = UDim2.fromScale(0, 0.7)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 16
	nameLabel.TextColor3 = Color3.fromRGB(255, 220, 200)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = Config.Text.ParentName
	nameLabel.Parent = gui
	gui.Parent = head

	model.Parent = workspace
end

local function update(dt: number)
	local folder = workspace:FindFirstChild("NPC")
	local serverRoot = folder and folder:FindFirstChild("ParentRoot")
	if not serverRoot or not serverRoot:IsA("BasePart") then
		return
	end
	local target = serverRoot.CFrame
	-- smooth out the network updates; snap when he is repositioned between rounds
	if not current or (current.Position - target.Position).Magnitude > 14 then
		current = target
	else
		current = current:Lerp(target, 1 - math.exp(-14 * dt))
	end
	local shown = current :: CFrame
	local state = serverRoot:GetAttribute("State") or "idle"

	local moved = (shown.Position - lastPosition).Magnitude
	lastPosition = shown.Position
	local speed = dt > 0 and moved / dt or 0
	speedSmooth += (speed - speedSmooth) * math.min(1, dt * 8)
	walkPhase += moved * 0.75
	local swing = math.sin(walkPhase) * 0.7 * math.clamp(speedSmooth / 4, 0, 1)

	if state == "sleep" or state == "idle" then
		-- sitting on the sofa behind him
		root.CFrame = shown * CFrame.new(0, -0.4, 3.6) * CFrame.Angles(0.2, 0, 0)
		leftHip.C0 = CFrame.new(-0.65, 0, 0) * CFrame.Angles(1.4, 0, 0)
		rightHip.C0 = CFrame.new(0.65, 0, 0) * CFrame.Angles(1.4, 0, 0)
	else
		root.CFrame = shown
		leftHip.C0 = CFrame.new(-0.65, 0, 0) * CFrame.Angles(swing, 0, 0)
		rightHip.C0 = CFrame.new(0.65, 0, 0) * CFrame.Angles(-swing, 0, 0)
	end

	local carrying = state == "grab" or state == "carry"
	local leftAngle = carrying and 1.5 or (state == "alert" and 2.6 or -swing * 0.8)
	leftShoulder.C0 = CFrame.new(-1.75, 2.8, 0) * CFrame.Angles(leftAngle, 0, 0)
	rightShoulder.C0 = CFrame.new(1.75, 2.8, 0) * CFrame.Angles(carrying and 1.5 or 1.25, 0, 0)

	local range = serverRoot:GetAttribute("VisionRange") or 0
	spot.Enabled = range > 0
	spot.Range = math.clamp(range, 0, 60)

	local emote = serverRoot:GetAttribute("Emote") or ""
	if emoteLabel.Text ~= emote then
		emoteLabel.Text = emote
		emoteLabel.TextColor3 = emote == Config.Text.EmoteSearch and Color3.fromRGB(255, 220, 90)
			or (emote == Config.Text.EmoteSleep and Color3.fromRGB(170, 200, 255) or Color3.fromRGB(255, 80, 70))
	end
end

-- «Кот пробежал!»: a small cat runs from one end of the corridor to the other.
local function runCat(from: Vector3, to: Vector3)
	local cat = Instance.new("Model")
	cat.Name = "Cat"
	local body = Instance.new("Part")
	body.Size = Vector3.new(1.2, 1.1, 2.6)
	body.Color = Color3.fromRGB(240, 150, 60)
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.Parent = cat
	local function add(size: Vector3, offset: CFrame, color: Color3)
		local part = Instance.new("Part")
		part.Size = size
		part.Color = color
		part.Material = Enum.Material.SmoothPlastic
		part.CanCollide = false
		part.Massless = true
		part.CFrame = body.CFrame * offset
		part.Parent = cat
		weldTo(body, part)
	end
	add(Vector3.new(1.1, 1, 1), CFrame.new(0, 0.6, -1.6), Color3.fromRGB(240, 150, 60))
	add(Vector3.new(0.3, 0.5, 0.2), CFrame.new(-0.35, 1.3, -1.6), Color3.fromRGB(200, 110, 40))
	add(Vector3.new(0.3, 0.5, 0.2), CFrame.new(0.35, 1.3, -1.6), Color3.fromRGB(200, 110, 40))
	add(Vector3.new(0.3, 0.3, 1.6), CFrame.new(0, 0.7, 1.9) * CFrame.Angles(0.7, 0, 0), Color3.fromRGB(200, 110, 40))
	cat.Parent = workspace
	Sounds.playAt("cat", (from + to) / 2)

	local duration = 2.4
	local elapsed = 0
	while elapsed < duration do
		elapsed += RunService.RenderStepped:Wait()
		local alpha = math.clamp(elapsed / duration, 0, 1)
		local position = from:Lerp(to, alpha) + Vector3.new(0, 0.9 + math.abs(math.sin(elapsed * 14)) * 0.5, 0)
		body.CFrame = CFrame.lookAt(position, position + (to - from))
	end
	cat:Destroy()
end

function ParentVisual.init()
	build()
	RunService.RenderStepped:Connect(update)
	Remotes:WaitForChild("Effect").OnClientEvent:Connect(function(kind, a, b)
		if kind == "cat" and typeof(a) == "Vector3" and typeof(b) == "Vector3" then
			task.spawn(runCat, a, b)
		end
	end)
end

return ParentVisual
]]></string>
        </Properties>
